# AIs@home gateway image. The binary is built outside the image, so building needs no
# compiler and no emulation for another architecture:
#
#   CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -o aisathome-gateway ./cmd/aisathome-gateway
#   podman build -f packaging/container/Containerfile.gateway -t aisathome-gateway .
#
# Runtime: config at /etc/aisathome/gateway.json (mount the directory, not the file, so
# edits are visible to SIGHUP reloads); usage log under /data.
#
# SPDX-License-Identifier: Apache-2.0
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY aisathome-gateway /usr/local/bin/aisathome-gateway
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/aisathome-gateway"]
CMD ["-addr", ":8080", "-config", "/etc/aisathome/gateway.json"]
