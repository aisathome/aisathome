---
// Starlight's hero, except on the home page, which renders its own (src/components/Home.astro),
// and on its dev-only design previews (src/pages/preview/).
import Default from '@astrojs/starlight/components/Hero.astro';
const custom = Astro.url.pathname === '/' || Astro.url.pathname.startsWith('/preview/home-');
---
{!custom && <Default />}
