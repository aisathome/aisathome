---
// The chart of the model's proofs prove2me accepted, counted up over time (src/data/prove2me-chart.ts), with its legend, a text
// alternative (the SVG's aria-label) and its numbers in a table. On the home page, /science/prove2me/ and the proved
// theorems page. The build
// draws it at a default width; the page's script mounts it (mountAcceptedChart), which draws it again at its real width
// and with the gateway's newer records. With nothing to draw (no proof accepted yet) the figure is there but hidden, so
// the live records can fill it; a live read with nothing accepted hides it again. Extra attributes go on the figure
// (the home page keeps data-home-p2m-chart). A reuse is never in the series (prove2me-chart.ts acceptedSeries).
import { acceptedChartSVG, acceptedRowsHTML, type AcceptedSeries } from '../data/prove2me-chart';

interface Props {
	series: AcceptedSeries | null;
	[attr: string]: unknown;
}
const { series, class: cls, ...attrs } = Astro.props;
---

<figure class:list={['p2m-chart not-content', cls as string | undefined]} data-p2m-chart data-source="build" hidden={!series} {...attrs}>
	<figcaption>Proofs by the model accepted by prove2me, counted up</figcaption>
	<ul class="legend" aria-hidden="true">
		<li><span class="swatch dot"></span>Proof</li>
		<li><span class="swatch dash"></span>A trial starts (its number above)</li>
	</ul>
	<div class="p2m-svg" data-p2m-chart-svg set:html={series ? acceptedChartSVG(series) : ''} />
	<details class="p2m-chart-table">
		<summary>The numbers</summary>
		<div class="p2m-chart-wrap" tabindex="0" role="region" aria-label="Proofs by the model accepted by prove2me, newest first">
			<table>
				<thead>
					<tr>
						<th scope="col">Accepted (UTC)</th>
						<th scope="col" class="num">Trial</th>
						<th scope="col">Lemma</th>
						<th scope="col" class="num">Total</th>
					</tr>
				</thead>
				<tbody data-p2m-chart-rows set:html={series ? acceptedRowsHTML(series) : ''} />
			</table>
		</div>
	</details>
	<script is:inline type="application/json" data-p2m-chart-series set:html={JSON.stringify(series).replace(/</g, '\\u003c')} />
</figure>

<style>
	/* In the network page's chart style; --chart-bg is what the chart sits on (the points' outline). */
	.p2m-chart {
		--c-line: #199e70;
		--chart-bg: var(--sl-color-bg);
		margin: 0;
		min-width: 0;
	}
	.p2m-chart[hidden] { display: none !important; }
	:global(:root[data-theme='light']) .p2m-chart { --c-line: #1baf7a; }
	figcaption { margin-bottom: 0.4rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--sl-color-gray-3); }
	.legend { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin: 0 0 0.5rem; padding: 0; list-style: none; font-size: 0.85rem; color: var(--sl-color-gray-2); }
	.legend li { display: flex; align-items: center; gap: 0.4rem; margin: 0; }
	.swatch.dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--c-line); }
	.swatch.dash { width: 0; height: 0.9rem; border-left: 1px dashed var(--sl-color-gray-3); }
	.p2m-svg { width: 100%; }
	.p2m-svg :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }
	.p2m-svg :global(.grid) { stroke: var(--sl-color-gray-5); stroke-width: 1; }
	.p2m-svg :global(.base) { stroke: var(--sl-color-gray-4); stroke-width: 1; }
	.p2m-svg :global(.tick) { fill: var(--sl-color-gray-3); font-size: 11px; font-variant-numeric: tabular-nums; }
	.p2m-svg :global(.end-n) { fill: var(--sl-color-white); font-weight: 700; font-size: 13px; }
	.p2m-svg :global(.trial) { stroke: var(--sl-color-gray-4); stroke-width: 1; stroke-dasharray: 3 3; }
	.p2m-svg :global(.step) { fill: none; stroke: var(--c-line); stroke-width: 2.5; stroke-linejoin: round; }
	.p2m-svg :global(.pt) { fill: var(--c-line); stroke: var(--chart-bg); stroke-width: 1.5; }
	.p2m-chart-table { margin-top: 0.5rem; }
	.p2m-chart-table summary { cursor: pointer; font-size: 0.9rem; color: var(--sl-color-gray-2); }
	.p2m-chart-wrap { max-height: 18rem; overflow: auto; }
	.p2m-chart-table table { width: 100%; margin-top: 0.5rem; border-collapse: collapse; font-size: 0.85rem; }
	.p2m-chart-table :global(:is(th, td)) { padding: 0.3rem 0.6rem 0.3rem 0; border-bottom: 1px solid var(--sl-color-gray-5); text-align: left; vertical-align: top; }
	.p2m-chart-table thead th { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--sl-color-gray-3); white-space: nowrap; }
	.p2m-chart-table :global(.num) { text-align: right; font-variant-numeric: tabular-nums; }
	.p2m-chart-table :global(td:first-child) { white-space: nowrap; }
	.p2m-chart-table :global(.lemma a) { color: var(--sl-color-accent-high); }
</style>
