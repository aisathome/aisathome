---
// Starlight's header, plus a menu button for phones on pages without a sidebar (the home page):
// Starlight's own button opens the sidebar, so those pages had no navigation at all below 50rem
// (owner, 2026-11-13). It opens a pane like Starlight's mobile menu: the main navigation, then the
// source code link and the theme control. A <details>, so it works without a script.
import { Icon } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/Header.astro';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import MainNav from './MainNav.astro';
const { hasSidebar } = Astro.locals.starlightRoute;
---
<Default />
{
	!hasSidebar && (
		<details class="phone-menu print:hidden" data-nav-menu>
			<summary>
				<Icon name="bars" class="open" />
				<Icon name="close" class="close" />
				<span class="sr-only">Menu</span>
			</summary>
			<div class="phone-menu-pane">
				<MainNav class="phone-menu-links" />
				<MobileMenuFooter />
			</div>
		</details>
	)
}
<script>
	// Close an open menu (this one or the header's Menu) on Escape or a click outside it.
	const menus = () => document.querySelectorAll<HTMLDetailsElement>('details[data-nav-menu][open]');
	document.addEventListener('click', (e) => menus().forEach((d) => !d.contains(e.target as Node) && (d.open = false)));
	document.addEventListener('keydown', (e) => e.key === 'Escape' && menus().forEach((d) => ((d.open = false), d.querySelector('summary')?.focus())));
</script>

<style is:global>
	.phone-menu { display: none; }
	@media (max-width: 49.99rem) {
		.phone-menu { display: block; }
		/* Room for the button, as Starlight leaves for its own on pages with a sidebar. */
		:root:not([data-has-sidebar]) header.header {
			padding-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
		}
		body:has(.phone-menu[open]) { overflow: hidden; }
	}
	.phone-menu > summary {
		position: fixed; top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2); inset-inline-end: var(--sl-nav-pad-x);
		z-index: var(--sl-z-index-navbar); display: flex; align-items: center; justify-content: center;
		width: var(--sl-menu-button-size); height: var(--sl-menu-button-size); padding: 0.5rem; border-radius: 50%;
		background: var(--sl-color-white); color: var(--sl-color-black); box-shadow: var(--sl-shadow-md); cursor: pointer; list-style: none;
	}
	.phone-menu > summary::-webkit-details-marker { display: none; }
	.phone-menu > summary svg { width: 1rem; height: 1rem; flex: none; }
	.phone-menu[open] > summary { background: var(--sl-color-gray-2); box-shadow: none; }
	.phone-menu .close, .phone-menu[open] .open { display: none; }
	.phone-menu[open] .close { display: block; }
	.phone-menu-pane {
		position: fixed; inset: var(--sl-nav-height) 0 0; z-index: var(--sl-z-index-menu); overflow-y: auto;
		padding: 1rem var(--sl-nav-pad-x); background: var(--sl-color-black);
	}
	.phone-menu-links { display: flex; flex-direction: column; gap: 0.125rem; padding-bottom: 0.5rem; }
	.phone-menu-links a { padding: 0.3em 0.5rem; border-radius: 0.25rem; color: var(--sl-color-white); font-size: var(--sl-text-lg); font-weight: 600; text-decoration: none; }
	.phone-menu-links a:hover { color: var(--sl-color-accent-high); }
	.phone-menu-links a[aria-current='page'] { background: var(--sl-color-text-accent); color: var(--sl-color-black); }
</style>
