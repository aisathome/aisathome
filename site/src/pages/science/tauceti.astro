---
// Science: the model's pull requests to Tau Ceti (taucetiproject.org), with every attempt
// counted. The build renders src/data/science/tauceti.json (the page works without JavaScript);
// the browser then loads the gateway's daily data (GET /v1/projects/tauceti/science, rebuilt by
// the runner from its records and Tau Ceti's public reviews) and renders it with the same code
// (src/data/science-render.ts) in its place, adding "Working on now". Styles are global
// (prefixed .sci-) because the rendered HTML is not part of this template.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { science as s } from '../../data/science';
import { renderScience } from '../../data/science-render';

const html = renderScience(s, s.generatedAt ?? new Date());
---

<StarlightPage
	frontmatter={{
		title: 'Science: Tau Ceti',
		description: `Pull requests that ${s.model}, an open model on the AIs@home network, opened on Tau Ceti, a library of formal mathematics written by AIs. Every attempt counts.`,
	}}
	headings={[
		{ depth: 2, slug: 'every-pr', text: 'Every pull request' },
		{ depth: 2, slug: 'how-to-read-this', text: 'How to read this' },
	]}
>
	<p>
		<a href={s.projectURL}>Tau Ceti</a> is an open library of formal mathematics in Lean, written by AI
		contributors and checked by Tau Ceti’s own review before anything is merged. {s.model}, an
		open-weight model running on the AIs@home network, contributes to it: small refactors, clean-ups and
		new lemmas, each sent as a pull request like anyone else’s.
	</p>
	<div data-science-root data-source="build" data-generated={s.generatedAt?.toISOString() ?? ''} set:html={html} />
</StarlightPage>

<script>
	// The gateway's data (the runner rebuilds it daily), rendered like the build's: it replaces
	// what is shown only when it is newer (the build's data may be newer when the runner has
	// stopped posting). "Working on now" (with the queue) and the "N h ago" times refresh every
	// minute while the page is visible, also over the build's data. Any failure keeps what is
	// shown (the build's page without it).
	import { ago, normalize } from '../../data/science-model';
	import { nowSection, renderScience } from '../../data/science-render';

	const root = document.querySelector<HTMLElement>('[data-science-root]');
	const tick = () =>
		root?.querySelectorAll<HTMLElement>('[data-ago]').forEach((el) => {
			const d = new Date(el.dataset.ago ?? '');
			if (!Number.isNaN(d.getTime())) el.textContent = ago(d, new Date());
		});
	// When the data shown was generated: the build's at first, then the newest the gateway gave.
	const shownAt = () => Date.parse(root?.dataset.generated ?? '') || 0;
	const showNow = (html: string) => {
		if (!root) return;
		const fresh = document.createRange().createContextualFragment(html);
		const old = root.querySelector('[data-science-now]');
		if (old) old.replaceWith(fresh);
		else root.insertBefore(fresh, root.querySelector('#every-pr')); // where renderScience puts it; null appends
		root.dataset.now = 'live';
	};
	const load = async () => {
		if (!root || !window.fetch) return;
		try {
			const ctl = new AbortController();
			const timer = setTimeout(() => ctl.abort(), 8000);
			const res = await fetch('/v1/projects/tauceti/science', { signal: ctl.signal, headers: { accept: 'application/json' } });
			clearTimeout(timer);
			if (!res.ok) return;
			const s = normalize(await res.json());
			if (!s.generatedAt || (!s.prs.length && !s.tasks.length)) return;
			const at = new Date();
			if (+s.generatedAt > shownAt()) {
				// newer daily data (or the first load of data newer than the build's): render it
				// all; the open review rounds close
				root.innerHTML = renderScience(s, at);
				root.dataset.source = 'live';
				root.dataset.generated = s.generatedAt.toISOString();
				root.dataset.now = 'live';
			} else {
				// the same or older data: refresh only "Working on now", so what is shown (and its
				// open review rounds) stays
				showNow(nowSection(s.now, at));
			}
		} catch {
			// keep what is shown
		} finally {
			tick();
		}
	};
	tick();
	load();
	setInterval(() => document.visibilityState === 'visible' && load(), 60000);
</script>

<style is:global>
	.sci-tiles {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
		gap: 1rem;
		margin: 2rem 0;
	}
	.sci-tiles div {
		display: flex;
		flex-direction: column-reverse;
		padding: 1rem 1.25rem;
		border-top: 4px solid var(--sl-color-accent);
		border-radius: 0.4rem;
		background: var(--b-surface);
	}
	.sci-tiles dd { margin: 0; font: 900 clamp(1.8rem, 4vw, 2.6rem)/1 var(--font-display); color: var(--sl-color-white); }
	.sci-tiles dt { margin-top: 0.35rem; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sl-color-gray-3); }

	.sci-chart { margin: 2rem 0; padding: 1rem 1.25rem 0.5rem; border-radius: 0.5rem; background: var(--b-band); }
	.sci-chart figcaption { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sl-color-gray-3); }
	.sci-chart svg { display: block; width: 100%; height: auto; margin-top: 0.5rem; overflow: visible; }
	.sci-chart .grid line { stroke: var(--sl-color-gray-5); stroke-width: 1; }
	.sci-chart .grid text { font: 12px var(--font-mono, monospace); fill: var(--sl-color-gray-3); }
	.sci-chart .line { fill: none; stroke: var(--sl-color-accent); stroke-width: 2; stroke-linejoin: round; }
	.sci-chart .dot { fill: var(--sl-color-accent); stroke: var(--b-band); stroke-width: 2; }
	.sci-chart .hit { fill: transparent; }
	.sci-chart .pt { cursor: default; outline: none; }
	.sci-chart .pt:is(:hover, :focus-visible) .dot { r: 7; fill: var(--sl-color-accent-high); }

	.sci-wrap { overflow-x: auto; margin-top: 1rem; }
	.sci-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
	.sci-table :is(th, td) { padding: 0.5rem 0.75rem 0.5rem 0; border-bottom: 1px solid var(--sl-color-gray-5); text-align: left; vertical-align: baseline; }
	.sci-table thead th { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--sl-color-gray-3); }
	.sci-table tbody th { white-space: nowrap; font-weight: 600; }
	.sci-table tbody th a { color: var(--sl-color-accent-high); }
	.sci-table .title { min-width: 13rem; color: var(--sl-color-white); white-space: normal; overflow-wrap: anywhere; }
	.sci-table .group-head :is(th, td) { padding-top: 1.25rem; font-weight: 700; color: var(--sl-color-white); border-bottom-color: var(--sl-color-gray-4); }
	.sci-table .group-head th { font-family: var(--font-display); font-size: 1.1rem; letter-spacing: 0.02em; text-transform: uppercase; }
	.sci-table .group-sub { margin-left: 0.6rem; font: 400 0.85rem var(--sl-font, inherit); text-transform: none; letter-spacing: 0; color: var(--sl-color-gray-3); }
	.sci-table [title] { cursor: help; }
	.sci-table [data-unknown] { color: var(--sl-color-gray-3); font-style: italic; }
	.sci-table .status .meta > span { display: block; }
	.sci-table td.num .meta { white-space: normal; }
	.sci-note { font-size: 0.85rem; color: var(--sl-color-gray-3); }
	.sci-table .meta { display: block; margin-top: 0.15rem; font-size: 0.8rem; font-weight: 400; color: var(--sl-color-gray-3); }
	.sci-table td:not(.title) { white-space: nowrap; }
	.sci-table .num { text-align: right; font-variant-numeric: tabular-nums; }
	.sci-table :is(th, td):last-child { padding-right: 0; }
	.sci-table .state { font-weight: 600; }
	/* Phones: each PR as a small card instead of a wide table. */
	@media (max-width: 40rem) {
		.sci-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
		.sci-table tr { display: grid; grid-template-columns: auto 1fr; gap: 0.25rem 0.75rem; padding: 0.75rem 0; border-bottom: 1px solid var(--sl-color-gray-5); }
		.sci-table :is(th, td) { padding: 0; border: 0; }
		.sci-table .title { grid-column: 2; grid-row: 1 / span 2; min-width: 0; }
		.sci-table td:not(.title) { grid-column: 2; white-space: normal; }
		.sci-table .num { text-align: left; }
		.sci-table :is(.tok, .min)::before { content: attr(data-label) ': '; color: var(--sl-color-gray-3); font-weight: 400; }
		.sci-table .group-head { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; padding-top: 1.5rem; }
		.sci-table .group-head th { flex-basis: 100%; }
		.sci-table .group-head :is(th, td) { padding: 0; }
		.sci-table .group-head td { font-size: 0.85rem; }
		.sci-table td.num .meta { display: inline; margin-left: 0.4rem; }
		.sci-table .status .meta > span { display: inline; }
		.sci-table .status .meta > span + span::before { content: ' · '; }
		.sci-chart .grid text { font-size: 22px; }
		.sci-chart .grid text.minor { display: none; }
	}
	.sci-table .state-merged { color: var(--sl-color-accent-high); }
	.sci-table :is(.state-closed, .state-failed, .state-checks-passed) { color: var(--sl-color-gray-3); }
	.sci-table .no-pr { font-weight: 400; font-style: italic; color: var(--sl-color-gray-3); }

	.sci-updated { margin-top: 0.5rem; font-size: 0.85rem; color: var(--sl-color-gray-3); }

	.sci-now { margin: 2rem 0; padding: 1rem 1.25rem; border-left: 4px solid var(--sl-color-accent); border-radius: 0.4rem; background: var(--b-surface); }
	.sci-now h2 { margin: 0 0 0.5rem; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sl-color-gray-3); }
	.sci-now ul { margin: 0; padding: 0; list-style: none; }
	.sci-now li + li { margin-top: 0.4rem; }
	.sci-now .target { display: block; font-weight: 600; color: var(--sl-color-white); }
	.sci-now .meta { display: block; margin: 0.15rem 0 0; font-size: 0.85rem; color: var(--sl-color-gray-3); }
	.sci-now p { margin: 0.5rem 0 0; }
	.sci-now a { color: var(--sl-color-accent-high); }
	.sci-now h3 { margin: 0.9rem 0 0.35rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sl-color-gray-3); }
	.sci-now ol.sci-queue { margin: 0; padding-left: 1.4rem; list-style: decimal; color: var(--sl-color-gray-3); }
	.sci-now .sci-queue li + li { margin-top: 0.25rem; }
	.sci-now .sci-queue .target { display: inline; font-weight: 400; color: var(--sl-color-gray-2); overflow-wrap: anywhere; }
	.sci-now .sci-queue .meta { display: inline; margin-left: 0.4rem; }
	.sci-now .target { overflow-wrap: anywhere; }

	.sci-rounds { margin-top: 0.35rem; font-size: 0.85rem; }
	.sci-rounds summary { cursor: pointer; color: var(--sl-color-accent-high); width: fit-content; }
	.sci-rounds ol { margin: 0.4rem 0 0; padding-left: 1.1rem; }
	.sci-rounds ol > li { margin-top: 0.4rem; }
	.sci-rounds .round-head { display: block; color: var(--sl-color-gray-2); }
	.sci-rounds ul { margin: 0.2rem 0 0; padding-left: 1rem; list-style: disc; }
	.sci-rounds ul li { margin-top: 0.2rem; color: var(--sl-color-gray-2); }
	.sci-rounds .rubric { font-weight: 600; color: var(--sl-color-white); }
	.sci-rounds q { quotes: '“' '”'; }
	.sci-rounds code { font-size: 0.8rem; overflow-wrap: anywhere; }
	.sci-rounds a { color: var(--sl-color-accent-high); }
	.sci-rounds .review-link { display: inline-block; margin-top: 0.4rem; }
</style>
