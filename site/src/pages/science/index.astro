---
// Science overview (/science/): one card per project, the active one first, each built the same way (2026-11-28: the
// prove2me card follows the Tau Ceti one): a status line, one line on the project, two numbers, and a footer with the
// date and the links. prove2me's status and numbers come live from the gateway's records in the browser, as on its own
// page (prove2me-records.ts); its card links the proved theorems too.
// SPDX-License-Identifier: Apache-2.0
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { p2m } from '../../data/prove2me';
import { historyOf, scienceView } from '../../data/prove2me-records';
import { buildRecords } from '../../data/prove2me-build';
import { cardNumbers, cardStatus } from '../../data/prove2me-view';
import { THEOREMS_PATH } from '../../data/prove2me-theorems';
import { science as tc } from '../../data/science';

const p2mHistory = historyOf(p2m);
const p2mView = scienceView(p2mHistory, (await buildRecords()).records); // the records as the build fetched them
const dayLabel = (iso: string) => {
	const d = new Date(iso);
	return `${d.getUTCDate()} ${['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'][d.getUTCMonth()]} ${d.getUTCFullYear()}`;
};
const cards = [
	{
		id: 'prove2me',
		name: 'prove2me',
		href: '/science/prove2me/',
		status: cardStatus(p2mView),
		state: 'active',
		about: 'Research theorems stated in Lean 4 and split into leaves. The Lean kernel checks every proof.',
		numbers: cardNumbers(p2mView),
		asOf: p2mView.updated,
		more: [{ href: THEOREMS_PATH, text: 'Proved theorems', key: 'theorems' }],
	},
	{
		id: 'tauceti',
		name: 'Tau Ceti',
		href: tc.pagePath,
		status: 'Finished: stopped at the maintainers’ request on 7 November 2026',
		state: 'finished',
		about: 'A library of formal mathematics; every change must pass the project’s own review.',
		numbers: [
			{ key: 'merged', value: `${tc.merged} of ${tc.prs.length}`, label: 'pull requests merged' },
			...(tc.firstReviewed ? [{ key: 'first-review', value: `${tc.firstReviewApproved} of ${tc.firstReviewed}`, label: 'approved at the first review' }] : []),
		],
		asOf: tc.generatedAt?.toISOString() ?? '',
		more: [] as { href: string; text: string; key: string }[],
	},
];
---

<StarlightPage
	frontmatter={{
		title: 'Science',
		description: `What ${p2m.model}, an open model on the AIs@home network, does for science: work a machine checks, with every result counted.`,
	}}
>
	<p>
		Science on AIs@home means an open model, {p2m.model}, running on the network’s GPUs and doing work that a machine checks: a proof that
		Lean accepts or rejects, a change that a project’s own review merges or not. Every attempt counts, the failures too. Today the network
		is mostly the maintainer’s own GPUs, some of them rented.
	</p>
	<ul class="sci-cards not-content" data-science-overview>
		{
			cards.map((c) => (
				<li class:list={['card', `card-${c.state}`]} data-project={c.id} data-status={c.state}>
					<h2>
						<a href={c.href} data-project-link>{c.name}</a>
					</h2>
					<p class="status" data-project-status>{c.status}</p>
					<p class="about">{c.about}</p>
					<dl data-card-numbers>
						{c.numbers.map((n) => (
							<div data-number={n.key}>
								<dt>{n.label}</dt>
								<dd>{n.value}</dd>
							</div>
						))}
					</dl>
					<p class="foot">
						{c.asOf && <span data-card-asof>As of {dayLabel(c.asOf)}. </span>}
						<a href={c.href}>See {c.name} <span aria-hidden="true">→</span></a>
						{c.more.map((m) => (
							<>
								<span class="sep" aria-hidden="true">·</span>
								<a href={m.href} data-card-link={m.key}>{m.text} <span aria-hidden="true">→</span></a>
							</>
						))}
					</p>
				</li>
			))
		}
	</ul>
	<script is:inline type="application/json" data-science-p2m-known set:html={JSON.stringify({ history: p2mHistory }).replace(/</g, '\\u003c')} />
</StarlightPage>

<script>
	// prove2me's card, live: the build's history with the gateway's records (prove2me-records.ts), on load and every
	// minute while the page is visible; without them the card keeps what it shows.
	import { liveSummary, type History } from '../../data/prove2me-records';
	import { cardNumbersHTML, cardStatus } from '../../data/prove2me-view';
	import { day, hhmm } from '../../data/prove2me-current';

	const card = document.querySelector<HTMLElement>('[data-project=prove2me]');
	const load = async () => {
		if (!card || !window.fetch) return;
		try {
			const known = JSON.parse(document.querySelector('[data-science-p2m-known]')?.textContent || 'null') as { history: History } | null;
			if (!known) return;
			const v = await liveSummary(known.history);
			if (!v) return;
			card.querySelector<HTMLElement>('[data-card-numbers]')!.innerHTML = cardNumbersHTML(v); // every value escaped
			card.querySelector<HTMLElement>('[data-project-status]')!.textContent = cardStatus(v);
			const asOf = card.querySelector<HTMLElement>('[data-card-asof]');
			if (asOf) asOf.textContent = `Live, updated ${day(v.updated)}, ${hhmm(v.updated)}. `;
			card.dataset.source = 'live';
		} catch {
			// keep what the card shows
		}
	};
	load();
	setInterval(() => document.visibilityState === 'visible' && load(), 60000);
</script>

<style>
	.sci-cards { display: grid; gap: 1rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
	.card { padding: 1rem 1.25rem; border-left: 4px solid var(--sl-color-gray-4); border-radius: 0.4rem; background: var(--b-surface); }
	.card-active { border-left-color: var(--sl-color-accent); }
	.card h2 { margin: 0; font-size: 1.4rem; }
	.card h2 a { color: var(--sl-color-white); text-decoration: none; }
	.card h2 a:hover { color: var(--sl-color-accent-high); }
	.status { margin: 0.25rem 0 0; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--sl-color-gray-3); }
	.card-active .status { color: var(--sl-color-accent-high); }
	.about { margin: 0.5rem 0 0; color: var(--sl-color-gray-2); }
	/* Global inside the card: the browser draws prove2me's numbers again as HTML (prove2me-view.ts cardNumbersHTML), which
	   scoped styles would miss, so both cards' numbers look the same live as at the build. */
	.card dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.5rem 1rem; margin: 0.75rem 0 0; }
	.card dl :global(div) { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
	.card dl :global(dd) { margin: 0; font: 900 1.5rem/1.1 var(--font-display); color: var(--sl-color-white); }
	.card dl :global(dt) { margin-top: 0.2rem; font-size: 0.78rem; line-height: 1.25; color: var(--sl-color-gray-2); }
	.foot { margin: 0.75rem 0 0; font-size: 0.85rem; color: var(--sl-color-gray-3); }
	.foot a { font-weight: 600; color: var(--sl-color-accent-high); }
	.foot .sep { margin: 0 0.4rem; }
	.foot a { white-space: nowrap; }
</style>
