---
// Science: prove2me (prove2.me), where Qwen3.8 27B on the AIs@home network tries leaves of research theorems in
// Lean 4. The build renders src/data/science/prove2me.json (our trials and submissions, exported from the trial
// records; the page works without JavaScript); the browser adds the network's share of the work from the gateway's
// public /v1/stats (project prove2me), which stays hidden until real numbers arrive.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { compact, counts, day, hhmm, leafOutcomeLabel, leafOutcomes, leafProgress, leafRoleLabel, shortSpan, outcomeLabel, p2m, plainTitle, qwenTokens, span, stateLabel, sumTokens, theoremURL, tokTitle } from '../../data/prove2me';
import { fromStatic, leafDetail, leafTokensText, taskTableHTML } from '../../data/prove2me-live';
import { leafPlan, leafPlanHTML } from '../../data/prove2me-outlines';
import { taskTableHTML as allTasksHTML } from '../../data/task-table';
import { mdLightHTML } from '../../data/prove2me-current';
import { p2mTaskOptions } from '../../data/prove2me-tasks';

const t = p2m.totals;
const cur = p2m.current;
const safe = (u: string) => (theoremURL.test(u) ? u : undefined);
const groupLabel = { calibration: 'Calibration', open: 'Open' } as Record<string, string>;
const earlierText = (e: number[]) => (e.length ? `tried before in trial${e.length > 1 ? 's' : ''} ${e.join(' and ')}` : '');
const pct = (x: number, n: number) => Math.round((100 * x) / n);
// For the live "Working on now": what the build knows of each theorem (its link and title) and of the running trial's leaves.
// Each leaf's tasks (every outline), with their tokens from the trial's records, for the build's list; the live view
// merges the same tasks into the queue's by id (the queue lacks the cache reads of tasks finished before 14 November).
const curTasks = cur?.tasks ?? [];
const details = Object.fromEntries((cur?.leaves ?? []).map((l) => [l.leaf, leafDetail(curTasks.filter((t) => t.leaf === l.leaf).map(fromStatic), l.outlines ?? [])]));
// A leaf closed by reuse: the proved theorem its one-line proof imports (the leaf's line says so).
const reuseOf: Record<string, string> = Object.fromEntries(p2m.submissions.filter((s) => s.kind === 'reuse' && s.reuses).map((s) => [s.theorem, s.reuses!.theorem]));
const known = {
	reuses: reuseOf,
	trial: cur && cur.state !== 'preparing' ? `t${cur.trial}` : '',
	order: cur?.leaves.map((l) => l.leaf) ?? [],
	tasks: curTasks,
	outlines: Object.fromEntries((cur?.leaves ?? []).map((l) => [l.leaf, l.outlines ?? []])),
	leaves: Object.fromEntries((cur?.leaves ?? []).map((l) => [l.leaf, { theorem: l.theorem, url: safe(l.url) ?? '', group: l.group, earlier: l.earlier }])),
	theorems: Object.fromEntries(
		[...p2m.trials.flatMap((tr) => tr.leaves), ...(cur?.leaves ?? [])].filter((r) => safe(r.url)).map((r) => [r.theorem, r.url]),
	),
};
const trials = p2m.trials.map((tr) => ({ ...tr, c: counts(tr.leaves), hours: tr.leaves.reduce((a, r) => a + r.model_minutes, 0) / 60, tok: sumTokens(tr.leaves), v5: tr.leaves.some((r) => r.tasks) }));
// A finished v5 trial keeps each leaf's tasks: the same table as "Working on now", collapsed.
type Run = (typeof p2m.trials)[number]['leaves'][number];
const trialDetail = (r: Run) => leafDetail((r.tasks ?? []).map(fromStatic), r.outlines ?? []);
const preparing = cur?.state === 'preparing';
// The texts below name F01's trial-5 run; its task count comes from the data.
const f01 = p2m.trials.flatMap((tr) => tr.leaves).find((r) => r.leaf === 'F01' && r.outcome === 'proved' && r.tasks);
// Leaves closed by reuse: the same statement as a theorem already proved on prove2me, or a part of one; the proof imports it.
const reuses = p2m.submissions.filter((s) => s.kind === 'reuse' && s.reuses);
// A leaf's id (p2m- and the start of prove2me's theorem id) leads everywhere; the trials' alias (O04, F01) is shown small.
const idOfTheorem = (theorem: string) => p2m.leaves.find((l) => l.theorem === theorem)?.id;
const idOfAlias = (alias: string) => p2m.leaves.find((l) => l.aliases.includes(alias))?.id ?? alias;
const named = (id: string | undefined, alias: string) => (id && id !== alias ? `${id} (${alias})` : alias);
// Every leaf ever tried: the scorecard by role and the list (the browser filters and sorts it; see the script).
const roles = p2m.by_role.filter((r) => r.leaves > 0);
const outcomesShown = leafOutcomes.filter((o) => p2m.leaves.some((l) => l.outcome === o));
const leafTok = (l: (typeof p2m.leaves)[number]) =>
	l.prompt_tokens === null ? null : { prompt_tokens: l.prompt_tokens, cached_tokens: l.cached_tokens ?? 0, output_tokens: l.output_tokens ?? 0 };
// Every task: the generic task table with prove2me's options; the browser adds the current trial's tasks from the gateway.
const curTrialNo = cur?.trial ?? null;
const tasksHTML = allTasksHTML(p2m.tasks, p2mTaskOptions(p2m.tasks, curTrialNo));
const leafIds: Record<string, string> = Object.fromEntries([
	...(cur?.leaves ?? []).filter((l) => safe(l.url)).map((l) => [l.theorem, `p2m-${l.url.slice(-36).replace(/-/g, '').slice(0, 6)}`]),
	...p2m.leaves.map((l) => [l.theorem, l.id]),
]);
const taskKnown = { rows: p2m.tasks, trial: curTrialNo, leafIds };
const leafCols = [
	{ key: 'leaf', label: 'Leaf' },
	{ key: 'theorem', label: 'Theorem' },
	{ key: '', label: 'Role' },
	{ key: '', label: 'Trials' },
	{ key: 'outcome', label: 'Outcome' },
	{ key: 'first', label: 'First tried' },
	{ key: 'minutes', label: 'Model min', num: true },
	{ key: 'tokens', label: 'Qwen tokens', num: true },
];
---

<StarlightPage
	frontmatter={{
		title: 'Science: prove2me',
		description: `Leaves of prove2me, research theorems stated in Lean 4, that ${p2m.model}, an open model on the AIs@home network, tried to prove, and the proofs we submitted. Every run counts.`,
	}}
	headings={[
		{ depth: 2, slug: 'results', text: 'Results so far' },
		{ depth: 2, slug: 'submissions', text: 'Submitted to prove2me' },
		{ depth: 2, slug: 'working-on-now', text: 'Working on now' },
		{ depth: 2, slug: 'leaves', text: 'Every leaf' },
		{ depth: 2, slug: 'tasks', text: 'Every task' },
		{ depth: 2, slug: 'trials', text: 'Trials' },
		{ depth: 2, slug: 'how-to-read-this', text: 'How to read this' },
		{ depth: 2, slug: 'next', text: 'What comes next' },
	]}
>
	<p>
		<a href={p2m.project_url} data-p2m-link="home">prove2me</a> collects theorems from mathematical research papers, stated in Lean 4
		and split into small pieces called leaves. Anyone, a person or an agent, may submit a proof of an open leaf, and prove2me’s own
		check decides: the Lean kernel and the axioms the proof uses.
	</p>
	<p>
		{p2m.model}, an open-weight model on the AIs@home network, works on leaves as an agent, with Lean and Mathlib at prove2me’s
		versions. Our own full check judges every attempt: the proof must build, state exactly the leaf’s theorem, and use no
		{' '}<code>sorry</code> and no axiom beyond Lean’s standard three. Only proofs that pass it are submitted, and since 12 November 2026
		every one of them that proves an open leaf is. AIs@home is not part of prove2me.
	</p>
	<p class="p2m-updated" data-p2m-updated>Updated on <time datetime={p2m.generated_at}>{day(p2m.generated_at)}</time></p>

	<h2 id="results">Results so far</h2>
	<dl class="p2m-kpis not-content" data-p2m-kpis style={`--kpis: ${t.reused ? 4 : 3}`}>
		<div data-kpi="accepted"><dt>{t.accepted === 1 ? 'proof' : 'proofs'} accepted by prove2me, of {t.submitted} submitted</dt><dd>{t.accepted}</dd></div>
		<div data-kpi="open"><dt>open leaves proved, of {t.open_leaves} tried</dt><dd>{t.open_leaves_proved}</dd></div>
		{t.reused > 0 && (
			<div data-kpi="reused"><dt>{t.reused === 1 ? 'open leaf' : 'open leaves'} closed by reuse of a proof already on prove2me</dt><dd>{t.reused}</dd></div>
		)}
		<div data-kpi="runs"><dt>runs proved, of {t.runs} in trials 1 to {trials.length}</dt><dd>{t.proved}</dd></div>
	</dl>
	<p data-p2m-small>
		Small numbers. The {t.open_leaves_proved} open leaves proved show that the model can do it, not how often: {named(idOfAlias('O04'), 'O04')} (trial 3) was a short
		proof of a leaf nobody had tried yet, and {named(idOfAlias('F01'), 'F01')} (trial 5) took a new scaffold, two outlines and {f01?.tasks?.length} tasks after
		trials 3 and 4 had failed on it.{reuses.length > 0 && ` ${reuses.map((s) => named(idOfTheorem(s.theorem), s.leaf)).join(' and ')}, closed by reuse, ${reuses.length === 1 ? 'is' : 'are'} not among them.`} On calibration leaves, which others had proved before, {t.calibration_proved} of
		{' '}{t.calibration_runs} runs succeeded. All runs together took {t.model_hours} hours of model time.
	</p>

	<section class="p2m-live not-content" data-p2m-live hidden aria-labelledby="p2m-live-head">
		<h3 id="p2m-live-head">prove2me on the network</h3>
		<dl class="p2m-live-list">
			<div><dt>requests today (UTC)</dt><dd data-live="today-requests"></dd></div>
			<div><dt>of all the network’s requests today</dt><dd data-live="today-share"></dd></div>
			<div><dt>requests since 11 November</dt><dd data-live="requests"></dd></div>
			<div><dt>tokens read and written since 11 November</dt><dd data-live="tokens"></dd></div>
			<div><dt>GPU hours since 11 November</dt><dd data-live="hours"></dd></div>
		</dl>
		<p class="p2m-note">
			Live from the gateway’s public statistics, updated <time data-live="updated"></time> UTC. The network counts prove2me on its own
			since 11 November 2026 (trial 4 on); the requests of trials 1 to 3 count under Tau Ceti’s project.
		</p>
	</section>

	<h2 id="submissions">Submitted to prove2me</h2>
	{
		p2m.submissions.length ? (
			<div class="p2m-wrap not-content">
				<table class="p2m-table" data-p2m-submissions>
					<thead>
						<tr><th scope="col">Leaf</th><th scope="col">Theorem</th><th scope="col">From</th><th scope="col">Submitted</th><th scope="col">prove2me’s verdict</th></tr>
					</thead>
					<tbody>
						{p2m.submissions.map((s) => (
							<tr data-submission={s.leaf} data-verdict={s.verdict} data-kind={s.kind}>
								<th scope="row">
									{idOfTheorem(s.theorem) ?? s.leaf}
									{idOfTheorem(s.theorem) && <span class="sub" data-alias title="The id the trials used">{s.leaf}</span>}
								</th>
								<td class="thm">
									<a href={safe(s.url)} data-theorem>{s.theorem}</a>
									{plainTitle(s.title) !== s.theorem && <span class="sub">{plainTitle(s.title)}</span>}
									{s.reuses && (
										<span class="sub" data-reuses>
											{s.reuses.relation === 'part' ? 'part of' : 'same statement as'} <a href={safe(s.reuses.url)}>{s.reuses.theorem}</a> by {s.reuses.author}
										</span>
									)}
								</td>
								{s.kind === 'reuse' ? (
									<td data-label="From">Closed by reuse<span class="sub">{s.found === 'trial' ? `found during trial ${s.trial}` : `found while preparing trial ${s.trial}`}</span></td>
								) : (
									<td data-label="From">Trial {s.trial}</td>
								)}
								<td data-label="Submitted"><time datetime={s.submitted_at}>{day(s.submitted_at)}, {hhmm(s.submitted_at)}</time></td>
								<td data-label="Verdict" class:list={['verdict', `verdict-${s.verdict}`]}>
									{s.verdict === 'accepted' ? 'Accepted' : s.verdict === 'pending' ? 'Pending' : 'Rejected'}
									{s.verdict_at && <span class="sub">{hhmm(s.verdict_at)}</span>}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		) : (
			<p>Nothing yet.</p>
		)
	}
	<p>
		{named(idOfAlias('O04'), 'O04')} had been open for 13 days with no submission from anyone. Its proof is short: the distribution has a density, so a single
		price carries no probability mass. {named(idOfAlias('F01'), 'F01')} was still open when we submitted it. Its proof follows the leaf’s own statement: the
		index is split into four fields, each of the outline’s six steps was proved by a task of its own, and the pieces were put
		together into one proof, which our full check and then prove2me accepted. prove2me’s theorem pages show both leaves as proved.
		Calibration leaves are never submitted: they were proved before.
	</p>
	{
		reuses.map((s) => (
			<p data-p2m-reuse-note={s.leaf}>
				{named(idOfTheorem(s.theorem), s.leaf)} was closed by reuse.{' '}
				{s.reuses!.relation === 'part'
					? `The leaf is one part of a theorem that ${s.reuses!.author} had already proved on prove2me: its conclusion contains the leaf’s statement. Our index of prove2me’s library offered that theorem as a similar statement during trial ${s.trial}, and the model’s proof is one line that uses it.`
					: `The leaf is the same statement as a theorem that ${s.reuses!.author} had already proved on prove2me under another name. Our index of prove2me’s library found the match while we prepared trial ${s.trial}, and the model’s proof is one line that imports that theorem.`}{' '}
				Our full check and then prove2me accepted it, but none of the mathematics is ours, so it is not counted among the open leaves
				proved.
			</p>
		))
	}

	<h2 id="working-on-now">Working on now</h2>
	<script is:inline type="application/json" data-p2m-known set:html={JSON.stringify(known).replace(/</g, '\\u003c')} />
	{/* The build's copy; the browser replaces it with the project's data document and the gateway's tasks (see the script). */}
	<section class="p2m-now not-content" data-p2m-now data-trial={cur && !preparing ? `t${cur.trial}` : ''} data-preparing={preparing ? `t${cur!.trial}` : undefined} data-source="build">
		<p class="head" data-now-head>
			{cur && preparing && <>Trial {cur.trial} is being prepared · scaffold {cur.scaffold}</>}
			{cur && !preparing && <>Trial {cur.trial}, since {day(cur.start ?? p2m.generated_at)} · scaffold {cur.scaffold}</>}
			{!cur && 'No trial is running.'}
		</p>
		<div class="about" data-now-about hidden={!cur?.summary} set:html={cur?.summary ? mdLightHTML(cur.summary) : ''} />
		<p class="caps" data-now-budget hidden={!cur?.caps}>{cur?.caps && `Budget: ${cur.caps}.`}</p>
		<ul data-now-leaves>
			{cur && !preparing && cur.leaves.map((l) => {
				const d = details[l.leaf];
				const plan = leafPlan(d, [], reuseOf[l.theorem]);
				const progress = d.rows.length ? plan.summary : leafProgress(l);
				const words = d.rows.length ? plan.summary : `${stateLabel[l.state] ?? l.state}${progress ? `: ${progress}` : ''}`;
				return (
					<li id={`leaf-${leafIds[l.theorem] ?? l.leaf}`} data-current-leaf={l.leaf} data-leaf-id={leafIds[l.theorem]} data-state={l.state}>
						<span class="leaf">{leafIds[l.theorem] ?? l.leaf}</span>
						{leafIds[l.theorem] && <span class="alias" id={`leaf-${l.leaf}`} title="The id the trials used" data-alias>{l.leaf}</span>}
						<a href={safe(l.url)} class="thm-name">{l.theorem}</a>
						<span class="meta">
							<span>{groupLabel[l.group] ?? l.group} leaf</span>
							{l.earlier.length > 0 && <span>{earlierText(l.earlier)}</span>}
							{d.rows.length > 0 && (
								<span data-tokens={d.total} data-computed={d.computed} data-exact={String(d.exact)}>
									{leafTokensText(d, l.state === 'running' || l.state === 'queued')}
								</span>
							)}
						</span>
						<span class:list={['state', `state-${l.state}`]} data-progress={progress} data-leaf-summary>{words}</span>
						<Fragment set:html={leafPlanHTML(l.leaf, plan)} />
						<Fragment set:html={taskTableHTML(l.leaf, d, 'Every task')} />
					</li>
				);
			})}
		</ul>
		<p class="meta" data-now-subs hidden></p>
		<p class="meta" data-now-asof>
			{cur && preparing && <>No task of trial {cur.trial} has started yet. Trial {trials.at(-1)?.trial} has ended: its results are under <a href={`#trial-${trials.at(-1)?.trial}`}>Trials</a>.</>}
			{cur && !preparing && <>As of {day(p2m.generated_at)}, {hhmm(p2m.generated_at)}. The page updates this list from the trial’s published data and the gateway’s task list every minute; without them it shows this copy from the site’s last build.</>}
		</p>
	</section>

	<h2 id="leaves">Every leaf</h2>
	<p>
		All {t.leaves} leaves tried so far, one row per leaf over every trial that ran it. A leaf’s id here is <code>p2m-</code> and the start
		of prove2me’s own id for the theorem; the id the trials used (C11, F01, …) is shown under it. Its outcome is the best of its runs:
		accepted by prove2me, closed by reuse, proved, not proved, stopped by us, or not scored.
	</p>
	<div class="p2m-wrap not-content">
		<table class="p2m-table p2m-score" data-p2m-scorecard>
			<thead>
				<tr>
					<th scope="col">Role</th><th scope="col" class="num">Leaves</th><th scope="col" class="num">Runs</th>
					<th scope="col" class="num">Runs proved</th><th scope="col" class="num">Proofs accepted</th>
					<th scope="col" class="num">Closed by reuse</th><th scope="col" class="num">Model hours</th><th scope="col" class="num">Qwen tokens</th>
				</tr>
			</thead>
			<tbody>
				{roles.map((r) => (
					<tr data-role={r.role}>
						<th scope="row">{leafRoleLabel[r.role]}</th>
						<td data-label="Leaves" class="num" data-cell="leaves">{r.leaves}</td>
						<td data-label="Runs" class="num" data-cell="runs">{r.runs}</td>
						<td data-label="Runs proved" class="num" data-cell="proved">{r.proved}</td>
						<td data-label="Proofs accepted" class="num" data-cell="accepted">{r.accepted}</td>
						<td data-label="Closed by reuse" class="num" data-cell="reused">{r.reused}</td>
						<td data-label="Model hours" class="num" data-cell="hours">{r.model_hours.toFixed(1)}</td>
						<td data-label="Qwen tokens" class="num tok" data-cell="tokens" data-tokens={qwenTokens(r)} title={tokTitle(r)}>{compact(qwenTokens(r))}</td>
					</tr>
				))}
			</tbody>
			<tfoot>
				<tr data-role="all">
					<th scope="row">All</th>
					<td data-label="Leaves" class="num" data-cell="leaves">{t.leaves}</td>
					<td data-label="Runs" class="num" data-cell="runs">{t.runs}</td>
					<td data-label="Runs proved" class="num" data-cell="proved">{t.proved}</td>
					<td data-label="Proofs accepted" class="num" data-cell="accepted">{t.accepted - t.reused}</td>
					<td data-label="Closed by reuse" class="num" data-cell="reused">{t.reused}</td>
					<td data-label="Model hours" class="num" data-cell="hours">{t.model_hours.toFixed(1)}</td>
					<td data-label="Qwen tokens" class="num tok" data-cell="tokens" data-tokens={qwenTokens(t)} title={tokTitle(t)}>{compact(qwenTokens(t))}</td>
				</tr>
			</tfoot>
		</table>
	</div>
	<p class="caps">
		A comparison leaf is an open leaf run again to compare a new scaffold with the trials before it. A leaf can have more than one role
		over its trials, so the leaves by role add up to more than {t.leaves}. A proof accepted counts under the role of the run that proved
		it; a leaf closed by reuse has no run.
	</p>
	<details class="p2m-list" data-p2m-list>
		<summary>All {t.leaves} leaves</summary>
		<div class="p2m-filters not-content" role="group" aria-label="Filter the leaves" data-p2m-filters>
			<button type="button" data-filter="role" data-value="" aria-pressed="true">All roles</button>
			{roles.map((r) => <button type="button" data-filter="role" data-value={r.role} aria-pressed="false">{leafRoleLabel[r.role]}</button>)}
			<span class="sep"></span>
			<button type="button" data-filter="outcome" data-value="" aria-pressed="true">Any outcome</button>
			{outcomesShown.map((o) => <button type="button" data-filter="outcome" data-value={o} aria-pressed="false">{leafOutcomeLabel[o]}</button>)}
		</div>
		<p class="caps" data-p2m-list-count>Showing {t.leaves} of {t.leaves}</p>
		<div class="p2m-wrap not-content">
			<table class="p2m-table p2m-lt" data-p2m-leaf-table>
				<thead>
					<tr>
						{leafCols.map((c) =>
							c.key ? (
								<th scope="col" class:list={[{ num: c.num }]} data-sort-col={c.key}>
									<button type="button" data-leaf-sort={c.key}>{c.label}<span class="sort-mark" aria-hidden="true"></span></button>
								</th>
							) : (
								<th scope="col" class="nosort">{c.label}</th>
							),
						)}
					</tr>
				</thead>
				<tbody>
					{p2m.leaves.map((l, i) => {
						const tok = leafTok(l);
						return (
							<tr data-leaf-id={l.id} data-roles={l.roles.join(' ')} data-outcome={l.outcome} data-order={i}
								data-sort-first={Date.parse(`${l.first_tried}T00:00:00Z`)} data-sort-outcome={leafOutcomes.indexOf(l.outcome)}
								data-sort-tokens={tok ? qwenTokens(tok) : undefined} data-sort-minutes={l.model_minutes ?? undefined}>
								<th scope="row">
									{l.id}
									<span class="sub" data-alias title="The id the trials used">{l.aliases.join(', ')}</span>
								</th>
								<td class="thm"><a href={safe(l.url)} title={plainTitle(l.title)} data-sort-theorem>{l.theorem}</a></td>
								<td data-label="Role">{l.roles.map((r) => leafRoleLabel[r]).join(', ')}</td>
								<td data-label="Trials" data-cell="trials">{l.trials.length ? l.trials.join(', ') : '–'}</td>
								<td data-label="Outcome" data-cell="outcome" class:list={['result', { proved: ['accepted', 'proved'].includes(l.outcome), unscored: ['not_scored', 'stopped'].includes(l.outcome) }]}>
									{leafOutcomeLabel[l.outcome]}
									{l.runs > 1 && <span class="sub">{l.proved_runs} of {l.runs} runs proved</span>}
								</td>
								<td data-label="First tried" class="nowrap"><time datetime={l.first_tried}>{day(l.first_tried)}</time></td>
								<td data-label="Model min" class="num" data-cell="minutes">{l.model_minutes === null ? '–' : l.model_minutes.toFixed(1)}</td>
								{tok ? (
									<td data-label="Qwen tokens" class="num tok" data-cell="tokens" data-tokens={qwenTokens(tok)} title={tokTitle(tok)}>{compact(qwenTokens(tok))}</td>
								) : (
									<td data-label="Qwen tokens" class="num" data-cell="tokens" title="No run: closed by reuse">–</td>
								)}
							</tr>
						);
					})}
				</tbody>
			</table>
		</div>
	</details>

	<h2 id="tasks">Every task</h2>
	<p>
		Every task of every trial: from trial 5 a leaf is many tasks (its outlines, one task per hole, the tries and the assembly), and a
		run of trials 1 to 4 counts as one task. A task’s links name the tasks it comes from: the outline a hole is from, the try a task
		retries, the outline it replaces, the holes an assembly needs. Queued and running tasks come live from the gateway’s queue.
	</p>
	<script is:inline type="application/json" data-p2m-tasks-known set:html={JSON.stringify(taskKnown).replace(/</g, '\\u003c')} />
	<details class="p2m-list p2m-alltasks not-content" data-p2m-alltasks>
		<summary>All tasks</summary>
		<Fragment set:html={tasksHTML} />
	</details>

	<h2 id="trials">Trials</h2>
	<p>
		Each trial changed the agent’s scaffold (its instructions, tools and rounds) from what the one before taught, so the trials are
		steps, not repeats. Tap a trial for every leaf it ran.
	</p>
	<div class="p2m-wrap not-content">
		<table class="p2m-table p2m-trials" data-p2m-trials>
			<thead>
				<tr>
					<th scope="col">Trial</th><th scope="col">Dates</th><th scope="col">Scaffold</th><th scope="col" class="num">Proved</th>
					<th scope="col" class="num">Calibration</th><th scope="col" class="num">Open</th><th scope="col" class="num">Model hours</th>
					<th scope="col" class="num">Qwen tokens</th>
				</tr>
			</thead>
			<tbody>
				{trials.map((tr) => (
					<tr data-trial={tr.trial}>
						<th scope="row"><a href={`#trial-${tr.trial}`}>Trial {tr.trial}</a></th>
						<td data-label="Dates" class="nowrap"><time datetime={tr.start}>{shortSpan(tr)}</time></td>
						<td data-label="Scaffold">{tr.scaffold}</td>
						<td data-label="Proved" class="num" data-cell="proved">{tr.c.all.proved} of {tr.c.all.runs}</td>
						<td data-label="Calibration" class="num" data-cell="calibration">{tr.c.calibration.runs ? `${tr.c.calibration.proved} of ${tr.c.calibration.runs}` : '–'}</td>
						<td data-label="Open" class="num" data-cell="open">{tr.c.open.proved} of {tr.c.open.runs}</td>
						<td data-label="Model hours" class="num">{tr.hours.toFixed(1)}</td>
						<td data-label="Qwen tokens" class="num tok" data-tokens={qwenTokens(tr.tok)} data-output={tr.tok.output_tokens} data-cached={tr.tok.cached_tokens} title={tokTitle(tr.tok)}>{compact(qwenTokens(tr.tok))}</td>
					</tr>
				))}
			</tbody>
			<tfoot>
				<tr data-trial="all">
					<th scope="row">All</th><td></td><td></td>
					<td data-label="Proved" class="num" data-cell="proved">{t.proved} of {t.runs}</td>
					<td data-label="Calibration" class="num" data-cell="calibration">{t.calibration_proved} of {t.calibration_runs}</td>
					<td data-label="Open" class="num" data-cell="open">{trials.reduce((a, tr) => a + tr.c.open.proved, 0)} of {t.open_runs}</td>
					<td data-label="Model hours" class="num">{t.model_hours.toFixed(1)}</td>
					<td data-label="Qwen tokens" class="num tok" data-tokens={qwenTokens(t)} data-output={t.output_tokens} data-cached={t.cached_tokens} title={tokTitle(t)}>{compact(qwenTokens(t))}</td>
				</tr>
			</tfoot>
		</table>
	</div>

	{
		trials.map((tr) => (
			<details class="p2m-trial" id={`trial-${tr.trial}`} data-p2m-trial={tr.trial}>
				<summary>
					Trial {tr.trial} · {span(tr)} · {tr.c.all.proved} of {tr.c.all.runs} proved
				</summary>
				<p>{tr.summary}</p>
				<p class="caps">Budget per leaf: {tr.caps}.</p>
				<div class="p2m-wrap not-content">
					<table class="p2m-table p2m-leaves">
						<thead>
							<tr><th scope="col">Leaf</th><th scope="col">Theorem</th><th scope="col">Kind</th><th scope="col">Result</th><th scope="col" class="num">{tr.v5 ? 'Tasks' : 'Rounds'}</th><th scope="col" class="num">Model min</th><th scope="col" class="num">Qwen tokens</th></tr>
						</thead>
						<tbody>
							{tr.leaves.map((r) => (
								<tr data-leaf={r.leaf} data-outcome={r.outcome} data-scored={String(r.scored)}>
									<th scope="row">
										{idOfTheorem(r.theorem) ?? r.leaf}
										{idOfTheorem(r.theorem) && <span class="sub" data-alias title="The id the trials used">{r.leaf}</span>}
									</th>
									<td class="thm">
										<a href={safe(r.url)}>{r.theorem}</a>
										<span class="sub">{plainTitle(r.title)}</span>
									</td>
									<td data-label="Kind">
										{groupLabel[r.group] ?? r.group}
										{r.earlier.length > 0 && <span class="sub">{earlierText(r.earlier)}</span>}
									</td>
									<td data-label="Result" class:list={['result', r.outcome === 'proved' ? 'proved' : r.scored ? 'failed' : 'unscored']}>
										{outcomeLabel(r)}
										{!r.scored && r.not_scored_why && <span class="sub">{r.not_scored_why}</span>}
									</td>
									{r.tasks ? (
										<td data-label="Tasks" class="num">
											{r.tasks.length}
											<span class="sub">{r.rounds === 1 ? '1 outline' : `${r.rounds} outlines`}</span>
										</td>
									) : (
										<td data-label="Rounds" class="num">{r.rounds}</td>
									)}
									<td data-label="Model min" class="num">{r.model_minutes.toFixed(1)}</td>
									<td data-label="Qwen tokens" class="num tok" data-tokens={qwenTokens(r)} data-output={r.output_tokens} data-cached={r.cached_tokens} title={tokTitle(r)}>{compact(qwenTokens(r))}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				{tr.v5 && (
					<div class="p2m-trial-tasks not-content" data-p2m-trial-tasks={tr.trial}>
						<p class="caps">Each leaf’s outlines, newest first, with what became of every hole; under each, every task (outline, hole, try and assembly) with its counts, as in “Working on now”.</p>
						{tr.leaves.filter((r) => r.tasks?.length).map((r) => {
							const d = trialDetail(r);
							return (
								<div class="p2m-trial-leaf" data-trial-leaf={r.leaf}>
									<p class="p2m-tleaf">{named(idOfTheorem(r.theorem), r.leaf)}</p>
									<Fragment set:html={leafPlanHTML(r.leaf, leafPlan(d, [], reuseOf[r.theorem]), true)} />
									<Fragment set:html={taskTableHTML(r.leaf, d, `${named(idOfTheorem(r.theorem), r.leaf)}: every task`)} />
								</div>
							);
						})}
					</div>
				)}
			</details>
		))
	}

	<h2 id="how-to-read-this">How to read this</h2>
	<ul>
		<li>
			<strong>The Lean kernel is the judge.</strong> A run counts as proved only when our full check passes (the proof builds, its theorem
			is exactly the leaf’s, and it uses no <code>sorry</code> and only the axioms <code>propext</code>, <code>Classical.choice</code> and
			{' '}<code>Quot.sound</code>), with Lean {p2m.lean} and Mathlib <code>{p2m.mathlib}</code> as on prove2me. A submission counts as
			accepted only when prove2me’s verdict says so. We do not grade the model’s work ourselves.
		</li>
		<li>
			<strong>Calibration and open leaves.</strong> A calibration leaf had already been proved by someone else when we chose it. It
			tells us whether the setup works; the model is not shown that proof, and we never submit one. An open leaf had no accepted proof
			when we chose it. An open leaf “closed by reuse” has the same statement as a theorem already proved on prove2me, or is a part of
			one: we submit the one-line proof that uses it, name its author, and do not count it as proved by the model.
		</li>
		<li>
			<strong>Every run counts.</strong> A run is one leaf in one trial: a first round, and from trial 2 up to two fix rounds in which
			the model gets Lean’s errors. From trial 5 a run is all of a leaf’s tasks: its outlines, one task per hole, the tries and the
			assembly. Failed runs stay in the tables. A leaf tried again in a later trial counts as one more run, and once among the open
			leaves tried. Runs cut short by a fault on our side, not the model’s, or stopped by us because of one, say “Not scored” and why
			({t.runs - t.scored} so far); they still count among the runs.
		</li>
		<li>
			<strong>Model minutes</strong> are the time the model spent generating, summed over a run’s rounds (from trial 5, its tasks).
			{' '}<strong>Qwen tokens</strong> are everything the model read and wrote in a run, as on the Tau Ceti page:
			{' '}{compact(qwenTokens(t))} in all, of which {compact(t.output_tokens)} written. Most of what it reads is the same files again:
			{' '}{Math.round((100 * t.cached_tokens) / t.prompt_tokens)}% came from the cache. Hover a token count for the exact numbers. Two first tries in
			trial 2 that the gateway’s personal-data filter cut off are not in the counts.
		</li>
		<li>
			<strong>Working on now</strong> and the trials from trial 5 show each leaf’s outlines, newest first. An outline is in progress,
			refuted (one of its holes is false, or its shape was refused), proved (its holes put together passed our full check) or
			abandoned for a new outline. Each hole is proved by its own task, false (the model disproved it), closed before any task
			by the pre-pass of standard tactics, by our index of prove2me’s library (reuse) or by the ledger (proved before), or it is
			running, queued, not tried or cancelled; the holes left in the outline’s file (“in place”) share one task. A leaf’s tokens
			count every task, each outline and each try included: <strong>Qwen tokens</strong> as above (everything read, cache
			re-reads included, and everything written), and <strong>computed</strong> tokens, the part the GPU worked through fresh
			(what it read without the cache, plus what it wrote). Open “Every task” for each task’s result, steps, model minutes and
			tokens. A running task’s steps and tokens show as the gateway counts them where it can, else once the task ends.
		</li>
		<li>
			<strong>Small samples.</strong> {t.runs} runs in {trials.length} trials, each with a different scaffold, budget and set of leaves.
			They show what happened, not a success rate.
		</li>
		<li>
			<strong>These are our own measurements</strong>, from the records of each run, not estimates. The model runs on the AIs@home
			network, which today is mostly the maintainer’s own GPUs, some of them rented. The data is published as JSON:
			{' '}<a href="/science/prove2me.json" data-p2m-json><code>/science/prove2me.json</code></a>.
		</li>
	</ul>

	<h2 id="next">What comes next</h2>
	<ul>
		<li>
			Trial 5 asked whether one task per hole closes holes that whole-leaf rounds could not. On F01 it did, once; on O02 it closed
			none before we stopped it.
		</li>
		<li>
			Trial {cur?.trial ?? trials.length + 1}{preparing ? ', being prepared (above)' : ', above'}: whether its scaffold, described
			under “Working on now”, lets the model close easier open leaves, chosen by quick outline probes.
		</li>
		<li>
			Then a random sample of open leaves at a fixed budget, with the pass line written down before the run: the test of whether this
			works at a useful rate, and what a proof costs.
		</li>
		<li>
			The question behind it: can an open model on one consumer GPU close open leaves often enough that volunteers’ GPUs could do real
			work here?
		</li>
	</ul>
</StarlightPage>

<script>
	import { leafTokensText, liveLeaves, taskTableHTML } from '../../data/prove2me-live';
	import { leafPlan, leafPlanHTML } from '../../data/prove2me-outlines';
	import type { LiveLeaf, Outline, StaticTask } from '../../data/prove2me-live';
	import { compareLeaves, leafFirstDir, type LeafKeys, type LeafSort, type LeafSortKey } from '../../data/prove2me-live';
	import { attachTaskTable, type TaskTableRow } from '../../data/task-table';
	import { p2mTaskOptions } from '../../data/prove2me-tasks';
	import { CURRENT_URL, TASKS_URL, day, hhmm, mdLightHTML, parseCurrent, parseTasks, roleLabel, submissionText, taskTableRows, theoremURL, trialQueue } from '../../data/prove2me-current';
	import type { CurrentDoc, TasksView } from '../../data/prove2me-current';

	// Every task: the build's rows, filtered and sorted here; the current trial's tasks from the gateway replace or join them.
	const taskBox = document.querySelector<HTMLElement>('[data-p2m-alltasks]');
	const taskKnown = JSON.parse(document.querySelector('[data-p2m-tasks-known]')?.textContent || '{"rows":[],"trial":null,"leafIds":{}}') as {
		rows: TaskTableRow[];
		trial: number | null;
		leafIds: Record<string, string>;
	};
	const taskTable = taskBox ? attachTaskTable(taskBox, p2mTaskOptions(taskKnown.rows, taskKnown.trial), taskKnown.rows) : null;

	// "Working on now", live: the project's data document (its trial, text, leaves, submissions) and the gateway's public
	// task list, on load and every minute. Both must answer with what they should; otherwise the build's copy stays.
	const nowBox = document.querySelector<HTMLElement>('[data-p2m-now]');
	type Known = {
		reuses: Record<string, string>;
		trial: string;
		order: string[];
		tasks: StaticTask[];
		outlines: Record<string, Outline[]>;
		leaves: Record<string, { theorem: string; url: string; group: string; earlier: number[] }>;
		theorems: Record<string, string>;
	};
	let known: Known = { reuses: {}, trial: '', order: [], tasks: [], outlines: {}, leaves: {}, theorems: {} };
	try {
		known = JSON.parse(document.querySelector('[data-p2m-known]')?.textContent || '{}') as Known;
	} catch {}
	const el = (tag: string, cls?: string, text?: string) => {
		const e = document.createElement(tag);
		if (cls) e.className = cls;
		if (text !== undefined) e.textContent = text;
		return e;
	};
	const getJSON = async (url: string) => {
		const ctl = new AbortController();
		const timer = setTimeout(() => ctl.abort(), 8000);
		try {
			const res = await fetch(url, { signal: ctl.signal, headers: { accept: 'application/json' } });
			if (!res.ok) throw new Error(String(res.status));
			return await res.json();
		} finally {
			clearTimeout(timer);
		}
	};
	const headText = (t: CurrentDoc['trial']) =>
		t.status === 'preparing'
			? `Trial ${t.number} is being prepared · scaffold ${t.scaffold}`
			: t.status === 'finished'
				? `Trial ${t.number} has ended · scaffold ${t.scaffold}`
				: `Trial ${t.number}${t.start ? `, since ${day(t.start)}` : ''} · scaffold ${t.scaffold}`;

	/** One leaf of the document, with its tasks when it has any. */
	const leafItem = (doc: CurrentDoc, l: CurrentDoc['leaves'][number] | undefined, live: LiveLeaf | undefined, sameTrial: boolean) => {
		const alias = l?.alias ?? live!.leaf;
		const k = sameTrial ? known.leaves[alias] : undefined;
		// #leaf-<id> (the account page's link to a task's leaf names its leaf label) and #leaf-<alias> both find the leaf
		const li = el('li');
		li.id = `leaf-${l?.id ?? alias}`;
		li.dataset.currentLeaf = alias;
		if (l) li.dataset.leafId = l.id;
		const state = live?.state ?? 'planned';
		li.dataset.state = state;
		li.append(el('span', 'leaf', l?.id ?? alias));
		if (l) {
			const small = el('span', 'alias', alias);
			small.id = `leaf-${alias}`;
			small.title = 'The id the trials used';
			small.dataset.alias = '';
			li.append(small);
		}
		const theorem = l?.theorem || live?.theorem || '';
		const url = l?.url || known.theorems[theorem] || '';
		if (theorem) {
			const a = el(theoremURL.test(url) ? 'a' : 'span', 'thm-name', theorem);
			if (a instanceof HTMLAnchorElement) a.href = url;
			li.append(' ', a);
		}
		const meta = el('span', 'meta');
		const role = l?.role ?? (live?.group === 'calibration' ? 'calibration' : 'open');
		meta.append(el('span', '', `${roleLabel[role] ?? 'Open'} leaf`));
		if (k?.earlier?.length) meta.append(el('span', '', `tried before in trial${k.earlier.length > 1 ? 's' : ''} ${k.earlier.join(' and ')}`));
		const d = live?.detail;
		if (d && (d.total > 0 || d.computed > 0)) {
			const tok = el('span', '', leafTokensText(d, state === 'running' || state === 'queued'));
			tok.dataset.tokens = String(d.total);
			tok.dataset.computed = String(d.computed);
			tok.dataset.exact = String(d.exact);
			meta.append(tok);
		}
		for (const s of doc.submissions.filter((s) => s.leaf === l?.id)) {
			const sub = el('span', '', `${submissionText(s)} (${day(s.verdict_at ?? s.submitted_at, false)})`);
			sub.dataset.submission = s.verdict;
			meta.append(sub);
		}
		li.append(meta);
		// closed by reuse: the theorem the accepted proof imports (the document's, else the build's)
		const reuseSub = doc.submissions.find((s) => s.leaf === l?.id && s.kind === 'reuse');
		const reuse = reuseSub ? reuseSub.reuses?.theorem ?? known.reuses?.[theorem] ?? 'a theorem already proved on prove2me' : undefined;
		const plan = live ? leafPlan(live.detail, l?.outlines ?? [], reuse) : null;
		const words = state === 'planned' || !plan ? 'Not started yet' : plan.summary;
		const st = el('span', `state state-${state}`, words);
		st.dataset.progress = plan?.summary ?? '';
		st.dataset.leafSummary = '';
		li.append(st);
		if (live && plan) li.insertAdjacentHTML('beforeend', leafPlanHTML(alias, plan) + taskTableHTML(alias, live.detail, 'Every task'));
		return li;
	};

	const showNow = (doc: CurrentDoc, tasks: TasksView) => {
		taskTable?.setLive(taskTableRows(tasks, doc, taskKnown.leafIds));
		if (!nowBox) return;
		const t = doc.trial;
		const sameTrial = t.id === known.trial;
		const q = trialQueue(tasks, doc);
		const live = liveLeaves(q, t.id, doc.leaves.map((l) => l.alias), sameTrial ? known : {});
		const items = [
			...doc.leaves.map((l) => leafItem(doc, l, live.find((x) => x.leaf === l.alias), sameTrial)),
			...live.filter((x) => !doc.leaves.some((l) => l.alias === x.leaf)).map((x) => leafItem(doc, undefined, x, sameTrial)),
		];
		nowBox.querySelector<HTMLElement>('[data-now-head]')!.textContent = headText(t);
		const about = nowBox.querySelector<HTMLElement>('[data-now-about]')!;
		about.innerHTML = mdLightHTML(t.description); // escaped first (prove2me-current.ts)
		about.hidden = !t.description.trim();
		const budget = nowBox.querySelector<HTMLElement>('[data-now-budget]')!;
		budget.textContent = t.budget ? `Budget: ${t.budget}.` : '';
		budget.hidden = !t.budget;
		const list = nowBox.querySelector<HTMLElement>('[data-now-leaves]')!;
		// a leaf's task table stays open across the minute's refresh
		const opened = new Set([...list.querySelectorAll<HTMLDetailsElement>('details[data-leaf-tasks]')].filter((d) => d.open).map((d) => d.dataset.leafTasks));
		list.replaceChildren(...items);
		list.querySelectorAll<HTMLDetailsElement>('details[data-leaf-tasks]').forEach((d) => (d.open = opened.has(d.dataset.leafTasks)));
		// the trial's submissions of leaves it does not list (a leaf closed by reuse while the trial was prepared)
		const others = doc.submissions.filter((s) => !doc.leaves.some((l) => l.id === s.leaf));
		const subs = nowBox.querySelector<HTMLElement>('[data-now-subs]')!;
		subs.textContent = others.length
			? `Also from this trial: ${others.map((s) => `${s.leaf} (${s.alias}), ${submissionText(s)} on ${day(s.verdict_at ?? s.submitted_at, false)}`).join('; ')}.`
			: '';
		subs.hidden = !others.length;
		const asof = nowBox.querySelector<HTMLElement>('[data-now-asof]')!;
		asof.hidden = false;
		asof.textContent =
			`Live: the trial’s data as published ${day(doc.updated_at, false)}, ${hhmm(doc.updated_at)}; its tasks from the gateway, ` +
			`updated ${hhmm(tasks.updated)}. It refreshes every minute.`;
		nowBox.dataset.source = 'live';
		nowBox.dataset.trial = t.id;
		nowBox.dataset.status = t.status;
		markLeaf();
	};
	const loadNow = async () => {
		if (!window.fetch) return;
		let doc: CurrentDoc | null, tasks: TasksView | null;
		try {
			const [d, ts] = await Promise.all([getJSON(CURRENT_URL), getJSON(TASKS_URL)]);
			doc = parseCurrent(d);
			tasks = parseTasks(ts);
		} catch {
			return; // keep what the page shows
		}
		if (!doc || !tasks) return;
		try {
			showNow(doc, tasks);
		} catch {
			// keep what the page shows
		}
	};
	// #leaf-<id> or #leaf-<alias>: that leaf's row is marked (the alias is a span inside the row)
	const markLeaf = () => {
		const li = location.hash.startsWith('#leaf-') ? document.getElementById(location.hash.slice(1))?.closest('li') : null;
		document.querySelectorAll('[data-p2m-now] li.target').forEach((x) => x !== li && x.classList.remove('target'));
		li?.classList.add('target');
	};
	window.addEventListener('hashchange', markLeaf);
	markLeaf();
	loadNow();
	setInterval(() => document.visibilityState === 'visible' && loadNow(), 60000);

	// The network's share of the work for project prove2me, from the gateway's public /v1/stats (aggregates only).
	// Hidden until real numbers arrive and on any failure: never dashes or zeros by default.
	const box = document.querySelector<HTMLElement>('[data-p2m-live]');
	const ok = (n: unknown): n is number => typeof n === 'number' && Number.isFinite(n) && n >= 0;
	const full = new Intl.NumberFormat('en');
	const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
	const load = async () => {
		if (!box || !window.fetch) return;
		try {
			const ctl = new AbortController();
			const timer = setTimeout(() => ctl.abort(), 8000);
			const res = await fetch('/v1/stats', { signal: ctl.signal, headers: { accept: 'application/json' } });
			clearTimeout(timer);
			if (!res.ok) throw new Error(String(res.status));
			const d = await res.json();
			const all = d?.total?.projects?.prove2me;
			const today = d?.today?.projects?.prove2me ?? { requests: 0 };
			const todayAll = d?.today?.requests;
			const at = new Date(d?.updated);
			const tokens = (all?.prompt_tokens ?? NaN) + (all?.completion_tokens ?? NaN);
			if (!all || ![all.requests, tokens, all.node_seconds ?? 0, today.requests, todayAll].every(ok) || Number.isNaN(at.getTime())) throw new Error('data');
			const vals: Record<string, string> = {
				'today-requests': full.format(today.requests),
				'today-share': todayAll > 0 ? `${Math.round((100 * today.requests) / todayAll)}%` : '0%',
				requests: full.format(all.requests),
				tokens: compact.format(tokens),
				hours: (all.node_seconds / 3600).toFixed(1),
				updated: `${String(at.getUTCHours()).padStart(2, '0')}:${String(at.getUTCMinutes()).padStart(2, '0')}`,
			};
			box.querySelectorAll<HTMLElement>('[data-live]').forEach((el) => (el.textContent = vals[el.dataset.live ?? ''] ?? ''));
			box.querySelector<HTMLTimeElement>('time[data-live]')!.dateTime = at.toISOString();
			box.dataset.requests = String(all.requests);
			box.hidden = false;
		} catch {
			box.hidden = true;
		}
	};
	// A trial's link in the table (and a #trial-N address) opens that trial's list.
	const openTrial = () => {
		const d = location.hash.startsWith('#trial-') ? document.getElementById(location.hash.slice(1)) : null;
		if (d instanceof HTMLDetailsElement) d.open = true;
	};
	window.addEventListener('hashchange', openTrial);
	openTrial();

	// The table of every leaf: one role and one outcome filter, and a sort by column (▲/▼ and aria-sort on that column
	// only); before a click it keeps the build's order (first tried).
	const leafList = document.querySelector<HTMLDetailsElement>('[data-p2m-list]');
	const leafFilter = { role: '', outcome: '' };
	let leafSort: LeafSort | null = null;
	const numOrNull = (v: string | undefined) => (v === undefined || v === '' ? null : Number(v));
	const leafKeys = (r: HTMLElement): LeafKeys => ({
		leaf: r.dataset.leafId ?? '',
		theorem: r.querySelector('[data-sort-theorem]')?.textContent ?? '',
		first: Number(r.dataset.sortFirst),
		outcome: Number(r.dataset.sortOutcome),
		tokens: numOrNull(r.dataset.sortTokens),
		minutes: numOrNull(r.dataset.sortMinutes),
		order: Number(r.dataset.order),
	});
	const applyLeaves = () => {
		const body = leafList?.querySelector('[data-p2m-leaf-table] tbody');
		if (!leafList || !body) return;
		leafList.querySelectorAll<HTMLElement>('th[data-sort-col]').forEach((th) => {
			const on = !!leafSort && th.dataset.sortCol === leafSort.key;
			if (on) th.setAttribute('aria-sort', leafSort!.dir === 'asc' ? 'ascending' : 'descending');
			else th.removeAttribute('aria-sort');
			const mark = th.querySelector('.sort-mark');
			if (mark) mark.textContent = on ? (leafSort!.dir === 'asc' ? '▲' : '▼') : '';
		});
		const rows = [...body.querySelectorAll<HTMLElement>(':scope > tr')];
		const keys = new Map(rows.map((r) => [r, leafKeys(r)]));
		const sorted = [...rows].sort((a, b) => (leafSort ? compareLeaves(keys.get(a)!, keys.get(b)!, leafSort) : keys.get(a)!.order - keys.get(b)!.order));
		if (sorted.some((r, i) => r !== rows[i])) sorted.forEach((r) => body.appendChild(r));
		leafList.querySelectorAll<HTMLButtonElement>('[data-p2m-filters] [data-filter]').forEach((b) => {
			b.setAttribute('aria-pressed', String(leafFilter[b.dataset.filter as 'role' | 'outcome'] === (b.dataset.value ?? '')));
		});
		let shown = 0;
		for (const r of rows) {
			r.hidden = (!!leafFilter.role && !(r.dataset.roles ?? '').split(' ').includes(leafFilter.role)) || (!!leafFilter.outcome && r.dataset.outcome !== leafFilter.outcome);
			if (!r.hidden) shown++;
		}
		const count = leafList.querySelector('[data-p2m-list-count]');
		if (count) count.textContent = `Showing ${shown} of ${rows.length}`;
	};
	leafList?.addEventListener('click', (e) => {
		const head = (e.target as HTMLElement).closest<HTMLElement>('[data-leaf-sort]');
		if (head) {
			const key = head.dataset.leafSort as LeafSortKey;
			leafSort = { key, dir: leafSort?.key === key ? (leafSort.dir === 'asc' ? 'desc' : 'asc') : leafFirstDir(key) };
			applyLeaves();
			return;
		}
		const b = (e.target as HTMLElement).closest<HTMLElement>('[data-filter]');
		if (!b) return;
		leafFilter[b.dataset.filter as 'role' | 'outcome'] = b.dataset.value ?? '';
		applyLeaves();
	});
	applyLeaves();
	load();
	setInterval(() => document.visibilityState === 'visible' && load(), 60000);
</script>

