---
// Science: prove2me (prove2.me), where Qwen3.8 27B on the AIs@home network tries leaves of research theorems in
// Lean 4. Trials 1 to 5 are frozen history in src/data/science/prove2me.json; from trial 6 on everything
// comes from the gateway's public records (campaigns, results and tasks: prove2me-records.ts). The build fetches them
// (prove2me-build.ts; since 2026-11-23: no manual data exports), so the page without JavaScript is as of the build, and
// the browser reads them again every minute, with the network's share of the work from /v1/stats; when the gateway does
// not answer, the build's copy stays. The build and the browser draw every part with the same renderers.
//
// The page (2026-11-28, simpler): the work, live; the proved theorems page is what was proved and at what cost. It leads
// with that page's headline number and the way there, then the status and "Working on now" (one row per leaf, opening
// to its outlines, holes and tasks), the results, the submissions, the trials (one row per trial, newest first, opening
// to its list), every leaf and every task, and "How to read this" (four lines; the full method collapsed).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { counts, day, hhmm, outcomeLabel, p2m, plainTitle, span, sumTokens, theoremURL, tokTitle, tokensWithCache, computedTokens, compact } from '../../data/prove2me';
import { FROZEN_THROUGH, taskTableRows } from '../../data/prove2me-current';
import { allRuns, builtDetail, builtTaskRows, historyOf, leavesView, scienceView, trialDetails, type TrialDetail } from '../../data/prove2me-records';
import {
	acceptedOf, headlineStripHTML, kpisHTML, leafFiltersHTML, leafRowsHTML, leafScoreHTML, smallNumbersHTML, submissionRowsHTML, trialDetailHTML,
	trialNumbersHTML, trialPlainRowHTML, trialSummaryHTML, trialsFootHTML, trialsHeadHTML, trialsNewestFirst,
} from '../../data/prove2me-view';
import { fromStatic, leafDetail, taskTableHTML } from '../../data/prove2me-live';
import { leafPlan, leafPlanHTML } from '../../data/prove2me-outlines';
import { mergeRows, taskTableHTML as allTasksHTML } from '../../data/task-table';
import { p2mTaskOptions } from '../../data/prove2me-tasks';
import { queueBarHTML, statusTexts, statusView, type StatusView } from '../../data/prove2me-status';
import { nowAll, nowBlocksHTML } from '../../data/prove2me-now';
import { buildRecords } from '../../data/prove2me-build';
import { acceptedSeries } from '../../data/prove2me-chart';
import AcceptedChart from '../../components/AcceptedChart.astro';
import { THEOREMS_PATH } from '../../data/prove2me-theorems';

const safe = (u: string) => (theoremURL.test(u) ? u : undefined);
const groupLabel = { calibration: 'Calibration', open: 'Open' } as Record<string, string>;
const earlierText = (e: number[]) => (e.length ? `tried before in trial${e.length > 1 ? 's' : ''} ${e.join(' and ')}` : '');
// The gateway's records as the build fetched them (or its committed copy when the gateway did not answer the build).
const { records: rec, from: recFrom } = await buildRecords();
// A leaf closed by reuse: the proved theorem its one-line proof imports (the leaf's line says so).
const reuseOf: Record<string, string> = Object.fromEntries(p2m.submissions.filter((s) => s.kind === 'reuse' && s.reuses).map((s) => [s.theorem, s.reuses!.theorem]));
// For "Working on now": the build's theorem pages (a leaf a document lists without one) and its reuses.
const known = {
	reuses: reuseOf,
	theorems: Object.fromEntries(p2m.trials.flatMap((tr) => tr.leaves).filter((r) => safe(r.url)).map((r) => [r.theorem, r.url])),
	// each leaf's prove2me title by id, for its row's short title (the campaigns' items over the build's leaves)
	titles: Object.fromEntries([
		...p2m.leaves.map((l) => [l.id, l.title]),
		...rec.campaigns.flatMap((c) => c.items).filter((i) => i.title).map((i) => [i.id, i.title]),
	]) as Record<string, string>,
};
const trials = p2m.trials.map((tr) => ({ ...tr, c: counts(tr.leaves), hours: tr.leaves.reduce((a, r) => a + r.model_minutes, 0) / 60, tok: sumTokens(tr.leaves), v5: tr.leaves.some((r) => r.tasks) }));
// The page's numbers, submissions, trials and leaves (prove2me-records.ts): the build's history with the records the
// build fetched; the browser redoes them with the records it reads and the same renderers (prove2me-view.ts).
const hist = historyOf(p2m);
const view = scienceView(hist, rec);
// The proofs prove2me accepted, counted up over time (as on the home page), under the headline numbers.
const acceptedOverTime = acceptedSeries(view);
const kp = kpisHTML(view.kpis);
const lv = leavesView(hist, rec);
const score = leafScoreHTML(lv);
// The status block's build copy: the queue, the open benchmarks and trials and the submissions from the records; the
// browser adds the network and refreshes the rest.
const st: StatusView = { ...statusView(rec, null)!, source: 'build', saved: recFrom === 'snapshot' };
const stx = statusTexts(st, new Date(rec.updated));
const bar = queueBarHTML(st);
const frozenTrials = trials.filter((tr) => tr.trial <= FROZEN_THROUGH);
const frozenOf = (n: number) => frozenTrials.find((tr) => tr.trial === n);
const builtDetails = trialDetails(
	p2m.trials.filter((tr) => tr.trial > FROZEN_THROUGH).map((tr) => builtDetail(p2m, hist, tr.trial)).filter((d): d is TrialDetail => !!d),
	rec,
	hist,
);
// A finished v5 trial keeps each leaf's tasks: the same table as "Working on now", collapsed.
type Run = (typeof p2m.trials)[number]['leaves'][number];
const trialDetail = (r: Run) => leafDetail((r.tasks ?? []).map(fromStatic), r.outlines ?? []);
// "Working on now": every open benchmark and every trial not finished, from the records (prove2me-now.ts).
const runs = allRuns(hist, rec);
const earlier = (leaf: string, n: number) => [...new Set(runs.filter((r) => r.leaf === leaf && r.trial < n).map((r) => r.trial))].sort((a, b) => a - b);
const nowDocsBuilt = nowAll(null, rec);
const nowHTML = nowBlocksHTML(nowDocsBuilt, rec.tasks, { theorems: known.theorems, reuses: reuseOf, titles: known.titles, earlier });
// The texts below name F01's trial-5 run; its task count comes from the data.
const f01 = p2m.trials.flatMap((tr) => tr.leaves).find((r) => r.leaf === 'F01' && r.outcome === 'proved' && r.tasks);
// A leaf's id (p2m- and the start of prove2me's theorem id) leads everywhere; the trials' alias (O04, F01) is shown small.
const probeLeaves = (p2m.probes ?? []).flatMap((r) => r.leaves);
const idOfTheorem = (theorem: string) => p2m.leaves.find((l) => l.theorem === theorem)?.id ?? probeLeaves.find((l) => l.theorem === theorem)?.id;
const idOfAlias = (alias: string) => p2m.leaves.find((l) => l.aliases.includes(alias))?.id ?? alias;
const named = (id: string | undefined, alias: string) => (id && id !== alias ? `${id} (${alias})` : alias);
// Alias -> leaf id for the history the "Small numbers" text names (O04, F01); the browser's script gets it too.
const aliasIds: Record<string, string> = Object.fromEntries(['O04', 'F01'].map((a) => [a, idOfAlias(a)]));
// Every task: the generic task table with prove2me's options; every task of trial 6 on (and of the outline probes) from
// the records, the build's and then the browser's. Each leaf's theorem and page for its group cell (the
// trials', the campaigns' and the probe rounds' leaves; the browser adds the data document's), and a written outline's
// hole count by task id for the live rows.
const items = rec.campaigns.flatMap((c) => c.items).filter((i) => i.labels.theorem);
const leafIds: Record<string, string> = Object.fromEntries([
	...items.map((i) => [i.labels.theorem, i.id]),
	...probeLeaves.map((l) => [l.theorem, l.id]),
	...p2m.leaves.map((l) => [l.theorem, l.id]),
]);
const taskLeaves: Record<string, { theorem: string; url: string }> = Object.fromEntries([
	...items.map((i) => [i.id, { theorem: i.labels.theorem, url: safe(i.url) ?? '' }]),
	...probeLeaves.map((l) => [l.id, { theorem: l.theorem, url: safe(l.url) ?? '' }]),
	...p2m.leaves.map((l) => [l.id, { theorem: l.theorem, url: safe(l.url) ?? '' }]),
]);
const taskHoles: Record<string, string> = Object.fromEntries(p2m.tasks.filter((r) => r.labels.holes).map((r) => [r.id, r.labels.holes]));
// the build's rows with tokens computed (the export's hold the cache re-reads), the records' rows over them
const builtRows = mergeRows(builtTaskRows(p2m), taskTableRows(rec.tasks, null, leafIds, taskHoles));
const tasksHTML = allTasksHTML(builtRows, p2mTaskOptions(taskLeaves));
const taskKnown = { rows: builtRows, leafIds, leaves: taskLeaves, holes: taskHoles };
// What the browser's script needs to redo the numbers, submissions, trials, leaves and the status block with the
// gateway's records; the build's status stands in while the gateway does not answer.
const recordsKnown = { history: hist, model: p2m.model, f01Tasks: f01?.tasks?.length ?? null, aliasIds, status: st };
const cacheTimes = Math.round(view.kpis.withCache / Math.max(view.kpis.computed, 1));
const cacheShare = Math.round((100 * (view.kpis.withCache - view.kpis.computed)) / Math.max(view.kpis.withCache, 1));
const leafCols = [
	{ key: 'leaf', label: 'Leaf' },
	{ key: 'theorem', label: 'Theorem' },
	{ key: '', label: 'Role' },
	{ key: '', label: 'Trials' },
	{ key: 'outcome', label: 'Outcome' },
	{ key: 'first', label: 'First tried' },
	{ key: 'minutes', label: 'Model min', num: true },
	{ key: 'tokens', label: 'Tokens computed', num: true },
];
---

<StarlightPage
	frontmatter={{
		title: 'Science: prove2me',
		// The browser tab and search result: what the page shows, in the words people search for.
		head: [{ tag: 'title', content: `${p2m.model} proving Lean 4 theorems on prove2me - AIs@home` }],
		description: `Leaves of prove2me, research theorems stated in Lean 4, that ${p2m.model}, an open model on the AIs@home network, tried to prove, and the proofs we submitted. Every run counts.`,
	}}
	headings={[
		{ depth: 2, slug: 'status', text: 'Status' },
		{ depth: 2, slug: 'working-on-now', text: 'Working on now' },
		{ depth: 2, slug: 'results', text: 'Results so far' },
		{ depth: 2, slug: 'submissions', text: 'Submitted to prove2me' },
		{ depth: 2, slug: 'trials', text: 'Trials' },
		{ depth: 2, slug: 'leaves', text: 'Every leaf' },
		{ depth: 2, slug: 'tasks', text: 'Every task' },
		{ depth: 2, slug: 'how-to-read-this', text: 'How to read this' },
	]}
>
	{/* The headline: the same number, in the same words, as the proved theorems page's, and the way there (live, see the script). */}
	<section class="p2m-headline not-content" data-p2m-headline data-source="build" aria-label="Proofs accepted by prove2me" set:html={headlineStripHTML(view, p2m.model)} />

	<p>
		<a href={p2m.project_url} data-p2m-link="home">prove2me</a> collects theorems from mathematical research papers, stated in Lean 4
		and split into small pieces called leaves. Anyone, a person or an agent, may submit a proof of an open leaf, and prove2me’s own
		check decides: the Lean kernel and the axioms the proof uses.
	</p>
	<p>
		{p2m.model}, an open-weight model on the AIs@home network, works on leaves as an agent, with Lean and Mathlib at prove2me’s
		versions. Our own full check judges every attempt: the proof must build, state exactly the leaf’s theorem, and use no
		{' '}<code>sorry</code> and no axiom beyond Lean’s standard three. We submit every proof that passes it. AIs@home is not part of prove2me.
	</p>
	<script is:inline type="application/json" data-p2m-records-known set:html={JSON.stringify(recordsKnown).replace(/</g, '\\u003c')} />

	{/* The status block: the queue and the open benchmarks and trials from the records the build fetched; the browser
	    refreshes them from the gateway's records and adds /v1/stats every minute (prove2me-status.ts). */}
	<section class="p2m-status not-content" data-p2m-status data-source="build" data-trials={st.trials.map((x) => x.label).join(' ')} aria-labelledby="status">
		<h2 id="status">Status</h2>
		<p class="p2m-st-head" data-st="head">{stx.head}</p>
		<p class="p2m-st-queue" data-st="queue" hidden={!stx.queue}>{stx.queue}</p>
		<div class="p2m-queue" data-st-queue aria-hidden="true" hidden={!bar.bar}>
			<div class="p2m-bar" data-st-bar set:html={bar.bar} />
			<div class="p2m-qlabels" data-st-qlabels set:html={bar.labels} />
			<ul class="p2m-legend">
				<li><span class="sw q-running" />running</li>
				<li><span class="sw q-queued" />waiting</li>
			</ul>
		</div>
		<ul class="p2m-st-trials" data-st-trials hidden={!stx.lines.length}>
			{stx.lines.map((line, i) => <li data-trial={st.trials[i].label}>{line}</li>)}
		</ul>
		<dl class="p2m-st-nums">
			<div data-num="nodes" hidden><dt>nodes online (whole network)</dt><dd /></div>
			<div data-num="slots" hidden><dt>GPU slots busy now</dt><dd /></div>
		</dl>
		<p class="p2m-st-updated" data-st="updated">{stx.updated}</p>
	</section>

	<h2 id="working-on-now">Working on now</h2>
	<script is:inline type="application/json" data-p2m-known set:html={JSON.stringify(known).replace(/</g, '\\u003c')} />
	{/* The build's copy; the browser replaces it with the project's data document and the gateway's tasks (see the script). */}
	<section class="p2m-now not-content" data-p2m-now data-trial={nowDocsBuilt.map((d) => d.trial.id).join(' ')} data-source="build">
		{/* One block per open benchmark and per trial not finished (prove2me-now.ts), one row per leaf that opens to its
		    outlines, holes and tasks; the outline probes sit under the newest trial's head. */}
		<div class="probes" data-now-probes hidden>
			<p class="probes-head" data-probes-head></p>
			<ul data-probes-list></ul>
		</div>
		<Fragment set:html={nowHTML} />
		<p class="meta" data-now-asof>As of {day(rec.updated)}, {hhmm(rec.updated)}: a copy from the site’s last build.</p>
	</section>

	<h2 id="results">Results so far</h2>
	{/* The build's numbers; the browser redoes them from the gateway's records (see the script). */}
	<dl class="p2m-kpis not-content" data-p2m-kpis data-source="build" style={`--kpis: ${kp.n}`} set:html={kp.html} />
	<p data-p2m-small set:html={smallNumbersHTML(view, f01?.tasks?.length, idOfAlias)} />
	<AcceptedChart series={acceptedOverTime} class="p2m-accepted-chart" />

	<section class="p2m-live not-content" data-p2m-live hidden aria-labelledby="p2m-live-head">
		<h3 id="p2m-live-head">prove2me on the network</h3>
		<dl class="p2m-live-list">
			<div><dt>requests today (UTC)</dt><dd data-live="today-requests"></dd></div>
			<div><dt>of all the network’s requests today</dt><dd data-live="today-share"></dd></div>
			<div><dt>requests in all</dt><dd data-live="requests"></dd></div>
			<div><dt>tokens computed in all</dt><dd data-live="tokens"></dd></div>
			<div><dt>GPU hours in all</dt><dd data-live="hours"></dd></div>
		</dl>
		<p class="p2m-note">Live, updated <time data-live="updated"></time> UTC.</p>
	</section>

	<h2 id="submissions">Submitted to prove2me</h2>
	<p>Every proof we submitted and prove2me’s verdict, newest first. <a href={THEOREMS_PATH} data-p2m-theorems-link="submissions">Each accepted proof with what it cost →</a></p>
	{/* Newest trial first; the area shows about five and scrolls for the rest (a keyboard can scroll it too). */}
	<div class="p2m-wrap p2m-subs-scroll not-content" data-p2m-subs-scroll tabindex="0" role="region" aria-label="Submitted to prove2me, newest trial first">
		<table class="p2m-table" data-p2m-submissions data-source="build">
			<thead>
				<tr><th scope="col">Leaf</th><th scope="col">Theorem</th><th scope="col">From</th><th scope="col">Submitted</th><th scope="col">prove2me’s verdict</th></tr>
			</thead>
			<tbody set:html={submissionRowsHTML(view)} />
		</table>
	</div>
	<p class="caps">Closed by reuse: the proof imports a theorem someone else had already proved; not counted as the model’s proof.</p>

	<h2 id="trials">Trials</h2>
	<p>
		Each trial changed the agent’s scaffold (its instructions, tools and rounds) from what the one before taught, so the trials are
		steps, not repeats. Newest first; open a trial for every leaf it ran.
	</p>
	{/* One row per trial (prove2me-view.ts trialSummaryHTML), newest first, each opening to its own list. Trials 1 to 5 are
	    frozen history; from trial 6 on each trial's list is made from its records (the build's here, the gateway's in
	    the browser: trialDetailHTML). */}
	<div class="p2m-trials not-content" data-p2m-trials data-source="build">
		<p class="p2m-trow p2m-thead" aria-hidden="true" set:html={trialsHeadHTML()} />
		<div class="p2m-trial-rows" data-p2m-trial-lists>
		{
			trialsNewestFirst(view).map((t) => {
				const tr = !t.probe && t.number <= FROZEN_THROUGH ? frozenOf(t.number) : undefined;
				const built = !t.probe ? builtDetails.find((d) => d.sum.number === t.number) : undefined;
				if (built) return <Fragment set:html={trialDetailHTML(built)} />;
				if (!tr) return <Fragment set:html={trialPlainRowHTML(t, acceptedOf(view, t.number))} />;
				return (
					<details class="p2m-trial" id={`trial-${tr.trial}`} data-p2m-trial={tr.trial} data-trial={t.label} data-source="build">
						<summary class="p2m-trow" set:html={trialSummaryHTML(t, acceptedOf(view, t.number))} />
						<p>{tr.summary}</p>
						<Fragment set:html={trialNumbersHTML(t)} />
						<p class="caps">Budget per leaf: {tr.caps}.</p>
						<div class="p2m-wrap not-content">
							<table class="p2m-table p2m-leaves">
								<thead>
									<tr><th scope="col">Leaf</th><th scope="col">Theorem</th><th scope="col">Kind</th><th scope="col">Result</th><th scope="col" class="num">{tr.v5 ? 'Tasks' : 'Rounds'}</th><th scope="col" class="num">Model min</th><th scope="col" class="num">Tokens computed</th></tr>
								</thead>
								<tbody>
									{tr.leaves.map((r) => (
										<tr data-leaf={r.leaf} data-outcome={r.outcome} data-scored={String(r.scored)}>
											<th scope="row">
												{idOfTheorem(r.theorem) ?? r.leaf}
												{idOfTheorem(r.theorem) && <span class="sub" data-alias title="The id the trials used">{r.leaf}</span>}
											</th>
											<td class="thm">
												<a href={safe(r.url)}>{r.theorem}</a>
												<span class="sub">{plainTitle(r.title)}</span>
											</td>
											<td data-label="Kind">
												{groupLabel[r.group] ?? r.group}
												{r.earlier.length > 0 && <span class="sub">{earlierText(r.earlier)}</span>}
											</td>
											<td data-label="Result" class:list={['result', r.outcome === 'proved' ? 'proved' : r.scored ? 'failed' : 'unscored']}>
												{outcomeLabel(r)}
												{!r.scored && r.not_scored_why && <span class="sub">{r.not_scored_why}</span>}
											</td>
											{r.tasks ? (
												<td data-label="Tasks" class="num">
													{r.tasks.length}
													<span class="sub">{r.rounds === 1 ? '1 outline' : `${r.rounds} outlines`}</span>
												</td>
											) : (
												<td data-label="Rounds" class="num">{r.rounds}</td>
											)}
											<td data-label="Model min" class="num">{r.model_minutes.toFixed(1)}</td>
											<td data-label="Tokens computed" class="num tok" data-tokens={computedTokens(r)} data-with-cache={tokensWithCache(r)} title={tokTitle(r)}>{compact(computedTokens(r))}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
						{tr.v5 && (
							<div class="p2m-trial-tasks not-content" data-p2m-trial-tasks={tr.trial}>
								<p class="caps">Each leaf’s outlines, newest first, with what became of every hole; under each, every task (outline, hole, try and assembly) with its counts, as in “Working on now”.</p>
								{tr.leaves.filter((r) => r.tasks?.length).map((r) => {
									const d = trialDetail(r);
									return (
										<div class="p2m-trial-leaf" data-trial-leaf={r.leaf}>
											<p class="p2m-tleaf">{named(idOfTheorem(r.theorem), r.leaf)}</p>
											<Fragment set:html={leafPlanHTML(r.leaf, leafPlan(d, [], reuseOf[r.theorem]), true)} />
											<Fragment set:html={taskTableHTML(r.leaf, d, `${named(idOfTheorem(r.theorem), r.leaf)}: every task`)} />
										</div>
									);
								})}
							</div>
						)}
					</details>
				);
			})
		}
		</div>
		<p class="p2m-trow p2m-tall" data-p2m-trials-all set:html={trialsFootHTML(view)} />
	</div>

	<h2 id="leaves">Every leaf</h2>
	<p>
		All <span data-p2m-leaf-total>{lv.all.leaves}</span> leaves tried so far, one row per leaf over every trial that ran it. A leaf’s id here is <code>p2m-</code> and the start
		of prove2me’s own id for the theorem; the id the trials used (C11, F01, …) is shown under it. Its outcome is the best of its runs:
		accepted by prove2me, closed by reuse, proved, not proved, stopped by us, or not scored. Trials 1 to 5 as recorded; from trial 6 on
		from the gateway’s records.
	</p>
	<div class="p2m-wrap not-content">
		<table class="p2m-table p2m-score" data-p2m-scorecard data-source="build">
			<thead>
				<tr>
					<th scope="col">Role</th><th scope="col" class="num">Leaves</th><th scope="col" class="num">Runs</th>
					<th scope="col" class="num">Runs proved</th><th scope="col" class="num">Proofs accepted</th>
					<th scope="col" class="num">Closed by reuse</th><th scope="col" class="num">Model hours</th><th scope="col" class="num">Tokens computed</th>
				</tr>
			</thead>
			<tbody set:html={score.body} />
			<tfoot set:html={score.foot} />
		</table>
	</div>
	<p class="caps">
		A comparison leaf is an open leaf run again to compare a new scaffold with the trials before it. A leaf can have more than one role
		over its trials, so the leaves by role add up to more than <span data-p2m-leaf-total>{lv.all.leaves}</span>. A proof accepted counts under the role of the run that proved
		it; a leaf closed by reuse has no run. An outline probe is one short outline task on a candidate leaf, run to choose a trial’s leaves: it is no run, but its model time and tokens count in the totals.
	</p>
	<details class="p2m-list" data-p2m-list>
		<summary>All <span data-p2m-leaf-total>{lv.all.leaves}</span> leaves</summary>
		<div class="p2m-filters not-content" role="group" aria-label="Filter the leaves" data-p2m-filters set:html={leafFiltersHTML(lv)} />
		<p class="caps" data-p2m-list-count>Showing {lv.all.leaves} of {lv.all.leaves}</p>
		<div class="p2m-wrap not-content">
			<table class="p2m-table p2m-lt" data-p2m-leaf-table>
				<thead>
					<tr>
						{leafCols.map((c) =>
							c.key ? (
								<th scope="col" class:list={[{ num: c.num }]} data-sort-col={c.key}>
									<button type="button" data-leaf-sort={c.key}>{c.label}<span class="sort-mark" aria-hidden="true"></span></button>
								</th>
							) : (
								<th scope="col" class="nosort">{c.label}</th>
							),
						)}
					</tr>
				</thead>
				<tbody set:html={leafRowsHTML(lv)} />
			</table>
		</div>
	</details>

	<h2 id="tasks">Every task</h2>
	<p>
		Every task of every trial and of the outline probes, grouped by leaf and outline; a run of trials 1 to 4 is one task.
		From trial 6 on, the tasks come live from the gateway’s records, each trial as soon as its tasks are made.
	</p>
	<script is:inline type="application/json" data-p2m-tasks-known set:html={JSON.stringify(taskKnown).replace(/</g, '\\u003c')} />
	<details class="p2m-list p2m-alltasks not-content" data-p2m-alltasks>
		<summary>All tasks</summary>
		<Fragment set:html={tasksHTML} />
	</details>

	<h2 id="how-to-read-this">How to read this</h2>
	<ul class="p2m-read" data-p2m-read>
		<li><strong>The Lean kernel is the judge.</strong> A proof counts only when it passes our full check, and as accepted only when prove2me says so.</li>
		<li><strong>Every attempt counts.</strong> Failed runs stay in the tables and the totals.</li>
		<li><strong>Reuses are not the model’s proofs.</strong> A leaf closed by a theorem someone else proved is listed, marked, and never counted as proved by the model.</li>
		<li><strong>These are our own records, live.</strong> The page reads the gateway’s public records every minute.</li>
	</ul>
	<details class="p2m-method" data-p2m-method>
		<summary>The full method</summary>
		<ul>
			<li>
				<strong>The Lean kernel is the judge.</strong> A run counts as proved only when our full check passes (the proof builds, its theorem
				is exactly the leaf’s, and it uses no <code>sorry</code> and only the axioms <code>propext</code>, <code>Classical.choice</code> and
				{' '}<code>Quot.sound</code>), with Lean {p2m.lean} and Mathlib <code>{p2m.mathlib}</code> as on prove2me. A submission counts as
				accepted only when prove2me’s verdict says so. We do not grade the model’s work ourselves. Since 12 November 2026 we submit every
				proof of an open leaf that passes our check.
			</li>
			<li>
				<strong>Calibration and open leaves.</strong> A calibration leaf had already been proved by someone else when we chose it. It
				tells us whether the setup works; the model is not shown that proof, and we never submit one. An open leaf had no accepted proof
				when we chose it. An open leaf “closed by reuse” has the same statement as a theorem already proved on prove2me, or is a part of
				one: we submit the one-line proof that uses it, name its author, and do not count it as proved by the model.
			</li>
			<li>
				<strong>Every run counts.</strong> A run is one leaf in one trial: a first round, and from trial 2 up to two fix rounds in which
				the model gets Lean’s errors. From trial 5 a run is all of a leaf’s tasks: its outlines, one task per hole, the tries and the
				assembly. Failed runs stay in the tables. A leaf tried again in a later trial counts as one more run, and once among the open
				leaves tried. Runs cut short by a fault on our side, not the model’s, or stopped by us because of one, say “Not scored” and why
				(<span data-p2m-not-scored>{lv.notScored}</span> so far); they still count among the runs. A bench runs leaves of earlier trials again
				on a newer scaffold: its runs are not counted in the numbers, the trials or the leaves, where they would count those leaves twice.
			</li>
			<li>
				<strong>Model minutes</strong> are the time the model spent generating, summed over a run’s rounds (from trial 5, its tasks).
				A trial’s GPU-hours per proof are its model hours over the proofs from it that prove2me accepted.
				{' '}<strong>Tokens computed</strong> are the work the GPU did: what the model read that was not already in the cache, plus
				what it wrote. An agent reads the same files again and again, and the cache serves those re-reads: counted with them, the
				tokens are about <span data-p2m-cache-times>{cacheTimes}</span> times as many (<span data-p2m-cache-share>{cacheShare}%</span> of everything read and written were re-reads).
				Hover a token count for both numbers. Two first tries in trial 2 that the gateway’s personal-data filter cut off are not in the counts.
			</li>
			<li>
				<strong>Working on now</strong> and the trials from trial 5 show each leaf’s outlines, newest first. An outline is in progress,
				refuted (one of its holes is false, or its shape was refused), proved (its holes put together passed our full check) or
				abandoned for a new outline. Each hole is proved by its own task, false (the model disproved it), closed before any task
				by the pre-pass of standard tactics, by our index of prove2me’s library (reuse) or by the ledger (proved before), or it is
				running, queued, not tried or cancelled; the holes left in the outline’s file (“in place”) share one task. A cancelled
				task says why: its outline refuted, replaced or abandoned after a hole failed, or its leaf proved. A leaf’s row counts the
				holes of its newest outline. A leaf’s tokens count every task, each outline and each try included: tokens computed as above, and the count with the cache re-reads beside
				them. Open “Every task” for each task’s result, steps, model minutes and tokens. A running task’s steps and tokens show as the gateway counts them where it can, else once the task ends.
			</li>
			<li>
				<strong>Small samples.</strong> <span data-p2m-runs-trials>{view.kpis.runs} runs in {view.kpis.lastTrial} trials</span>, each with a different scaffold, budget and set of leaves.
				They show what happened, not a success rate.
			</li>
			<li>
				<strong>These are our own measurements</strong>, from the records of each run, not estimates. The model runs on the AIs@home
				network, which today is mostly the maintainer’s own GPUs, some of them rented. The recorded history is published as
				JSON, as exported on <span data-p2m-json-asof>{day(p2m.generated_at)}</span>, its totals as of that day (the page takes
				trials 1 to {FROZEN_THROUGH} from it): <a href="/science/prove2me.json" data-p2m-json><code>/science/prove2me.json</code></a>.
				Everything else comes live from the gateway’s public records, which this page reads every minute:
				{' '}<a href="/v1/projects/prove2me/campaigns" data-p2m-records-link="campaigns"><code>campaigns</code></a>,
				{' '}<a href="/v1/projects/prove2me/results" data-p2m-records-link="results"><code>results</code></a> and
				{' '}<a href="/v1/tasks?project=prove2me" data-p2m-records-link="tasks"><code>tasks</code></a>.
				The network’s statistics (“prove2me on the network”) count prove2me on its own from 11 November 2026, trial 4 on; requests
				before then are not in them.
			</li>
		</ul>
	</details>

</StarlightPage>

<script>
	import { compareLeaves, leafFirstDir, type LeafKeys, type LeafSort, type LeafSortKey } from '../../data/prove2me-live';
	import { attachTaskTable, workText, type TaskTableRow } from '../../data/task-table';
	import { p2mTaskOptions, taskResult, type LeafInfo } from '../../data/prove2me-tasks';
	import { CURRENT_URL, day, fetchAllTasks, hhmm, parseCurrent, probeRound, refutedOutlines, taskTableRows, theoremURL, walkPages } from '../../data/prove2me-current';
	import { CAMPAIGNS_URL, RESULTS_URL, allRuns, getJSON, leavesView, parseCampaigns, parseResults, scienceView, trialDetails, type History, type Records } from '../../data/prove2me-records';
	import {
		acceptedOf, headlineStripHTML, kpisHTML, leafFiltersHTML, leafRowsHTML, leafScoreHTML, smallNumbersHTML, submissionRowsHTML, trialDetailHTML,
		trialPlainRowHTML, trialsFootHTML, trialsNewestFirst,
	} from '../../data/prove2me-view';
	import type { CurrentDoc, TasksView } from '../../data/prove2me-current';
	import { parseNodes, queueBarHTML, statusTexts, statusView, type Nodes, type StatusView } from '../../data/prove2me-status';
	import { isBenchDoc, nowAll, nowBlocksHTML } from '../../data/prove2me-now';
	import { mountAcceptedChart } from '../../data/prove2me-chart';

	// Every task: the build's rows, filtered here; every task of trial 6 on and of the outline probes from the gateway
	// replaces or joins them (trials 1 to 5 stay the build's).
	/** The submissions' scroll area: as tall as its head and first five rows, at most 85% of the window (a
	 * phone's stacked rows); the CSS height stands without this. */
	function fitSubmissions() {
		const box = document.querySelector<HTMLElement>('[data-p2m-subs-scroll]');
		if (!box) return;
		const rows = [...box.querySelectorAll<HTMLElement>('tbody > tr')];
		if (rows.length <= 5) {
			box.style.maxHeight = 'none';
			return;
		}
		box.style.maxHeight = '';
		const top = box.getBoundingClientRect().top - box.scrollTop;
		const end = rows[4].getBoundingClientRect().bottom;
		if (end > top) box.style.maxHeight = `${Math.min(Math.ceil(end - top) + 2, Math.round(window.innerHeight * 0.85))}px`;
	}
	fitSubmissions();
	// again whenever the table's size changes (the fonts arriving, live rows, a narrower window)
	const subsTable = document.querySelector('[data-p2m-subs-scroll] table');
	if (subsTable && 'ResizeObserver' in window) new ResizeObserver(() => fitSubmissions()).observe(subsTable);
	window.addEventListener('resize', fitSubmissions);
	const taskBox = document.querySelector<HTMLElement>('[data-p2m-alltasks]');
	const taskKnown = JSON.parse(document.querySelector('[data-p2m-tasks-known]')?.textContent || '{"rows":[],"leafIds":{},"leaves":{},"holes":{}}') as {
		rows: TaskTableRow[];
		leafIds: Record<string, string>;
		leaves: LeafInfo;
		holes: Record<string, string>;
	};
	let refuted = new Set<string>();
	const taskTable = taskBox ? attachTaskTable(taskBox, p2mTaskOptions(taskKnown.leaves, () => refuted), taskKnown.rows) : null;

	// "Working on now", live: every open benchmark and every trial not finished, from the gateway's records and task list
	// (the project's data document for its own trial or a newer one), on load and every minute; otherwise the build's
	// copy stays (prove2me-now.ts).
	const nowBox = document.querySelector<HTMLElement>('[data-p2m-now]');
	type Known = { reuses: Record<string, string>; theorems: Record<string, string>; titles: Record<string, string> };
	let known: Known = { reuses: {}, theorems: {}, titles: {} };
	try {
		known = JSON.parse(document.querySelector('[data-p2m-known]')?.textContent || '{}') as Known;
	} catch {}
	const el = (tag: string, cls?: string, text?: string) => {
		const e = document.createElement(tag);
		if (cls) e.className = cls;
		if (text !== undefined) e.textContent = text;
		return e;
	};
	/** The outline probes choosing the next trial's leaves, while they run and the document's trial does not. */
	const showProbes = (doc: CurrentDoc, tasks: TasksView) => {
		const box = nowBox?.querySelector<HTMLElement>('[data-now-probes]');
		if (!nowBox || !box) return;
		const round = probeRound(tasks, doc);
		box.hidden = !round;
		nowBox.dataset.probes = round?.trial ?? '';
		if (!round) return;
		const rows = taskTableRows({ updated: tasks.updated, tasks: round.tasks }, doc, taskKnown.leafIds, taskKnown.holes);
		const n = new Set(rows.map((r) => r.labels.leaf || r.labels.alias)).size;
		box.querySelector<HTMLElement>('[data-probes-head]')!.textContent = `Choosing trial ${round.forTrial}’s leaves: ${n} outline probe${n === 1 ? '' : 's'}`;
		const items = rows.map((r) => {
			const li = el('li');
			li.dataset.probe = r.id;
			li.dataset.state = r.state;
			const id = r.labels.leaf || r.labels.alias;
			const leaf = el('span', 'leaf', id);
			if (r.labels.alias && r.labels.alias !== id) leaf.title = r.labels.alias;
			li.append(leaf);
			const info = taskKnown.leaves[r.labels.leaf];
			if (info) {
				const a = el(theoremURL.test(info.url) ? 'a' : 'span', 'thm-name', info.theorem);
				if (a instanceof HTMLAnchorElement) a.href = info.url;
				li.append(' ', a);
			}
			const res = taskResult(r, rows);
			const st = el('span', `state state-${r.state}`, res.text);
			st.dataset.probeResult = '';
			li.append(st);
			const work = workText(r);
			if (r.state !== 'running' && work !== '–') li.append(el('span', 'meta', work));
			return li;
		});
		box.querySelector<HTMLElement>('[data-probes-list]')!.replaceChildren(...items);
	};

	// The headline numbers, "Small numbers", the submissions, the trials table and each trial's list from trial 6 on: the
	// build's history with the gateway's records (campaigns, results, tasks), drawn by the build's renderers.
	const recordsKnown = (() => {
		try {
			return JSON.parse(document.querySelector('[data-p2m-records-known]')?.textContent || 'null') as {
				history: History;
				model: string;
				f01Tasks: number | null;
				aliasIds: Record<string, string>;
				status: StatusView;
			} | null;
		} catch {
			return null;
		}
	})();
	// The status block: the build's until the gateway's records answer; the queue from the records,
	// the nodes from /v1/stats (each loader keeps its own newest answer and draws the block again).
	const statusBox = document.querySelector<HTMLElement>('[data-p2m-status]');
	let stLive: Records | null = null;
	let stNodes: Nodes | null = null;
	const showStatus = () => {
		if (!statusBox) return;
		const v = statusView(stLive, stNodes, recordsKnown?.status ?? null);
		if (!v) return;
		const tx = statusTexts(v);
		const set = (k: string, text: string) => {
			const e = statusBox.querySelector<HTMLElement>(`[data-st="${k}"]`);
			if (!e) return;
			e.textContent = text;
			e.hidden = !text;
		};
		set('head', tx.head);
		set('queue', tx.queue);
		set('updated', tx.updated);
		// the whole queue: a part per benchmark and per trial (its running tasks, then its waiting ones), its name under it
		const bar = queueBarHTML(v);
		statusBox.querySelector<HTMLElement>('[data-st-queue]')!.hidden = !bar.bar;
		statusBox.querySelector('[data-st-bar]')!.innerHTML = bar.bar; // escaped (prove2me-status.ts)
		statusBox.querySelector('[data-st-qlabels]')!.innerHTML = bar.labels;
		const lines = statusBox.querySelector<HTMLElement>('[data-st-trials]')!;
		lines.replaceChildren(
			...tx.lines.map((t, i) => {
				const li = el('li', '', t);
				li.dataset.trial = v.trials[i].label;
				return li;
			}),
		);
		lines.hidden = !tx.lines.length;
		for (const [k, val] of Object.entries(tx.nums)) {
			const d = statusBox.querySelector<HTMLElement>(`[data-num="${k}"]`);
			if (!d) continue;
			d.querySelector('dd')!.textContent = val;
			d.hidden = !val;
		}
		statusBox.dataset.source = v.source === 'live' ? 'live' : stNodes ? 'nodes' : 'build';
		statusBox.dataset.trials = v.trials.map((t) => t.label).join(' ');
	};
	// The chart under the headline numbers: drawn again at its real width, and with each newer read of the records.
	const acceptedChart = mountAcceptedChart(document.querySelector<HTMLElement>('[data-p2m-chart]'));
	const fromHTML = (html: string) => {
		const tpl = document.createElement('template');
		tpl.innerHTML = html; // every value escaped (prove2me-view.ts)
		return tpl.content.firstElementChild as HTMLElement;
	};
	const showRecords = (live: Records) => {
		if (!recordsKnown) return;
		const h = recordsKnown.history;
		const v = scienceView(h, live);
		acceptedChart.update(v);
		const head = document.querySelector<HTMLElement>('[data-p2m-headline]');
		if (head) {
			head.innerHTML = headlineStripHTML(v, recordsKnown.model); // escaped (prove2me-view.ts)
			head.dataset.source = 'live';
		}
		const kpis = document.querySelector<HTMLElement>('[data-p2m-kpis]');
		if (kpis) {
			const k = kpisHTML(v.kpis);
			kpis.innerHTML = k.html;
			kpis.style.setProperty('--kpis', String(k.n));
			kpis.dataset.source = 'live';
		}
		const small = document.querySelector<HTMLElement>('[data-p2m-small]');
		if (small) small.innerHTML = smallNumbersHTML(v, recordsKnown.f01Tasks ?? undefined, (a) => recordsKnown.aliasIds[a] ?? a);
		const subs = document.querySelector<HTMLElement>('[data-p2m-submissions]');
		if (subs) {
			subs.querySelector('tbody')!.innerHTML = submissionRowsHTML(v); // every value escaped (prove2me-view.ts)
			fitSubmissions();
			subs.dataset.source = 'live';
		}
		const runsTrials = document.querySelector<HTMLElement>('[data-p2m-runs-trials]');
		if (runsTrials) runsTrials.textContent = `${v.kpis.runs} runs in ${v.kpis.lastTrial} trials`;
		const share = document.querySelector<HTMLElement>('[data-p2m-cache-share]');
		if (share && v.kpis.withCache > 0) share.textContent = `${Math.round((100 * (v.kpis.withCache - v.kpis.computed)) / v.kpis.withCache)}%`;
		const times = document.querySelector<HTMLElement>('[data-p2m-cache-times]');
		if (times && v.kpis.computed > 0) times.textContent = String(Math.round(v.kpis.withCache / v.kpis.computed));
		// the submissions' paragraph and the reuse notes, made from the submissions
		showLeaves(h, live);
		// the trials, newest first: trials 1 to 5 keep the build's list; from trial 6 on each trial's list is made again from
		// the records (what is open stays open), a new trial or probe round joins in its place
		const trialsBox = document.querySelector<HTMLElement>('[data-p2m-trials]');
		const rowsBox = trialsBox?.querySelector<HTMLElement>('[data-p2m-trial-lists]');
		if (trialsBox && rowsBox) {
			const details = new Map(trialDetails([], live, h).map((d) => [d.sum.number, d]));
			const rows = trialsNewestFirst(v).map((t) => {
				if (t.probe) return fromHTML(trialPlainRowHTML(t));
				const old = rowsBox.querySelector<HTMLElement>(`:scope > [data-p2m-trial="${t.number}"]`);
				const d = details.get(t.number);
				if (!d) return old ?? fromHTML(trialPlainRowHTML(t, acceptedOf(v, t.number)));
				const fresh = fromHTML(trialDetailHTML(d)) as HTMLDetailsElement;
				if (old instanceof HTMLDetailsElement) {
					const open = new Set([...old.querySelectorAll<HTMLDetailsElement>('details[data-leaf-tasks]')].filter((x) => x.open).map((x) => x.dataset.leafTasks));
					fresh.open = old.open;
					fresh.querySelectorAll<HTMLDetailsElement>('details[data-leaf-tasks]').forEach((x) => (x.open = open.has(x.dataset.leafTasks)));
				}
				return fresh;
			});
			rowsBox.replaceChildren(...rows);
			const all = trialsBox.querySelector<HTMLElement>('[data-p2m-trials-all]');
			if (all) all.innerHTML = trialsFootHTML(v); // escaped (prove2me-view.ts)
			trialsBox.dataset.source = 'live';
		}
		openTrial();
	};
	/** Every task of trial 6 on into the task table; with the data document, its trial's leaves (their theorems, their
	 * refuted outlines) too. */
	const showTasks = (doc: CurrentDoc | null, tasks: TasksView) => {
		if (doc) {
			refuted = refutedOutlines(doc);
			for (const l of doc.leaves) {
				taskKnown.leaves[l.id] ??= { theorem: l.theorem, url: theoremURL.test(l.url) ? l.url : '' };
				taskKnown.leafIds[l.theorem] ??= l.id;
			}
		}
		taskTable?.setLive(taskTableRows(tasks, doc, taskKnown.leafIds, taskKnown.holes));
	};
	/** "Working on now": a block per open benchmark and per trial not finished (prove2me-now.ts nowAll), replaced as a
	 * whole; a leaf's task table stays open across the minute's refresh, and the next trial's outline probes sit under the
	 * newest trial's head. */
	/** Each leaf's prove2me title: the build's, and the gateway's campaigns' items. */
	const titlesOf = (live: Records | null) => {
		const t = { ...known.titles };
		for (const c of live?.campaigns ?? []) for (const i of c.items) if (i.title) t[i.id] = i.title;
		return t;
	};
	const showNow = (doc: CurrentDoc | null, live: Records | null, tasks: TasksView) => {
		const docs = nowAll(doc, live);
		if (!nowBox || !docs.length) return;
		const trialsShown = docs.filter((d) => !isBenchDoc(d));
		const newest = trialsShown[trialsShown.length - 1];
		const probes = nowBox.querySelector<HTMLElement>('[data-now-probes]')!;
		// a leaf's row and its task table stay open across the refresh
		const openable = '[data-now-trial] details:is([data-leaf-detail], [data-leaf-tasks])';
		const key = (d: HTMLDetailsElement) => `${d.closest<HTMLElement>('[data-now-trial]')?.dataset.nowTrial}|${d.dataset.leafDetail ? 'row' : 'tasks'}|${d.dataset.leafDetail ?? d.dataset.leafTasks}`;
		const opened = new Set([...nowBox.querySelectorAll<HTMLDetailsElement>(openable)].filter((d) => d.open).map(key));
		const runs = live && recordsKnown ? allRuns(recordsKnown.history, live) : [];
		const earlier = (leaf: string, n: number) => [...new Set(runs.filter((r) => r.leaf === leaf && r.trial < n).map((r) => r.trial))].sort((a, b) => a - b);
		const tpl = document.createElement('template');
		// every value escaped (prove2me-now.ts)
		tpl.innerHTML = nowBlocksHTML(docs, tasks, { theorems: known.theorems, reuses: known.reuses, titles: titlesOf(live), earlier });
		const blocks = [...tpl.content.children] as HTMLElement[];
		const asof = nowBox.querySelector<HTMLElement>('[data-now-asof]')!;
		nowBox.append(probes); // out of the old blocks before they go
		const old = [...nowBox.querySelectorAll<HTMLElement>(':scope > [data-now-trial]')];
		(old[0] ?? asof).before(...blocks);
		old.forEach((b) => b.remove());
		const home = blocks.find((b) => b.dataset.nowTrial === newest?.trial.id) ?? blocks[blocks.length - 1];
		home.querySelector('[data-now-head]')!.after(probes);
		if (newest) showProbes(newest, tasks);
		nowBox.querySelectorAll<HTMLDetailsElement>(openable).forEach((d) => (d.open = opened.has(key(d))));
		asof.hidden = false;
		const own = docs.filter((d) => d.schema !== 'campaign' && !isBenchDoc(d));
		asof.textContent = !own.length
			? `Live, updated ${hhmm(tasks.updated)}.`
			: `Live, updated ${hhmm(tasks.updated)}; the trial’s data as published ${day(own[0].updated_at, false)}, ${hhmm(own[0].updated_at)}.`;
		nowBox.dataset.source = 'live';
		nowBox.dataset.trial = docs.map((d) => d.trial.id).join(' ');
		nowBox.dataset.status = (newest ?? docs[0]).trial.status;
		markLeaf();
	};
	// "Every leaf": the scorecard, the filters and the list from the records (trials 1 to 5 the build's); the reader's
	// filter and sort stay (a filter whose value is gone falls back to all).
	let reapplyLeaves = () => {};
	const showLeaves = (h: History, live: Records) => {
		const v = leavesView(h, live);
		const card = document.querySelector<HTMLElement>('[data-p2m-scorecard]');
		if (card) {
			const sc = leafScoreHTML(v); // escaped (prove2me-view.ts)
			card.querySelector('tbody')!.innerHTML = sc.body;
			card.querySelector('tfoot')!.innerHTML = sc.foot;
			card.dataset.source = 'live';
		}
		document.querySelectorAll<HTMLElement>('[data-p2m-leaf-total]').forEach((e) => (e.textContent = String(v.all.leaves)));
		const notScored = document.querySelector<HTMLElement>('[data-p2m-not-scored]');
		if (notScored) notScored.textContent = String(v.notScored);
		const filters = document.querySelector<HTMLElement>('[data-p2m-filters]');
		if (filters) filters.innerHTML = leafFiltersHTML(v);
		const body = document.querySelector<HTMLElement>('[data-p2m-leaf-table] tbody');
		if (body) body.innerHTML = leafRowsHTML(v);
		reapplyLeaves();
	};
	const loadNow = async () => {
		if (!window.fetch) return;
		// each source on its own: the task list (every page of it) feeds the task table without the rest; with the
		// campaigns and results too, the numbers, submissions and trials; "Working on now" from the trial campaigns that
		// have not finished and the document
		const [d, ts, cs, rs] = await Promise.allSettled([
			getJSON(CURRENT_URL),
			fetchAllTasks(getJSON),
			walkPages(getJSON, CAMPAIGNS_URL, parseCampaigns),
			walkPages(getJSON, RESULTS_URL, parseResults),
		]);
		const ok = <T,>(r: PromiseSettledResult<T>) => (r.status === 'fulfilled' ? r.value : null);
		const doc = d.status === 'fulfilled' ? parseCurrent(d.value) : null;
		const tasks = ok(ts);
		if (!tasks) {
			// keep what the page shows; the status block says when its data stopped refreshing
			try {
				showStatus();
			} catch {}
			return;
		}
		const [camps, results] = [ok(cs), ok(rs)];
		const live: Records | null = camps && results ? { updated: tasks.updated, campaigns: camps.items, results: results.items, tasks } : null;
		if (live) stLive = live;
		try {
			showStatus();
		} catch {
			// keep what the block shows
		}
		try {
			showTasks(doc, tasks);
		} catch {
			// keep what the tables show
		}
		if (live) {
			try {
				showRecords(live);
			} catch {
				// keep what the page shows
			}
		}
		try {
			showNow(doc, live, tasks);
		} catch {
			// keep what the page shows
		}
	};
	// #leaf-<id> or #leaf-<alias>: that leaf's row is marked (the alias is a span inside the row)
	const markLeaf = () => {
		const li = location.hash.startsWith('#leaf-') ? document.getElementById(location.hash.slice(1))?.closest('li') : null;
		document.querySelectorAll('[data-p2m-now] li.target').forEach((x) => x !== li && x.classList.remove('target'));
		li?.classList.add('target');
		const row = li?.querySelector<HTMLDetailsElement>(':scope > details[data-leaf-detail]');
		if (row) row.open = true;
	};
	window.addEventListener('hashchange', markLeaf);
	markLeaf();
	loadNow();
	setInterval(() => document.visibilityState === 'visible' && loadNow(), 60000);

	// The network's share of the work for project prove2me, from the gateway's public /v1/stats (aggregates only).
	// Hidden until real numbers arrive and on any failure: never dashes or zeros by default.
	const box = document.querySelector<HTMLElement>('[data-p2m-live]');
	const ok = (n: unknown): n is number => typeof n === 'number' && Number.isFinite(n) && n >= 0;
	const full = new Intl.NumberFormat('en');
	const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
	const load = async () => {
		if (!box || !window.fetch) return;
		try {
			const ctl = new AbortController();
			const timer = setTimeout(() => ctl.abort(), 8000);
			const res = await fetch('/v1/stats', { signal: ctl.signal, headers: { accept: 'application/json' } });
			clearTimeout(timer);
			if (!res.ok) throw new Error(String(res.status));
			const d = await res.json();
			const nodes = parseNodes(d);
			if (nodes) {
				stNodes = nodes;
				try {
					showStatus();
				} catch {}
			}
			const all = d?.total?.projects?.prove2me;
			const today = d?.today?.projects?.prove2me ?? { requests: 0 };
			const todayAll = d?.today?.requests;
			const at = new Date(d?.updated);
			// tokens computed: the prompt tokens the model computed (its cache re-reads left out) and the ones it wrote
			const fresh = all?.uncached_prompt_tokens ?? (all?.prompt_tokens ?? NaN) - (all?.cached_tokens ?? NaN);
			const tokens = fresh + (all?.completion_tokens ?? NaN);
			if (!all || ![all.requests, tokens, all.node_seconds ?? 0, today.requests, todayAll].every(ok) || Number.isNaN(at.getTime())) throw new Error('data');
			const vals: Record<string, string> = {
				'today-requests': full.format(today.requests),
				'today-share': todayAll > 0 ? `${Math.round((100 * today.requests) / todayAll)}%` : '0%',
				requests: full.format(all.requests),
				tokens: compact.format(tokens),
				hours: (all.node_seconds / 3600).toFixed(1),
				updated: `${String(at.getUTCHours()).padStart(2, '0')}:${String(at.getUTCMinutes()).padStart(2, '0')}`,
			};
			box.querySelectorAll<HTMLElement>('[data-live]').forEach((el) => (el.textContent = vals[el.dataset.live ?? ''] ?? ''));
			box.querySelector<HTMLTimeElement>('time[data-live]')!.dateTime = at.toISOString();
			box.dataset.requests = String(all.requests);
			box.hidden = false;
		} catch {
			box.hidden = true;
		}
	};
	// A trial's link in the table (and a #trial-N address) opens that trial's list.
	const openTrial = () => {
		const d = location.hash.startsWith('#trial-') ? document.getElementById(location.hash.slice(1)) : null;
		if (d instanceof HTMLDetailsElement) d.open = true;
	};
	window.addEventListener('hashchange', openTrial);
	openTrial();

	// The table of every leaf: one role and one outcome filter, and a sort by column (▲/▼ and aria-sort on that column
	// only); before a click it keeps the build's order (first tried).
	const leafList = document.querySelector<HTMLDetailsElement>('[data-p2m-list]');
	const leafFilter = { role: '', outcome: '' };
	let leafSort: LeafSort | null = null;
	const numOrNull = (v: string | undefined) => (v === undefined || v === '' ? null : Number(v));
	const leafKeys = (r: HTMLElement): LeafKeys => ({
		leaf: r.dataset.leafId ?? '',
		theorem: r.querySelector('[data-sort-theorem]')?.textContent ?? '',
		first: Number(r.dataset.sortFirst),
		outcome: Number(r.dataset.sortOutcome),
		tokens: numOrNull(r.dataset.sortTokens),
		minutes: numOrNull(r.dataset.sortMinutes),
		order: Number(r.dataset.order),
	});
	const applyLeaves = () => {
		const body = leafList?.querySelector('[data-p2m-leaf-table] tbody');
		if (!leafList || !body) return;
		leafList.querySelectorAll<HTMLElement>('th[data-sort-col]').forEach((th) => {
			const on = !!leafSort && th.dataset.sortCol === leafSort.key;
			if (on) th.setAttribute('aria-sort', leafSort!.dir === 'asc' ? 'ascending' : 'descending');
			else th.removeAttribute('aria-sort');
			const mark = th.querySelector('.sort-mark');
			if (mark) mark.textContent = on ? (leafSort!.dir === 'asc' ? '▲' : '▼') : '';
		});
		const rows = [...body.querySelectorAll<HTMLElement>(':scope > tr')];
		const keys = new Map(rows.map((r) => [r, leafKeys(r)]));
		const sorted = [...rows].sort((a, b) => (leafSort ? compareLeaves(keys.get(a)!, keys.get(b)!, leafSort) : keys.get(a)!.order - keys.get(b)!.order));
		if (sorted.some((r, i) => r !== rows[i])) sorted.forEach((r) => body.appendChild(r));
		leafList.querySelectorAll<HTMLButtonElement>('[data-p2m-filters] [data-filter]').forEach((b) => {
			b.setAttribute('aria-pressed', String(leafFilter[b.dataset.filter as 'role' | 'outcome'] === (b.dataset.value ?? '')));
		});
		let shown = 0;
		for (const r of rows) {
			r.hidden = (!!leafFilter.role && !(r.dataset.roles ?? '').split(' ').includes(leafFilter.role)) || (!!leafFilter.outcome && r.dataset.outcome !== leafFilter.outcome);
			if (!r.hidden) shown++;
		}
		const count = leafList.querySelector('[data-p2m-list-count]');
		if (count) count.textContent = `Showing ${shown} of ${rows.length}`;
	};
	leafList?.addEventListener('click', (e) => {
		const head = (e.target as HTMLElement).closest<HTMLElement>('[data-leaf-sort]');
		if (head) {
			const key = head.dataset.leafSort as LeafSortKey;
			leafSort = { key, dir: leafSort?.key === key ? (leafSort.dir === 'asc' ? 'desc' : 'asc') : leafFirstDir(key) };
			applyLeaves();
			return;
		}
		const b = (e.target as HTMLElement).closest<HTMLElement>('[data-filter]');
		if (!b) return;
		leafFilter[b.dataset.filter as 'role' | 'outcome'] = b.dataset.value ?? '';
		applyLeaves();
	});
	reapplyLeaves = () => {
		for (const k of ['role', 'outcome'] as const)
			if (leafFilter[k] && !leafList?.querySelector(`[data-p2m-filters] [data-filter="${k}"][data-value="${leafFilter[k]}"]`)) leafFilter[k] = '';
		applyLeaves();
	};
	applyLeaves();
	load();
	setInterval(() => document.visibilityState === 'visible' && load(), 60000);
</script>

