	/* Global: the build and the browser draw parts of the page as HTML (prove2me-view.ts, prove2me-live.ts), which
	   scoped styles would miss; every class here is the page's own (p2m-, tt-) or under main. */
	.p2m-updated, .p2m-note, main :is(.caps, .sub, .meta) { color: var(--sl-color-gray-3); }
