---
// The network page: the live strip, the daily history, the network's pressure and the credit leaderboard. All read
// the gateway's public statistics (same origin: /v1/stats, /v1/stats/history, /v1/stats/pressure and /v1/stats/credit)
// and stay hidden until real numbers arrive; on any failure they hide again: never dashes,
// zeros-by-default or error text. A history chart needs at least two days with its numbers.
// Names come only from volunteers who set a username (their consent to appear); they are
// written with textContent, never as HTML.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import LiveStats from '../components/LiveStats.astro';
---

<StarlightPage
	frontmatter={{
		title: 'The network',
		description: 'Nodes online and credit earned by AIs@home volunteers, in BOINC’s unit.',
	}}
>
	<p>
		Volunteers’ GPUs earn <a href="/node/credit/">credit</a> for the answers they compute for
		other people: recognition in BOINC’s unit, not money. Only volunteers who chose a username
		are listed by name; everyone else counts in the totals.
	</p>

	<LiveStats class="net-live" />

	<section class="history not-content" data-history hidden aria-labelledby="history-title">
		<h2 id="history-title">Day by day</h2>
		<p class="history-note">Per UTC day<span data-history-range></span>; today so far.</p>
		<figure class="chart" data-chart="requests" hidden>
			<figcaption>Requests a day</figcaption>
			<ul class="legend" aria-hidden="true">
				<li><span class="swatch" style="background: var(--h-chat)"></span>Chat</li>
				<li><span class="swatch" style="background: var(--h-agent)"></span>API and agents</li>
				<li><span class="swatch" style="background: var(--h-science)"></span>Science</li>
				<li data-legend-earlier hidden><span class="swatch" style="background: var(--h-other)"></span>Before classes were counted</li>
			</ul>
			<svg role="img"></svg>
		</figure>
		<figure class="chart" data-chart="tokens" hidden>
			<figcaption>Tokens a day (prompt and answer)</figcaption>
			<ul class="legend" aria-hidden="true">
				<li><span class="swatch" style="background: var(--h-chat)"></span>Chat</li>
				<li><span class="swatch" style="background: var(--h-agent)"></span>API and agents</li>
				<li><span class="swatch" style="background: var(--h-science)"></span>Science</li>
				<li data-legend-earlier hidden><span class="swatch" style="background: var(--h-other)"></span>Before classes were counted</li>
			</ul>
			<svg role="img"></svg>
		</figure>
		<figure class="chart" data-chart="nodes" hidden>
			<figcaption>Nodes online</figcaption>
			<ul class="legend" aria-hidden="true">
				<li><span class="swatch line" style="background: var(--h-peak)"></span>Peak</li>
				<li><span class="swatch line" style="background: var(--h-avg)"></span>Average</li>
			</ul>
			<svg role="img"></svg>
		</figure>
		<details class="history-table">
			<summary>The numbers</summary>
			<div class="board-wrap">
				<table>
					<thead>
						<tr>
							<th scope="col">Day (UTC)</th>
							<th scope="col" class="num">Requests</th>
							<th scope="col" class="num">Chat</th>
							<th scope="col" class="num">API and agents</th>
							<th scope="col" class="num">Science</th>
							<th scope="col" class="num">Tokens</th>
							<th scope="col" class="num">Nodes peak</th>
							<th scope="col" class="num">Nodes average</th>
						</tr>
					</thead>
					<tbody data-history-rows></tbody>
				</table>
			</div>
		</details>
	</section>

	<section class="history pressure not-content" data-pressure hidden aria-labelledby="pressure-title">
		<h2 id="pressure-title">Pressure</h2>
		<p class="limit-line" data-pressure-line></p>
		<div class="range-picker" role="group" aria-label="Time range" data-pressure-ranges>
			<button type="button" data-range="24h">24 h</button>
			<button type="button" data-range="48h">48 h</button>
			<button type="button" data-range="7d">7 days</button>
			<button type="button" data-range="14d">14 days</button>
			<button type="button" data-range="30d">30 days</button>
			<button type="button" data-range="90d">90 days</button>
		</div>
		<p class="history-note">
			Per UTC <span data-pressure-unit>hour</span>, <span data-pressure-range></span>, as the gateway sees it: GPU
			slots on the nodes that serve (held and paused nodes left out), sampled every 10 seconds; the science runners
			report their machines every minute. Waits and times count from when a request reached the gateway. The line
			above is always the last 24 hours. Totals only, never a node, a runner or a person.
		</p>
		<figure class="chart" data-pchart="util" hidden>
			<figcaption>GPU slots busy</figcaption>
			<svg role="img"></svg>
		</figure>
		<figure class="chart" data-pchart="wait" hidden>
			<figcaption>Wait for a free slot, p95</figcaption>
			<ul class="legend" aria-hidden="true">
				<li><span class="swatch line" style="background: var(--h-chat)"></span>Chat</li>
				<li><span class="swatch line" style="background: var(--h-agent)"></span>API and agents</li>
				<li><span class="swatch line" style="background: var(--h-science)"></span>Science</li>
			</ul>
			<svg role="img"></svg>
		</figure>
		<figure class="chart" data-pchart="ttft" hidden>
			<figcaption>Time to the first token, p95</figcaption>
			<ul class="legend" aria-hidden="true">
				<li><span class="swatch line" style="background: var(--h-chat)"></span>Chat</li>
				<li><span class="swatch line" style="background: var(--h-agent)"></span>API and agents</li>
				<li><span class="swatch line" style="background: var(--h-science)"></span>Science</li>
			</ul>
			<svg role="img"></svg>
		</figure>
		<figure class="chart" data-pchart="demand" hidden>
			<figcaption>Science: demand and the slots it may use</figcaption>
			<ul class="legend" aria-hidden="true">
				<li><span class="swatch line" style="background: var(--h-avg)"></span>Demand (open tasks those slots could run)</li>
				<li><span class="swatch line" style="background: var(--h-peak)"></span>Slots science may use</li>
			</ul>
			<svg role="img"></svg>
		</figure>
		<figure class="chart" data-pchart="runner" hidden>
			<figcaption>Science runners: CPU and memory</figcaption>
			<ul class="legend" aria-hidden="true">
				<li><span class="swatch line" style="background: var(--h-peak)"></span>CPU busy</li>
				<li><span class="swatch line" style="background: var(--h-avg)"></span>Memory used by programs</li>
				<li><span class="swatch line" style="background: var(--h-science)"></span>Memory caching files (Lean's library)</li>
			</ul>
			<svg role="img"></svg>
		</figure>
		<figure class="chart" data-pchart="lean" hidden>
			<figcaption>Lean checks on the runners, p95</figcaption>
			<ul class="legend" aria-hidden="true">
				<li><span class="swatch line" style="background: var(--h-peak)"></span>Run time</li>
				<li><span class="swatch line" style="background: var(--h-avg)"></span>Wait for a build slot</li>
			</ul>
			<svg role="img"></svg>
		</figure>
		<figure class="chart" data-pchart="node" hidden>
			<figcaption>Nodes: time reading prompts, and prompt-cache hits</figcaption>
			<ul class="legend" aria-hidden="true">
				<li><span class="swatch line" style="background: var(--h-avg)"></span>Share of node time reading the prompt</li>
				<li><span class="swatch line" style="background: var(--h-science)"></span>Prompt tokens from the cache</li>
			</ul>
			<svg role="img"></svg>
		</figure>
		<details class="history-table" data-pressure-table hidden>
			<summary>The numbers</summary>
			<div class="board-wrap">
				<table>
					<thead>
						<tr>
							<th scope="col" data-pressure-th>Hour (UTC)</th>
							<th scope="col" class="num">Slots</th>
							<th scope="col" class="num">Busy</th>
							<th scope="col" class="num">Waiting, peak</th>
							<th scope="col" class="num">Wait p95</th>
							<th scope="col" class="num">First token p95</th>
							<th scope="col" class="num">Demand</th>
							<th scope="col" class="num">Requests</th>
							<th scope="col" class="num">Refused</th>
							<th scope="col" class="num">Runner CPU</th>
							<th scope="col" class="num">Files cached</th>
							<th scope="col" class="num">Lean wait p95</th>
							<th scope="col" class="num">Cache hits</th>
						</tr>
					</thead>
					<tbody data-pressure-rows></tbody>
				</table>
			</div>
		</details>
		<p class="history-note">Updated <time data-pressure-updated></time> UTC.</p>
	</section>

	<section class="board not-content" data-credit-board hidden aria-labelledby="board-title">
		<dl class="board-sums">
			<div><dt>Credit in total</dt><dd data-sum="total"></dd></div>
			<div><dt>Credit today (UTC)</dt><dd data-sum="today"></dd></div>
			<div><dt>Volunteers with credit</dt><dd data-sum="volunteers"></dd></div>
			<div><dt>Nodes with credit</dt><dd data-sum="nodes"></dd></div>
		</dl>
		<h2 id="board-title">Top volunteers</h2>
		<div class="board-wrap">
			<table>
				<thead>
					<tr>
						<th scope="col">#</th>
						<th scope="col">Volunteer</th>
						<th scope="col" class="num">Credit</th>
						<th scope="col" class="num">Today</th>
						<th scope="col" class="num">Recent average a day</th>
						<th scope="col" class="num">Nodes</th>
					</tr>
				</thead>
				<tbody data-rows></tbody>
			</table>
		</div>
		<p class="board-empty" data-empty hidden>No volunteer has chosen a username yet.</p>
		<p class="board-note" data-anon hidden></p>
		<p class="board-note" data-maint hidden></p>
		<ul class="board-note" data-corrections hidden></ul>
		<p class="board-note">Updated <time data-updated></time> UTC.</p>
	</section>

	<h2>Statistics files</h2>
	<p>
		The same credit is published in BOINC’s statistics format at
		<a href="/stats/"><code>/stats/</code></a> (<code>tables.xml</code>, <code>user.gz</code>,
		<code>host.gz</code>, <code>team.gz</code>), rebuilt at most once an hour, with named volunteers
		only. There are no cross-project ids (CPIDs) yet, so Gridcoin cannot use it.
	</p>
</StarlightPage>

<script is:inline>
	(() => {
		// Daily history: three small charts (inline SVG) and a table, from /v1/stats/history.
		const box = document.querySelector('[data-history]');
		if (!box || !window.fetch) return;
		const SHOW = 90; // days on the charts; the table has the same days
		const H = 200, L = 44, R = 8, T = 10, B = 24; // plot area inside the viewBox; its width is the chart's own
		let W = 640;
		const NS = 'http://www.w3.org/2000/svg';
		const compact = new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 });
		const full = new Intl.NumberFormat('en', { maximumFractionDigits: 1 });
		const ok = (n) => typeof n === 'number' && Number.isFinite(n) && n >= 0;
		const hide = () => (box.hidden = true);
		const el = (name, attrs, parent) => {
			const e = document.createElementNS(NS, name);
			for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
			if (parent) parent.append(e);
			return e;
		};
		const title = (parent, text) => (el('title', {}, parent).textContent = text);
		const nice = (max) => { // a round top for the axis, just above the highest value
			if (max <= 0) return 1;
			const p = 10 ** Math.floor(Math.log10(max));
			return [1, 1.5, 2, 3, 4, 5, 6, 8, 10].map((m) => m * p).find((v) => v >= max);
		};
		// Axes: gridlines at 0, half and the top, the first and last day under the plot.
		const frame = (svg, days, top, label) => {
			svg.replaceChildren();
			W = Math.max(Math.round(svg.getBoundingClientRect().width), 240); // drawn at its size: text is never stretched
			svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
			svg.setAttribute('aria-label', label);
			for (const f of [0, 0.5, 1]) {
				const y = T + (H - T - B) * (1 - f);
				el('line', { x1: L, x2: W - R, y1: y, y2: y, class: f ? 'grid' : 'base' }, svg);
				el('text', { x: L - 6, y: y + 4, class: 'tick', 'text-anchor': 'end' }, svg).textContent = compact.format(top * f);
			}
			el('text', { x: L, y: H - 6, class: 'tick' }, svg).textContent = days[0].date;
			el('text', { x: W - R, y: H - 6, class: 'tick', 'text-anchor': 'end' }, svg).textContent = days[days.length - 1].date;
		};
		const yOf = (v, top) => T + (H - T - B) * (1 - v / top);
		// Bars: one per day, stacked by series bottom to top, 2px apart.
		const bars = (fig, days, series, label) => {
			const svg = fig.querySelector('svg');
			const totals = days.map((d) => series.reduce((s, k) => s + d.parts[k], 0));
			const top = nice(Math.max(...totals));
			frame(svg, days, top, label);
			const step = (W - L - R) / days.length, w = Math.max(step - 2, 1);
			days.forEach((d, i) => {
				const g = el('g', { class: 'day' }, svg);
				let base = 0;
				for (const k of series) {
					const v = d.parts[k];
					if (v <= 0) continue;
					const y0 = yOf(base, top), y1 = yOf(base + v, top);
					el('rect', { x: L + i * step + 1, y: y1, width: w, height: Math.max(y0 - y1 - (base > 0 ? 1 : 0), 0.5), class: 'bar s-' + k }, g);
					base += v;
				}
				el('rect', { x: L + i * step, y: T, width: step, height: H - T - B, class: 'hit' }, g); // a hover target the height of the plot
				title(g, d.tip);
			});
		};
		const lines = (fig, days, series, label) => {
			const svg = fig.querySelector('svg');
			const top = nice(Math.max(...days.flatMap((d) => series.map((k) => d.parts[k]))));
			frame(svg, days, top, label);
			const step = (W - L - R) / days.length;
			const x = (i) => L + step * (i + 0.5);
			for (const k of series) {
				el('polyline', { points: days.map((d, i) => `${x(i)},${yOf(d.parts[k], top)}`).join(' '), class: 'line s-' + k }, svg);
			}
			days.forEach((d, i) => {
				const g = el('g', { class: 'day' }, svg);
				for (const k of series) el('circle', { cx: x(i), cy: yOf(d.parts[k], top), r: 4, class: 'dot s-' + k }, g);
				el('rect', { x: L + i * step, y: T, width: step, height: H - T - B, class: 'hit' }, g);
				title(g, d.tip);
			});
		};
		const show = (name, on) => (box.querySelector(`[data-chart="${name}"]`).hidden = !on);
		let last = null; // the last good answer, redrawn when the width changes
		const load = async () => {
			try {
				const ctl = new AbortController();
				const timer = setTimeout(() => ctl.abort(), 8000);
				const res = await fetch('/v1/stats/history', { signal: ctl.signal, headers: { accept: 'application/json' } });
				clearTimeout(timer);
				if (!res.ok) return hide();
				draw(await res.json());
			} catch {
				hide();
			}
		};
		const draw = (d) => {
			try {
				if (!Array.isArray(d?.days)) return hide();
				const days = d.days
					.filter((x) => typeof x?.date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(x.date) &&
						[x.requests, x.prompt_tokens, x.completion_tokens].every(ok))
					.slice(-SHOW);
				const cls = (x, k) => (ok(x.classes?.[k]?.requests) ? x.classes[k].requests : 0);
				const req = days.map((x) => {
					const parts = { chat: cls(x, 'chat'), agent: cls(x, 'agent'), science: cls(x, 'science') };
					parts.other = Math.max(x.requests - parts.chat - parts.agent - parts.science, 0);
					const tip = `${x.date}: ${full.format(x.requests)} requests` + (x.classes ? ` (chat ${full.format(parts.chat)}, API and agents ${full.format(parts.agent)}, science ${full.format(parts.science)})` : '');
					return { date: x.date, parts, tip };
				});
				const clsTok = (x, k) => {
					const c = x.classes?.[k];
					return ok(c?.prompt_tokens) && ok(c?.completion_tokens) ? c.prompt_tokens + c.completion_tokens : 0;
				};
				const tok = days.map((x) => {
					const n = x.prompt_tokens + x.completion_tokens;
					const parts = { chat: clsTok(x, 'chat'), agent: clsTok(x, 'agent'), science: clsTok(x, 'science') };
					parts.other = Math.max(n - parts.chat - parts.agent - parts.science, 0);
					const tip = `${x.date}: ${full.format(n)} tokens` + (x.classes ? ` (chat ${full.format(parts.chat)}, API and agents ${full.format(parts.agent)}, science ${full.format(parts.science)})` : '');
					return { date: x.date, parts, tip };
				});
				const nodes = days.filter((x) => ok(x.nodes_peak) && ok(x.nodes_avg)).map((x) => ({
					date: x.date, parts: { peak: x.nodes_peak, avg: x.nodes_avg },
					tip: `${x.date}: peak ${full.format(x.nodes_peak)}, average ${full.format(x.nodes_avg)} nodes online`,
				}));
				const range = (xs) => `${xs.length} days, ${xs[0].date} to ${xs[xs.length - 1].date}`;
				const hasReq = req.length >= 2 && req.some((x) => x.parts.chat + x.parts.agent + x.parts.science + x.parts.other > 0);
				const hasTok = tok.length >= 2 && tok.some((x) => x.parts.chat + x.parts.agent + x.parts.science + x.parts.other > 0);
				const hasNodes = nodes.length >= 2;
				if (!hasReq && !hasTok && !hasNodes) return hide();
				box.hidden = false; // shown before drawing: the charts are drawn at their width
				show('requests', hasReq);
				show('tokens', hasTok);
				show('nodes', hasNodes);
				// Requests and tokens stack the same classes, in the same order and colours.
				const split = (name, rows, label) => {
					const fig = box.querySelector(`[data-chart="${name}"]`);
					bars(fig, rows, ['other', 'chat', 'agent', 'science'], label);
					fig.querySelector('[data-legend-earlier]').hidden = !rows.some((x) => x.parts.other > 0);
				};
				if (hasReq) split('requests', req, `Requests a day, ${range(req)}`);
				if (hasTok) split('tokens', tok, `Tokens a day, ${range(tok)}`);
				if (hasNodes) lines(box.querySelector('[data-chart="nodes"]'), nodes, ['peak', 'avg'], `Nodes online, peak and average, ${range(nodes)}`);
				box.querySelector('[data-history-range]').textContent = `, the last ${range(days)}`;
				const cell = (v) => (ok(v) ? full.format(v) : '');
				box.querySelector('[data-history-rows]').replaceChildren(
					...days.slice().reverse().map((x, i) => {
						const tr = document.createElement('tr');
						const r = req[days.length - 1 - i].parts;
						const vals = [x.date, x.requests, x.classes ? r.chat : null, x.classes ? r.agent : null, x.classes ? r.science : null,
							x.prompt_tokens + x.completion_tokens, x.nodes_peak, x.nodes_avg];
						vals.forEach((v, j) => {
							const td = document.createElement(j === 0 ? 'th' : 'td');
							if (j === 0) td.scope = 'row';
							else td.className = 'num';
							td.textContent = j === 0 ? v : cell(v);
							tr.append(td);
						});
						return tr;
					}),
				);
				last = d;
			} catch {
				hide();
			}
		};
		load();
		setInterval(() => document.visibilityState === 'visible' && load(), 300000);
		let resized;
		window.addEventListener('resize', () => {
			clearTimeout(resized);
			resized = setTimeout(() => last && draw(last), 200);
		});
	})();
</script>

<script>
	// Pressure: how full the network was, per hour or day, from /v1/stats/pressure (gateway pressure.go), with one line
	// on what limits it now (GPU slots or the science runners). Hidden until real numbers arrive, and again on any
	// failure, like the sections above. The range buttons pick the endpoint's range (?range= in the address keeps it).
	import {
		CLASSES, CLASS_LABEL, DEFAULT_RANGE, bucketLabel, fmtDuration, isRange, limitLine, onGrid, parsePressure, rangeWords,
		type Bucket, type PressureView, type Range,
	} from '../data/pressure';
	import { barChart, lineChart, type Point } from '../data/pressure-chart';

	const box = document.querySelector<HTMLElement>('[data-pressure]');
	const full = new Intl.NumberFormat('en', { maximumFractionDigits: 1 });
	const pct = (v: number) => `${Math.round(v * 100)}%`;
	const secs = (v: number) => (v <= 0 ? '0' : v < 60 ? `${full.format(v)} s` : v < 3600 ? `${full.format(v / 60)} min` : `${full.format(v / 3600)} h`);
	const hide = () => box && (box.hidden = true);
	let last: PressureView | null = null;
	let range: Range = DEFAULT_RANGE;
	try {
		const q = new URLSearchParams(location.search).get('range');
		if (isRange(q)) range = q;
	} catch {
		// no address to read: the default range
	}

	const fig = (name: string) => box!.querySelector<HTMLElement>(`[data-pchart="${name}"]`)!;
	const svgOf = (name: string) => fig(name).querySelector('svg') as SVGSVGElement;
	const p95 = (b: Bucket | null, kind: 'wait' | 'firstToken', k: (typeof CLASSES)[number]) => b?.[kind][k]?.p95 ?? null;
	const requests = (b: Bucket) => Object.values(b.outcomes).reduce((a, n) => a + n, 0);

	const draw = (v: PressureView) => {
		if (!box) return;
		const line = limitLine(v.last24h);
		if (!line) return hide();
		box.querySelector('[data-pressure-line]')!.textContent = line;
		const grid = onGrid(v.buckets, v.bucket);
		const n = grid.length;
		const unit = v.bucket;
		box.querySelector('[data-pressure-unit]')!.textContent = unit;
		box.querySelector('[data-pressure-range]')!.textContent = rangeWords(unit, n);
		box.querySelector('[data-pressure-th]')!.textContent = unit === 'hour' ? 'Hour (UTC)' : 'Day (UTC)';
		for (const btn of box.querySelectorAll<HTMLButtonElement>('[data-range]')) btn.setAttribute('aria-pressed', String(btn.dataset.range === v.range));
		const t = box.querySelector<HTMLTimeElement>('[data-pressure-updated]')!;
		t.textContent = `${String(v.updated.getUTCHours()).padStart(2, '0')}:${String(v.updated.getUTCMinutes()).padStart(2, '0')}`;
		t.dateTime = v.updated.toISOString();
		box.hidden = false; // shown before drawing: the charts are drawn at their width
		const enough = n >= 2; // a chart needs two buckets; with less, the line says it all
		const label = (s: string) => bucketLabel(s);
		const per = `per ${unit}, ${rangeWords(unit, n)}`;
		const show = (name: string, on: boolean) => {
			fig(name).hidden = !on;
			return on;
		};

		const util: Point[] = grid.map(({ start, b }) => ({
			label: label(start), values: { util: b?.utilisation ?? null },
			tip: b && b.utilisation !== null
				? `${label(start)}: ${pct(b.utilisation)} busy (${full.format(b.busy.avg)} of ${full.format(b.slots.avg)} slots on average, peak ${b.busy.peak} busy); waiting, peak ${b.queue.people.peak} people's and ${b.queue.science.peak} science requests`
				: `${label(start)}: no slots online`,
		}));
		if (show('util', enough && util.some((p) => p.values.util !== null))) barChart(svgOf('util'), util, 'util', pct, `GPU slots busy ${per}`, 1);

		const byClass = (kind: 'wait' | 'firstToken', what: string): Point[] => grid.map(({ start, b }) => {
			const parts = CLASSES.filter((k) => p95(b, kind, k) !== null).map((k) => `${CLASS_LABEL[k]} ${fmtDuration(p95(b, kind, k)!)} (${b![kind][k]!.count})`);
			return {
				label: label(start), values: Object.fromEntries(CLASSES.map((k) => [k, p95(b, kind, k)])),
				tip: `${label(start)}: ${what} p95 ${parts.length ? parts.join(', ') : 'no requests'}`,
			};
		});
		for (const [name, kind, what] of [['wait', 'wait', 'wait for a slot'], ['ttft', 'firstToken', 'first token']] as const) {
			const pts = byClass(kind, what);
			if (show(name, enough && pts.some((p) => CLASSES.some((k) => p.values[k] !== null)))) {
				lineChart(svgOf(name), pts, [...CLASSES], secs, `${what}, p95 by class ${per}`);
			}
		}

		const dem: Point[] = grid.map(({ start, b }) => ({
			label: label(start), values: { demand: b ? b.demand.avg : null, sslots: b ? b.scienceSlots.avg : null },
			tip: b ? `${label(start)}: demand ${full.format(b.demand.avg)} on average (peak ${b.demand.peak}), ${full.format(b.openTasks.avg)} open tasks, ${full.format(b.scienceSlots.avg)} slots science may use`
				: `${label(start)}: no data`,
		}));
		if (show('demand', enough && grid.some(({ b }) => b && (b.scienceSlots.peak > 0 || b.openTasks.peak > 0)))) {
			lineChart(svgOf('demand'), dem, ['demand', 'sslots'], (x) => full.format(x), `Science demand and slots ${per}`);
		}

		// The runners: CPU busy and memory as shares of the machine (programs' own memory, and files cached: Lean's
		// library must stay cached for quick checks).
		const run: Point[] = grid.map(({ start, b }) => {
			const r = b?.runner;
			const tot = r && r.memTotalGb > 0 ? r.memTotalGb : null;
			return {
				label: label(start),
				values: { cpu: r ? r.cpu.avg : null, mem: r && tot ? Math.min(r.memPrivateGb.avg / tot, 1) : null, cache: r && tot ? Math.min(r.pageCacheGb.avg / tot, 1) : null },
				tip: r ? `${label(start)}: CPU ${pct(r.cpu.avg)} busy (peak ${pct(r.cpu.peak)}); programs ${full.format(r.memPrivateGb.avg)} GB (peak ${full.format(r.memPrivateGb.peak)}), files cached ${full.format(r.pageCacheGb.avg)} GB (low ${full.format(r.pageCacheGb.low)}) of ${full.format(r.memTotalGb)} GB; ${full.format(r.refaultsS.avg)} pages/s re-read from disk; ${full.format(b!.runners?.avg ?? 0)} runners, ${full.format(r.sessions.avg)} sessions on average${r.spotNotices ? `; ${r.spotNotices} spot interruption${r.spotNotices === 1 ? '' : 's'}` : ''}`
					: `${label(start)}: no runner reported`,
			};
		});
		if (show('runner', enough && run.some((p) => p.values.cpu !== null))) lineChart(svgOf('runner'), run, ['cpu', 'mem', 'cache'], pct, `Science runners' CPU and memory ${per}`, 1);

		const lean: Point[] = grid.map(({ start, b }) => {
			const l = b?.runner?.lean;
			return {
				label: label(start), values: { leanrun: l?.run?.p95 ?? null, leanwait: l?.wait?.p95 ?? null },
				tip: l ? `${label(start)}: Lean run p95 ${l.run ? fmtDuration(l.run.p95) : 'none'} (${l.run?.count ?? 0} runs), wait for a slot p95 ${l.wait ? fmtDuration(l.wait.p95) : 'none'}; ${full.format(l.busy.avg)} of ${full.format(l.slots)} slots busy on average, peak ${full.format(l.waiting.peak)} waiting`
					: `${label(start)}: no runner reported`,
			};
		});
		if (show('lean', enough && lean.some((p) => p.values.leanrun !== null || p.values.leanwait !== null))) {
			lineChart(svgOf('lean'), lean, ['leanrun', 'leanwait'], secs, `Lean checks, run time and wait for a slot, p95 ${per}`);
		}

		const nodes: Point[] = grid.map(({ start, b }) => {
			const nd = b?.node;
			return {
				label: label(start), values: { prefill: nd?.prefillShare ?? null, hits: nd?.cacheHit ?? null },
				tip: nd ? `${label(start)}: ${nd.prefillShare === null ? '' : `${pct(nd.prefillShare)} of node time reading prompts, `}${nd.cacheHit === null ? '' : `${pct(nd.cacheHit)} of prompt tokens from the cache, `}${nd.decodeTokS === null ? '' : `${full.format(nd.decodeTokS)} tokens/s written per answer, `}${nd.requests.toLocaleString('en')} answers`
					: `${label(start)}: no answers`,
			};
		});
		if (show('node', enough && nodes.some((p) => p.values.prefill !== null || p.values.hits !== null))) {
			lineChart(svgOf('node'), nodes, ['prefill', 'hits'], pct, `Nodes' prompt time and cache hits ${per}`, 1);
		}

		const rows = grid.filter((g) => g.b).reverse();
		const table = box.querySelector<HTMLElement>('[data-pressure-table]')!;
		table.hidden = rows.length === 0;
		const worst = (b: Bucket, kind: 'wait' | 'firstToken') => {
			const xs = CLASSES.map((k) => p95(b, kind, k)).filter((x): x is number => x !== null);
			return xs.length ? fmtDuration(Math.max(...xs)) : '';
		};
		box.querySelector('[data-pressure-rows]')!.replaceChildren(...rows.map(({ start, b }) => {
			const tr = document.createElement('tr');
			const r = b!.runner, nd = b!.node;
			const vals = [start.replace('T', ' ').replace(':00Z', ':00'), full.format(b!.slots.avg), b!.utilisation === null ? '' : pct(b!.utilisation),
				String(b!.queue.all.peak), worst(b!, 'wait'), worst(b!, 'firstToken'), full.format(b!.demand.avg),
				String(requests(b!)), String(b!.outcomes.refused ?? 0), r ? pct(r.cpu.avg) : '', r ? `${full.format(r.pageCacheGb.avg)} GB` : '',
				r?.lean.wait ? fmtDuration(r.lean.wait.p95) : '', nd?.cacheHit != null ? pct(nd.cacheHit) : ''];
			vals.forEach((text, j) => {
				const td = document.createElement(j === 0 ? 'th' : 'td');
				if (j === 0) (td as HTMLTableCellElement).scope = 'row';
				else td.className = 'num';
				td.textContent = text;
				tr.append(td);
			});
			return tr;
		}));
		last = v;
	};

	let loading = 0;
	const setRange = (r: Range) => {
		range = r;
		try {
			const u = new URL(location.href);
			if (r === DEFAULT_RANGE) u.searchParams.delete('range');
			else u.searchParams.set('range', r);
			history.replaceState(history.state, '', u);
		} catch {
			// the address stays as it was
		}
	};
	const load = async () => {
		if (!box || !window.fetch) return;
		const mine = ++loading; // a slower answer for an earlier range never replaces a newer one
		// A newly picked range that fails goes back to the one shown (the buttons stay usable); the shown range failing
		// hides the section, as everywhere on the page.
		const fail = () => {
			if (mine !== loading) return;
			if (!last || last.range === range) return hide();
			setRange(last.range);
			draw(last);
		};
		try {
			const ctl = new AbortController();
			const timer = setTimeout(() => ctl.abort(), 8000);
			const res = await fetch(`/v1/stats/pressure?range=${range}`, { signal: ctl.signal, headers: { accept: 'application/json' } });
			clearTimeout(timer);
			if (mine !== loading) return;
			if (!res.ok) return fail();
			const v = parsePressure(await res.json());
			if (mine !== loading) return;
			if (!v) return fail();
			draw(v);
		} catch {
			fail();
		}
	};
	box?.querySelector('[data-pressure-ranges]')?.addEventListener('click', (e) => {
		const btn = (e.target as Element).closest<HTMLButtonElement>('[data-range]');
		if (!btn || !isRange(btn.dataset.range) || btn.dataset.range === range) return;
		setRange(btn.dataset.range);
		for (const b of box.querySelectorAll<HTMLButtonElement>('[data-range]')) b.setAttribute('aria-pressed', String(b === btn));
		load();
	});
	load();
	setInterval(() => document.visibilityState === 'visible' && load(), 300000);
	let resized: ReturnType<typeof setTimeout> | undefined;
	window.addEventListener('resize', () => {
		clearTimeout(resized);
		resized = setTimeout(() => {
			try {
				if (last) draw(last);
			} catch {
				hide();
			}
		}, 200);
	});
</script>

<script is:inline>
	(() => {
		const box = document.querySelector('[data-credit-board]');
		if (!box || !window.fetch) return;
		const num = new Intl.NumberFormat('en', { maximumFractionDigits: 0 });
		const small = new Intl.NumberFormat('en', { maximumFractionDigits: 1 });
		const fmt = (n) => (n < 100 ? small : num).format(n);
		const exact = new Intl.NumberFormat('en', { maximumFractionDigits: 3 }); // corrections: as recorded
		const ok = (n) => typeof n === 'number' && Number.isFinite(n) && n >= 0;
		const hide = () => (box.hidden = true);
		const load = async () => {
			try {
				const ctl = new AbortController();
				const timer = setTimeout(() => ctl.abort(), 8000);
				const res = await fetch('/v1/stats/credit', { signal: ctl.signal, headers: { accept: 'application/json' } });
				clearTimeout(timer);
				if (!res.ok) return hide();
				const d = await res.json();
				const at = new Date(d?.updated);
				const sums = { total: d?.total?.credit, today: d?.total?.today, volunteers: d?.volunteers?.count, nodes: d?.nodes?.with_credit };
				if (!Object.values(sums).every(ok) || !Array.isArray(d?.top) || Number.isNaN(at.getTime())) return hide();
				const rows = d.top.filter((r) => typeof r?.name === 'string' && [r.rank, r.total_credit, r.today, r.recent_average, r.nodes].every(ok));
				box.querySelectorAll('[data-sum]').forEach((el) => {
					el.textContent = fmt(sums[el.dataset.sum]);
					el.style.setProperty('--fit', `${Math.min(20, 180 / Math.max(1, el.textContent.length))}cqi`);
				});
				const body = box.querySelector('[data-rows]');
				body.replaceChildren(
					...rows.map((r) => {
						const tr = document.createElement('tr');
						[r.rank, r.name, fmt(r.total_credit), fmt(r.today), fmt(r.recent_average), r.nodes].forEach((v, i) => {
							const td = document.createElement(i === 1 ? 'th' : 'td');
							if (i === 1) td.scope = 'row';
							if (i > 1) td.className = 'num';
							td.textContent = String(v);
							tr.append(td);
						});
						return tr;
					}),
				);
				box.querySelector('table').hidden = rows.length === 0;
				box.querySelector('[data-empty]').hidden = rows.length > 0;
				const anon = box.querySelector('[data-anon]');
				const a = d?.anonymous;
				anon.hidden = !(ok(a?.count) && a.count > 0 && ok(a?.credit));
				if (!anon.hidden) anon.textContent = `${num.format(a.count)} anonymous volunteer${a.count === 1 ? '' : 's'}: ${fmt(a.credit)} credit.`;
				const maint = box.querySelector('[data-maint]');
				const m = d?.maintainer;
				maint.hidden = !(ok(m?.credit) && m.credit > 0 && ok(m?.nodes));
				if (!maint.hidden) maint.textContent = `The maintainer’s own nodes: ${fmt(m.credit)} credit (in the totals, not in the list).`;
				const corr = box.querySelector('[data-corrections]');
				const cs = (Array.isArray(d?.corrections) ? d.corrections : []).filter(
					(c) => typeof c?.credit === 'number' && Number.isFinite(c.credit) && typeof c?.reason === 'string' && !Number.isNaN(new Date(c?.time).getTime()),
				);
				corr.replaceChildren(
					...cs.map((c) => {
						const li = document.createElement('li');
						const sign = c.credit < 0 ? '−' : '+';
						li.textContent = `Correction ${new Date(c.time).toISOString().slice(0, 10)}: ${sign}${exact.format(Math.abs(c.credit))} credit (${c.reason}), in the totals.`;
						return li;
					}),
				);
				corr.hidden = cs.length === 0;
				const t = box.querySelector('[data-updated]');
				t.textContent = `${String(at.getUTCHours()).padStart(2, '0')}:${String(at.getUTCMinutes()).padStart(2, '0')}`;
				t.dateTime = at.toISOString();
				box.hidden = false;
			} catch {
				hide();
			}
		};
		load();
		setInterval(() => document.visibilityState === 'visible' && load(), 60000);
	})();
</script>

<style>
	.history[hidden], .history .chart[hidden], .history [data-legend-earlier][hidden] { display: none !important; }
	/* Series colours: the data-viz reference palette (blue, orange, aqua), validated for both
	   themes; "before classes were counted" is a neutral, not a fourth hue. */
	.history {
		--h-chat: #3987e5; --h-agent: #d95926; --h-science: #199e70; --h-other: #8a7d70;
		--h-peak: #3987e5; --h-avg: #d95926;
		margin-block: 2rem;
	}
	:global(:root[data-theme='light']) .history {
		--h-chat: #2a78d6; --h-agent: #eb6834; --h-science: #1baf7a; --h-other: #a99d91;
		--h-peak: #2a78d6; --h-avg: #eb6834;
	}
	.history h2 { font-family: var(--font-display); text-transform: uppercase; color: var(--sl-color-white); margin: 0 0 0.25rem; }
	.history-note { margin: 0 0 1rem; font-size: 0.9rem; color: var(--sl-color-gray-3); }
	.chart { margin: 0 0 1.5rem; }
	.chart figcaption { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sl-color-gray-3); margin-bottom: 0.4rem; }
	.chart svg { display: block; width: 100%; height: 12rem; overflow: visible; }
	.legend { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; margin: 0 0 0.5rem; padding: 0; list-style: none; font-size: 0.85rem; color: var(--sl-color-gray-2); }
	.legend li { display: flex; align-items: center; gap: 0.4rem; margin: 0; }
	.swatch { width: 0.75rem; height: 0.75rem; border-radius: 2px; }
	.swatch.line { height: 2px; width: 1rem; }
	.chart :global(.grid) { stroke: var(--sl-color-gray-5); stroke-width: 1; vector-effect: non-scaling-stroke; }
	.chart :global(.base) { stroke: var(--sl-color-gray-4); stroke-width: 1; vector-effect: non-scaling-stroke; }
	.chart :global(.tick) { fill: var(--sl-color-gray-3); font-size: 11px; font-variant-numeric: tabular-nums; }
	.chart :global(.s-chat) { fill: var(--h-chat); }
	.chart :global(.s-agent) { fill: var(--h-agent); }
	.chart :global(.s-science) { fill: var(--h-science); }
	.chart :global(.s-other) { fill: var(--h-other); }
	.chart :global(.line) { fill: none; stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
	.chart :global(.line.s-peak) { stroke: var(--h-peak); }
	.chart :global(.line.s-avg) { stroke: var(--h-avg); }
	.chart :global(.dot) { stroke: var(--sl-color-black); stroke-width: 2; vector-effect: non-scaling-stroke; opacity: 0; }
	.chart :global(.dot.s-peak) { fill: var(--h-peak); }
	.chart :global(.dot.s-avg) { fill: var(--h-avg); }
	.chart :global(.hit) { fill: transparent; }
	.chart :global(.day:hover .bar) { opacity: 0.8; }
	.chart :global(.day:hover .dot) { opacity: 1; }
	.history-table summary { cursor: pointer; font-size: 0.9rem; color: var(--sl-color-gray-2); }
	.history-table table { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin-top: 0.5rem; }
	.history-table :global(:is(th, td)) { padding: 0.35rem 0.75rem 0.35rem 0; border-bottom: 1px solid var(--sl-color-gray-5); text-align: left; white-space: nowrap; }
	.history-table thead th { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--sl-color-gray-3); }
	.history-table :global(.num) { text-align: right; font-variant-numeric: tabular-nums; }
	.pressure[hidden], .pressure .chart[hidden], .pressure details[hidden] { display: none !important; }
	.limit-line { margin: 0 0 0.5rem; font-size: 1.05rem; font-weight: 600; color: var(--sl-color-white); }
	.chart :global(.s-util) { fill: var(--h-peak); }
	.chart :global(.line.s-chat) { stroke: var(--h-chat); }
	.chart :global(.line.s-agent) { stroke: var(--h-agent); }
	.chart :global(.line.s-science) { stroke: var(--h-science); }
	.chart :global(.line.s-demand) { stroke: var(--h-avg); }
	.chart :global(.line:is(.s-cpu, .s-leanrun)) { stroke: var(--h-peak); }
	.chart :global(.line:is(.s-mem, .s-leanwait, .s-prefill)) { stroke: var(--h-avg); }
	.chart :global(.line:is(.s-cache, .s-hits)) { stroke: var(--h-science); }
	.chart :global(:is(.dot, .point):is(.s-cpu, .s-leanrun)) { fill: var(--h-peak); }
	.chart :global(:is(.dot, .point):is(.s-mem, .s-leanwait, .s-prefill)) { fill: var(--h-avg); }
	.chart :global(:is(.dot, .point):is(.s-cache, .s-hits)) { fill: var(--h-science); }
	.range-picker { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 0.75rem; }
	.range-picker button {
		font: inherit; font-size: 0.85rem; padding: 0.3rem 0.7rem; border-radius: 999px; cursor: pointer;
		border: 1px solid var(--sl-color-gray-4); background: transparent; color: var(--sl-color-gray-2);
	}
	.range-picker button:hover { border-color: var(--sl-color-gray-2); color: var(--sl-color-white); }
	.range-picker button[aria-pressed='true'] { background: var(--sl-color-text-accent); border-color: var(--sl-color-text-accent); color: var(--sl-color-black); font-weight: 600; }
	.range-picker button:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
	.chart :global(.line.s-sslots) { stroke: var(--h-peak); }
	.chart :global(:is(.dot, .point).s-demand) { fill: var(--h-avg); }
	.chart :global(:is(.dot, .point).s-sslots) { fill: var(--h-peak); }
	.board[hidden] { display: none !important; }
	:global(.net-live) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 2rem;
		margin-block: 1.5rem;
		padding: 1rem 1.25rem;
		border-radius: 0.5rem;
		background: var(--b-band);
	}
	:global(.net-live .live-list) { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; }
	:global(.net-live .live-item) { display: flex; flex-direction: column-reverse; }
	:global(.net-live dd[data-stat]) { font: 800 1.8rem/1 var(--font-display); color: var(--sl-color-white); }
	:global(.net-live dt), :global(.net-live .live-head), :global(.net-live .live-updated) {
		font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sl-color-gray-3);
	}
	:global(.net-live .live-head) { display: flex; gap: 0.4rem; align-items: center; color: var(--sl-color-accent-high); font-weight: 700; }
	.board { margin-block: 2rem; container-type: inline-size; }
	/* Two by two, or four in a row when the column is wide enough (never three and one). */
	.board-sums {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 0 0 2rem;
	}
	@container (min-width: 46rem) { .board-sums { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
	.board-sums div {
		/* The number's size follows the tile's width (cqi), so a large total such as 2,259,043 stays inside it
		   (2026-11-13: it spilled out of its card); min-width 0 lets the grid cell shrink below the text. */
		container-type: inline-size;
		min-width: 0;
		display: flex;
		flex-direction: column-reverse;
		padding: 1rem 1.25rem;
		border-top: 4px solid var(--sl-color-accent);
		border-radius: 0.4rem;
		background: var(--b-surface);
	}
	/* --fit (set with the number, by its length) is 20cqi up to 9 characters and smaller beyond. */
	.board-sums dd {
		margin: 0; font: 900 clamp(1rem, var(--fit, 20cqi), 2.6rem)/1 var(--font-display); color: var(--sl-color-white);
		font-variant-numeric: tabular-nums; white-space: nowrap;
	}
	.board-sums dt { margin-top: 0.35rem; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sl-color-gray-3); }
	.board h2 { font-family: var(--font-display); text-transform: uppercase; color: var(--sl-color-white); margin: 0 0 0.75rem; }
	.board-wrap { overflow-x: auto; }
	.board table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
	/* Rows are built by the script, so their cells need :global (no scoped attribute). */
	.board :global(:is(th, td)) { padding: 0.5rem 0.75rem 0.5rem 0; border-bottom: 1px solid var(--sl-color-gray-5); text-align: left; vertical-align: baseline; }
	.board thead th { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--sl-color-gray-3); }
	.board :global(tbody th) { font-weight: 600; color: var(--sl-color-white); overflow-wrap: anywhere; }
	.board :global(.num) { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
	.board :global(:is(th, td):last-child) { padding-right: 0; }
	.board-note, .board-empty { margin: 0.75rem 0 0; font-size: 0.9rem; color: var(--sl-color-gray-3); }
