---
// The home page ("volunteer science" design, 2026-10-10; node first, 2026-11-25): bold condensed
// headlines, a warm accent and a drawn network of home GPUs. Order: what it is (hero), what the GPUs do
// (science, with the prove2me chart), the network live, run a node, the dev log (what is new), use it, what happens
// to a question. Science comes before the ask: what the network does, then how small it is, then join it.
// Its theme tokens live in styles/global.css and brand.css for the whole site.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import LiveStats from '../components/LiveStats.astro';
import { cards, guarantees, hero, links, nodeBlock, steps } from '../data/home';
import { anonCommand, installerSize, installerURL, nodeRelease, nodeShSource } from '../data/node-release';
import { posts, postURL, shortDate, isoDate } from '../data/devlog';
import { science } from '../data/science';
import { p2m } from '../data/prove2me';
import { historyOf, scienceView } from '../data/prove2me-records';
import { buildRecords } from '../data/prove2me-build';
import { homeLine } from '../data/prove2me-view';
import { acceptedChartSVG, acceptedRowsHTML, acceptedSeries } from '../data/prove2me-chart';
import { homeDescription, homeJsonLd, homeTitle, jsonLdScript } from '../data/seo';

// The newest dev log posts (design C of three), with the dev log's own publish
// filter: drafts only in a build with DEVLOG_DRAFTS=1.
const latest = (await posts()).slice(0, 3);

// The prove2me line: the records as the build fetched them (prove2me-build.ts); the browser redoes them with the
// gateway's records (see the script).
const p2mHistory = historyOf(p2m);
const p2mView = scienceView(p2mHistory, (await buildRecords()).records);
// The chart of proofs accepted over time: drawn here at a default width; the browser draws it again at its own width.
const p2mSeries = acceptedSeries(p2mView);

// Home GPUs around the gateway: [x, y, scale]. Coordinates in the 560 x 460 viewBox.
const hub = { x: 280, y: 228 };
const homes: [number, number, number][] = [
	[92, 92, 1], [280, 52, 0.9], [468, 96, 1], [500, 300, 0.85], [292, 404, 1], [72, 318, 0.9],
];
const icons: Record<string, string> = {
	'No open ports': 'M4 12h11M11 7l5 5-5 5M20 4v16',
	Sandboxed: 'M4 7l8-4 8 4v10l-8 4-8-4zM4 7l8 4 8-4M12 11v10',
	'Users stay anonymous': 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21c1-4 4-6 8-6s7 2 8 6M3 3l18 18',
	'Open source': 'M8 6l-6 6 6 6M16 6l6 6-6 6M14 4l-4 16',
};
const arrow = 'M12 4v12M6 10l6 6 6-6M5 20h14';
const nodeShotAlt =
	'The node’s own page, with example data: Serving, connected to aisathome.org; without an account, admitted for science work, with the command to link it; one slot in use; model qwen3.8-27b.';
---

<StarlightPage
	frontmatter={{
		title: 'AIs@home',
		description: homeDescription,
		// The brand once (Starlight's would be "AIs@home | AIs@home"), and what search engines read about the project.
		head: [
			{ tag: 'title', content: homeTitle },
			{ tag: 'meta', attrs: { property: 'og:title', content: homeTitle } },
			{ tag: 'meta', attrs: { property: 'og:type', content: 'website' } },
			{ tag: 'script', attrs: { type: 'application/ld+json' }, content: jsonLdScript(homeJsonLd()) },
		],
		template: 'splash',
		hero: { title: hero.title },
	}}
>
	<div class="home vb not-content">
		<section class="hero grid items-center gap-8 lg:grid-cols-[1.15fr_1fr] lg:gap-12">
			<div>
				<p class="pill">{hero.pill}</p>
				<h1 id="_top"><span class="nowrap">Open-weight</span> AI on <em>volunteers’</em> GPUs</h1>
				<p class="lead">{hero.lead}</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a class="btn btn-primary" href={links.nodeAnchor}>Run a node</a>
					<a class="btn btn-secondary" href={links.chat}>Start chatting</a>
				</div>
				<p class="privacy">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3 8.5-7 10-4-1.5-7-5-7-10V6z" /></svg>
					<span><strong>{hero.privacyTitle}.</strong>{' '}{hero.privacyText} <a href={links.privacy}>{hero.privacyLink}</a></span>
				</p>
			</div>

			<svg class="net" viewBox="0 0 560 460" role="img" aria-labelledby="b-net-title">
				<title id="b-net-title">Home computers with GPUs, each connected outward to one gateway</title>
				<defs>
					<symbol id="b-home" viewBox="0 0 100 100">
						<rect class="h-chim" x="64" y="14" width="10" height="20" />
						<path class="h-body" d="M16 46 L50 16 L84 46 V88 H16 Z" />
						<rect class="h-gpu" x="26" y="54" width="48" height="22" rx="3" />
						<circle class="h-fan" cx="40" cy="65" r="6.5" />
						<circle class="h-fan" cx="60" cy="65" r="6.5" />
					</symbol>
				</defs>
				<g class="links">
					{homes.map(([x, y], i) => <line x1={hub.x} y1={hub.y} x2={x} y2={y} style={`animation-delay:-${i * 0.7}s`} />)}
				</g>
				<g class="ring"><circle cx={hub.x} cy={hub.y} r="74" /></g>
				{homes.map(([x, y, s]) => <use href="#b-home" x={x - 50 * s} y={y - 54 * s} width={100 * s} height={100 * s} />)}
				<g class="hub">
					<circle cx={hub.x} cy={hub.y} r="50" />
					<text x={hub.x} y={hub.y + 15} text-anchor="middle">@</text>
				</g>
				<text class="hub-label" x={hub.x + 82} y={hub.y + 5}>gateway</text>
			</svg>
		</section>

		<section class="sci" aria-labelledby="b-sci" data-home-science data-generated={science.generatedAt?.toISOString() ?? ''}>
			<p class="kicker">What the GPUs do</p>
			<h2 id="b-sci">Our GPUs prove theorems</h2>
			<div class="sci-body">
				<div class="sci-words">
					<p class="sci-text" data-home-prove2me data-source="build">
						<strong class="sci-count" data-home-p2m-accepted>{p2mView.kpis.accepted}</strong>{' '}
						<span data-home-p2m-text>{homeLine(p2mView, p2m.model)}</span>{' '}
						<a href="/science/prove2me/" data-home-p2m-link>See the trials <span aria-hidden="true">→</span></a>
					</p>
					<script is:inline type="application/json" data-home-p2m-known set:html={JSON.stringify({ history: p2mHistory, model: p2m.model }).replace(/</g, '\\u003c')} />
					{science.merged > 0 && (
						<p class="sci-text sci-past" data-home-tauceti>
							Before that: <strong data-home-science-merged>{science.merged}</strong>{' '}
							<span data-home-science-noun>pull request{science.merged === 1 ? '' : 's'}</span> by {science.model} merged into Tau Ceti, a
							library of formal mathematics (finished, at the maintainers’ request).{' '}
							<a href={science.pagePath}>Every pull request <span aria-hidden="true">→</span></a>
						</p>
					)}
					<a class="more" href="/science/" data-home-science-all>All science <span aria-hidden="true">→</span></a>
				</div>
				{p2mSeries && (
					<figure class="p2m-chart" data-home-p2m-chart>
						<figcaption>Proofs accepted by prove2me, counted up</figcaption>
						<ul class="legend" aria-hidden="true">
							<li><span class="swatch dot"></span>Proof</li>
							<li><span class="swatch dot hollow"></span>Closed by reusing a proof</li>
							<li><span class="swatch dash"></span>A trial starts (its number above)</li>
						</ul>
						<div class="p2m-svg" data-home-p2m-svg set:html={acceptedChartSVG(p2mSeries)} />
							<details class="p2m-table">
							<summary>The numbers</summary>
							<div class="p2m-table-wrap">
								<table>
									<thead>
										<tr>
											<th scope="col">Accepted (UTC)</th>
											<th scope="col" class="num">Trial</th>
											<th scope="col">Lemma</th>
											<th scope="col">How</th>
											<th scope="col" class="num">Total</th>
										</tr>
									</thead>
									<tbody data-home-p2m-rows set:html={acceptedRowsHTML(p2mSeries)} />
								</table>
							</div>
						</details>
						<script is:inline type="application/json" data-home-p2m-series set:html={JSON.stringify(p2mSeries).replace(/</g, '\\u003c')} />
					</figure>
				)}
			</div>
		</section>

		<LiveStats class="live" />

		<section class="node" id="run-a-node" aria-labelledby="b-node" data-home-node>
			<p class="kicker">{nodeBlock.kicker}</p>
			<h2 id="b-node">{nodeBlock.title}</h2>
			<p class="node-intro">{nodeBlock.intro}</p>

			<div class="node-grid">
				<div class="node-linux">
					<p class="node-os">Linux: paste in a terminal</p>
					<Code code={anonCommand} lang="bash" frame="terminal" title="Terminal" wrap />
					<ol class="node-does">
						{nodeBlock.does.map((d) => <li>{d}</li>)}
					</ol>
					<p class="node-links">
						<a href={nodeShSource}>Read the script first</a>
						<span aria-hidden="true">·</span>
						<a href={links.nodeLinux}>The same steps by hand</a>
					</p>
				</div>

				<div class="node-win">
					<p class="node-os">Windows 10 or 11</p>
					<a class="dl-btn" href={installerURL} data-dl-windows>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d={arrow} /></svg>
						Download for Windows
					</a>
					<p class="node-meta">{nodeRelease.version} · {installerSize} · <a href={`${links.nodeWindows}#check-the-download`}>Check the download</a></p>
					<p class="node-small">
						On the setup page, choose <b>Start without an account (science only)</b>, or link it to your account
						right away. Windows may warn “unknown publisher” (not signed yet): <b>More info</b> → <b>Run anyway</b>.{' '}
						<a href={links.nodeWindows}>Windows install in detail</a>
					</p>
				</div>
			</div>

			<div class="node-facts">
				<div>
					<h3>What you need</h3>
					<p>
						An NVIDIA GPU with <strong>24 GB or more</strong> (RTX 3090, 4090, 5090 class), or <strong>16 GB</strong> (RTX 4080,
						5070 Ti, 5080 class) with at most a light desktop on it. Slower 16 GB cards (RTX 4060 Ti, 5060 Ti) fail the speed
						test. <a href={`${links.node}#what-you-need`}>Everything it needs</a>
					</p>
				</div>
				<div>
					<h3>Your node’s own page</h3>
					<p>
						Once it runs, the node has a page on your computer at <code>http://127.0.0.1:7381/</code> (Windows opens it; on Linux
						the installer prints it): its status and what it served, <b>Pause</b> and <b>Restart</b> behind a local password,
						and how to link it to an account. <a href={`${links.node}#stop-remove-link-later`}>Stop, remove or link a node</a>
					</p>
					<!-- The real local page with made-up data (e2e/browser/node_page_image.py); one image per theme. -->
					<img class="node-shot node-shot-light" src="/images/home/node-page-light.webp" width="640" height="448" loading="lazy" decoding="async" alt={nodeShotAlt} />
					<img class="node-shot node-shot-dark" src="/images/home/node-page-dark.webp" width="640" height="448" loading="lazy" decoding="async" alt={nodeShotAlt} />
				</div>
			</div>

			<ul class="guar grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
				{
					guarantees.map((g) => (
						<li>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[g.title]} /></svg>
							<h3>{g.title}</h3>
							<p>{g.text}</p>
						</li>
					))
				}
			</ul>
			<a class="more" href={links.node}>Everything about running a node <span aria-hidden="true">→</span></a>
		</section>

		{latest.length > 0 && (
			<section class="block log-c" aria-labelledby="b-log" data-home-devlog>
				<h2 id="b-log">Dev log</h2>
				<ol>
					{latest.slice(0, 3).map((p) => (
						<li data-home-post {...(!p.data.publish ? { 'data-devlog-draft': '' } : {})}>
							<span class="log-c-num">#{p.data.number}</span>
							<time datetime={isoDate(p.data.date)}>{shortDate(p.data.date)}</time>
							<div>
								<a href={postURL(p)} data-home-post-link>{p.data.title}</a>
								<p>{p.data.summary}</p>
							</div>
						</li>
					))}
				</ol>
				<a class="log-c-all" href="/devlog/">All posts <span aria-hidden="true">→</span></a>
			</section>
		)}

		<section class="block" aria-labelledby="b-use">
			<h2 id="b-use">Use it</h2>
			<ul class="cards grid gap-5 md:grid-cols-3">
				{
					cards.map((c) => (
						<li>
							<a href={c.href}>
								<h3>{c.title} <span aria-hidden="true">→</span></h3>
								<p>{c.text}</p>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="block" aria-labelledby="b-how">
			<h2 id="b-how">What happens to your question</h2>
			<ol class="steps grid gap-8 md:grid-cols-3 md:gap-10">
				{
					steps.map((s, i) => (
						<li>
							<span class="num" aria-hidden="true">{i + 1}</span>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
		</section>

	</div>
</StarlightPage>

<script>
	// The prove2me line, live: the build's history with the gateway's records (prove2me-records.ts); without them the
	// build's line stays.
	import { liveSummary, type History } from '../data/prove2me-records';
	import { homeLine } from '../data/prove2me-view';
	import { acceptedChartSVG, acceptedRowsHTML, acceptedSeries, type AcceptedSeries } from '../data/prove2me-chart';

	// The chart: drawn again at its real width (the build's copy is scaled), on load, on resize and with live records.
	const chart = document.querySelector<HTMLElement>('[data-home-p2m-svg]');
	let series: AcceptedSeries | null = null;
	try {
		series = JSON.parse(document.querySelector('[data-home-p2m-series]')?.textContent || 'null');
	} catch {
		series = null;
	}
	const draw = () => {
		if (chart && series && chart.clientWidth > 0) chart.innerHTML = acceptedChartSVG(series, chart.clientWidth);
	};
	draw();
	let resized = 0;
	window.addEventListener('resize', () => {
		cancelAnimationFrame(resized);
		resized = requestAnimationFrame(draw);
	});

	const box = document.querySelector<HTMLElement>('[data-home-prove2me]');
	const load = async () => {
		if (!box || !window.fetch) return;
		try {
			const known = JSON.parse(document.querySelector('[data-home-p2m-known]')?.textContent || 'null') as { history: History; model: string } | null;
			if (!known) return;
			const v = await liveSummary(known.history);
			if (!v) return;
			box.querySelector<HTMLElement>('[data-home-p2m-accepted]')!.textContent = String(v.kpis.accepted);
			box.querySelector<HTMLElement>('[data-home-p2m-text]')!.textContent = homeLine(v, known.model);
			box.dataset.source = 'live';
			const s = acceptedSeries(v);
			const rows = document.querySelector<HTMLElement>('[data-home-p2m-rows]');
			if (s && chart && rows) {
				series = s;
				draw();
				rows.innerHTML = acceptedRowsHTML(s);
				chart.closest<HTMLElement>('[data-home-p2m-chart]')!.dataset.source = 'live';
			}
		} catch {
			// keep the build's line
		}
	};
	load();
</script>

<style>
	.vb { color: var(--sl-color-gray-2); }
	.vb p { margin: 0; }
	.vb :is(h1, h2, h3) {
		color: var(--sl-color-white);
		font-family: var(--font-display);
		text-transform: uppercase;
		line-height: 0.95;
	}
	ol, ul { list-style: none; margin: 0; padding: 0; }

	.hero { padding-block: clamp(2rem, 5vw, 4.5rem) clamp(2.5rem, 5vw, 4rem); }
	.pill {
		display: inline-block;
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--sl-color-gray-2);
	}
	h1 {
		margin: 1.25rem 0 0;
		font-size: clamp(3rem, 7.6vw, 5.6rem);
		font-weight: 900;
		letter-spacing: -0.005em;
		text-wrap: balance;
	}
	h1 em { font-style: normal; color: var(--sl-color-accent); }
	.lead { margin-top: 1.5rem !important; max-width: 33rem; font-size: 1.15rem; line-height: 1.6; }
	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.6rem;
		border-radius: 0.4rem;
		font: 800 1.25rem/1 var(--font-display);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-decoration: none;
		transition: background-color 0.15s, color 0.15s, border-color 0.15s;
	}
	.btn-primary { background: var(--sl-color-accent); color: #1c0d02; }
	.btn-primary:hover { background: var(--sl-color-accent-high); }
	:global([data-theme='light']) .btn-primary { color: #fff; }
	.btn-secondary { border: 2px solid var(--sl-color-white); color: var(--sl-color-white); }
	.btn-secondary:hover { border-color: var(--sl-color-accent); color: var(--sl-color-accent); }
	.privacy {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		margin-top: 2rem !important;
		max-width: 33rem;
		font-size: 0.92rem;
		line-height: 1.55;
	}
	.privacy svg { flex: none; width: 1.4rem; margin-top: 0.05rem; fill: none; stroke: var(--sl-color-accent); stroke-width: 2; stroke-linejoin: round; }
	.privacy strong { color: var(--sl-color-white); }
	.privacy a { color: var(--sl-color-accent-high); text-underline-offset: 3px; }

	/* Science (after the node block) */
	.sci {
		margin-top: clamp(2.5rem, 6vw, 4rem);
		padding: 1.5rem clamp(1.25rem, 3vw, 2.5rem);
		border-left: 5px solid var(--sl-color-accent);
		border-radius: 0.5rem;
		background: var(--b-surface);
	}
	.sci h2 { margin: 0.4rem 0 0.75rem; font-size: clamp(1.6rem, 3.2vw, 2.2rem); font-weight: 850; text-wrap: balance; }
	.sci-text { max-width: 44rem; font-size: 1rem; line-height: 1.6; }
	.sci-text + .sci-text { margin-top: 0.75rem; }
	.sci-text a { font-weight: 600; color: var(--sl-color-gray-2); white-space: nowrap; }
	.sci-count { font: 900 1.6rem/1 var(--font-display); color: var(--sl-color-white); }

	/* Dev log (last) */
	.log-c { padding-bottom: clamp(2rem, 5vw, 3.5rem); }
	.log-c h2 { margin: 0 0 1.25rem; font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 850; }
	.log-c li {
		display: grid;
		grid-template-columns: 2.75rem 7.5rem 1fr;
		gap: 0.25rem 1rem;
		align-items: baseline;
		padding-block: 0.85rem;
		border-top: 1px solid var(--sl-color-hairline-light);
	}
	.log-c-num { font: 800 1.1rem/1 var(--font-display); color: var(--sl-color-accent-high); }
	.log-c time { font-size: 0.85rem; color: var(--sl-color-gray-3); }
	.log-c li a { font: 700 1.25rem/1.2 var(--font-display); letter-spacing: 0.01em; color: var(--sl-color-white); text-decoration: none; }
	.log-c li a:hover { color: var(--sl-color-accent-high); text-decoration: underline; text-underline-offset: 3px; }
	.log-c li p { margin-top: 0.2rem !important; font-size: 0.9rem; line-height: 1.5; color: var(--sl-color-gray-3); }
	.log-c-all { display: inline-block; margin-top: 0.75rem; font-weight: 600; color: var(--sl-color-gray-2); }
	@media (max-width: 40rem) {
		.log-c li { grid-template-columns: 2.25rem 1fr; }
		.log-c li div { grid-column: 1 / -1; }
	}

	/* Illustration */
	.net { width: 100%; max-width: 34rem; justify-self: center; overflow: visible; }
	.net .links line {
		stroke: var(--sl-color-accent);
		stroke-width: 2.5;
		stroke-dasharray: 2 9;
		stroke-linecap: round;
		animation: flow 1.6s linear infinite;
	}
	@keyframes flow { to { stroke-dashoffset: -22; } }
	.net .ring circle { fill: none; stroke: var(--sl-color-gray-5); stroke-dasharray: 4 6; }
	.net .h-body { fill: var(--b-surface); stroke: var(--sl-color-white); stroke-width: 3.5; stroke-linejoin: round; }
	.net .h-chim { fill: var(--sl-color-white); }
	.net .h-gpu { fill: var(--sl-color-accent); }
	.net .h-fan { fill: var(--sl-color-black); stroke: var(--sl-color-black); }
	.net .hub circle { fill: var(--sl-color-accent); }
	.net .hub text { font: 800 46px var(--font-mono); fill: var(--sl-color-black); }
	.net .hub-label { font: 600 15px var(--font-mono); fill: var(--sl-color-gray-3); letter-spacing: 0.08em; }

	/* Live counters */
	.vb :global(.live) {
		margin-top: clamp(2rem, 5vw, 3rem);
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1rem 2.5rem;
		padding: 1.5rem clamp(1.25rem, 3vw, 2.5rem);
		border-radius: 0.75rem;
		background: var(--b-band);
	}
	.vb :global(.live .live-head) {
		display: flex; align-items: center; gap: 0.5rem;
		font: 800 1.35rem/1 var(--font-display); text-transform: uppercase; letter-spacing: 0.06em;
		color: var(--sl-color-accent-high);
