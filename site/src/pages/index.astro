---
// The home page ("volunteer science" design, chosen by the owner 2026-10-10): bold condensed
// headlines and a warm accent; beside the hero, the dev log box (owner, 2026-10-19: in the way
// BOINC project sites show their news; it replaced the drawn network of home GPUs). Its
// theme tokens live in styles/global.css and brand.css for the whole site.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import LiveStats from '../components/LiveStats.astro';
import { cards, guarantees, hero, links, steps } from '../data/home';
import { posts, postURL, label, formatDate, isoDate, excerpt, feed } from '../data/devlog';

// The dev log box beside the hero: the newest posts, with the dev log's own publish filter
// (drafts only on staging).
const latest = (await posts()).slice(0, 3);

const icons: Record<string, string> = {
	'No open ports': 'M4 12h11M11 7l5 5-5 5M20 4v16',
	Sandboxed: 'M4 7l8-4 8 4v10l-8 4-8-4zM4 7l8 4 8-4M12 11v10',
	'Users stay anonymous': 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21c1-4 4-6 8-6s7 2 8 6M3 3l18 18',
	'Stop any time': 'M12 3v8M6.3 6.3a8 8 0 1 0 11.4 0',
};
---

<StarlightPage
	frontmatter={{
		title: 'AIs@home',
		description: 'Open AI models on volunteers’ GPUs. Non-commercial and open source.',
		template: 'splash',
		hero: { title: hero.title },
	}}
>
	<div class="home vb not-content">
		<section class="hero grid items-start gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-12">
			<div>
				<p class="pill">Early experiment · Non-commercial · Open source</p>
				<h1 id="_top">Open AI models on <em>volunteers’</em> GPUs</h1>
				<p class="lead">{hero.lead}</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a class="btn btn-primary" href={links.chat}>Start chatting</a>
					<a class="btn btn-secondary" href={links.node}>Run a node</a>
				</div>
				<p class="privacy">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 5-3 8.5-7 10-4-1.5-7-5-7-10V6z" /></svg>
					<span><strong>{hero.privacyTitle}.</strong>{' '}{hero.privacyText} <a href={links.privacy}>{hero.privacyLink}</a></span>
				</p>
			</div>

			{latest.length > 0 && (
				<aside class="devlog-box" aria-labelledby="b-log" data-home-devlog>
					<div class="box-head">
						<h2 id="b-log">Dev log</h2>
						<p>Notes from the maintainer on what works, what doesn’t, and what it costs.</p>
					</div>
					<ol>
						{latest.map((p) => (
							<li data-home-post {...(!p.data.publish ? { 'data-devlog-draft': '' } : {})}>
								<p class="post-meta">
									<span>{label(p)}</span> · <time datetime={isoDate(p.data.date)}>{formatDate(p.data.date)}</time>
								</p>
								<h3><a href={postURL(p)} data-home-post-link>{p.data.title}</a></h3>
								<p class="post-excerpt">{excerpt(p)}</p>
								<a class="more" href={postURL(p)} aria-label={`Read more: ${label(p)}`}>Read more <span aria-hidden="true">→</span></a>
							</li>
						))}
					</ol>
					<div class="box-foot">
						<a class="all" href="/devlog/">All posts <span aria-hidden="true">→</span></a>
						<a class="rss" href={feed.path} title="RSS feed">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19a1 1 0 1 0 0-.01M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /></svg>
							<span>RSS</span>
						</a>
					</div>
				</aside>
			)}
		</section>

		<LiveStats class="live" />

		<section class="block" aria-labelledby="b-how">
			<h2 id="b-how">How it works</h2>
			<ol class="steps grid gap-8 md:grid-cols-3 md:gap-10">
				{
					steps.map((s, i) => (
						<li>
							<span class="num" aria-hidden="true">{i + 1}</span>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
		</section>

		<section class="block" aria-labelledby="b-use">
			<h2 id="b-use">Use it, or give your GPU</h2>
			<ul class="cards grid gap-5 md:grid-cols-3">
				{
					cards.map((c) => (
						<li>
							<a href={c.href}>
								<h3>{c.title} <span aria-hidden="true">→</span></h3>
								<p>{c.text}</p>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="block" aria-labelledby="b-count">
			<h2 id="b-count">Running a node</h2>
			<ul class="guar grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
				{
					guarantees.map((g) => (
						<li>
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[g.title]} /></svg>
							<h3>{g.title}</h3>
							<p>{g.text}</p>
						</li>
					))
				}
			</ul>
		</section>

	</div>
</StarlightPage>


<style>
	.vb { color: var(--sl-color-gray-2); }
	.vb p { margin: 0; }
	.vb :is(h1, h2, h3) {
		color: var(--sl-color-white);
		font-family: var(--font-display);
		text-transform: uppercase;
		line-height: 0.95;
	}
	ol, ul { list-style: none; margin: 0; padding: 0; }

	.hero { padding-block: clamp(2rem, 5vw, 4.5rem) clamp(2.5rem, 5vw, 4rem); }
	.pill {
		display: inline-block;
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--sl-color-gray-2);
	}
	h1 {
		margin: 1.25rem 0 0;
		font-size: clamp(3.2rem, 8.4vw, 6.6rem);
		font-weight: 900;
		letter-spacing: -0.005em;
		text-wrap: balance;
	}
	h1 em { font-style: normal; color: var(--sl-color-accent); }
	.lead { margin-top: 1.5rem !important; max-width: 33rem; font-size: 1.15rem; line-height: 1.6; }
	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.6rem;
		border-radius: 0.4rem;
		font: 800 1.25rem/1 var(--font-display);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		text-decoration: none;
		transition: background-color 0.15s, color 0.15s, border-color 0.15s;
	}
	.btn-primary { background: var(--sl-color-accent); color: #1c0d02; }
	.btn-primary:hover { background: var(--sl-color-accent-high); }
	:global([data-theme='light']) .btn-primary { color: #fff; }
	.btn-secondary { border: 2px solid var(--sl-color-white); color: var(--sl-color-white); }
	.btn-secondary:hover { border-color: var(--sl-color-accent); color: var(--sl-color-accent); }
	.privacy {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		margin-top: 2rem !important;
		max-width: 33rem;
		font-size: 0.92rem;
		line-height: 1.55;
	}
	.privacy svg { flex: none; width: 1.4rem; margin-top: 0.05rem; fill: none; stroke: var(--sl-color-accent); stroke-width: 2; stroke-linejoin: round; }
	.privacy strong { color: var(--sl-color-white); }
	.privacy a { color: var(--sl-color-accent-high); text-underline-offset: 3px; }

	/* Dev log box (beside the hero on wide screens, below it otherwise) */
	.devlog-box {
		padding: 1.5rem clamp(1.25rem, 3vw, 1.75rem) 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-top: 5px solid var(--sl-color-accent);
		border-radius: 0.5rem;
		background: var(--b-surface);
	}
	.box-head h2 { margin: 0; font-size: 2.2rem; font-weight: 850; }
	.box-head p { margin-top: 0.4rem !important; font-size: 0.92rem; line-height: 1.5; color: var(--sl-color-gray-3); }
	.devlog-box li { padding-block: 1.1rem; border-top: 1px dashed var(--sl-color-gray-5); }
	.devlog-box ol { margin-top: 1rem; }
	.post-meta {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.post-meta span { color: var(--sl-color-accent-high); }
	.devlog-box h3 { margin: 0.4rem 0 0.5rem; font-size: 1.45rem; line-height: 1.05; }
	.devlog-box h3 a { color: inherit; text-decoration: none; }
	.devlog-box h3 a:hover { color: var(--sl-color-accent); }
	.post-excerpt { font-size: 0.93rem; line-height: 1.55; }
	.more, .all, .rss {
		font: 800 1rem/1 var(--font-display);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--sl-color-accent-high);
	}
	.more { display: inline-block; margin-top: 0.6rem; }
	.box-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 1rem;
		border-top: 1px dashed var(--sl-color-gray-5);
	}
	.all { font-size: 1.15rem; color: var(--sl-color-white); }
	.rss { display: inline-flex; gap: 0.35rem; align-items: center; color: var(--sl-color-gray-3); }
	.rss svg { width: 1.1rem; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; }
	:is(.more, .all, .rss):hover { color: var(--sl-color-accent); }

	/* Live counters */
	.vb :global(.live) {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1rem 2.5rem;
		padding: 1.5rem clamp(1.25rem, 3vw, 2.5rem);
		border-radius: 0.75rem;
		background: var(--b-band);
	}
	.vb :global(.live .live-head) {
		display: flex; align-items: center; gap: 0.5rem;
		font: 800 1.35rem/1 var(--font-display); text-transform: uppercase; letter-spacing: 0.06em;
		color: var(--sl-color-accent-high);
	}
	.vb :global(.live .live-list) { display: flex; flex-wrap: wrap; gap: 1rem 3rem; }
	.vb :global(.live .live-item) { display: flex; flex-direction: column-reverse; }
	.vb :global(.live dd) {
		font: 900 clamp(2.4rem, 5vw, 3.4rem)/1 var(--font-display);
		color: var(--sl-color-white);
	}
	.vb :global(.live dt) { margin-top: 0.3rem; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
	.vb :global(.live .live-updated) { font-size: 0.85rem; color: var(--sl-color-gray-3); align-self: end; }
	@media (max-width: 50rem) {
		.vb :global(.live) { grid-template-columns: 1fr; }
	}

	/* Sections */
	.block { padding-top: clamp(3.5rem, 8vw, 6rem); }
	.block h2 { margin: 0 0 2.25rem; font-size: clamp(2.4rem, 5vw, 3.5rem); font-weight: 850; }
	.vb h3 { margin: 0 0 0.6rem; font-size: 1.7rem; font-weight: 800; letter-spacing: 0.01em; }
	.steps li, .cards p, .guar p { font-size: 0.98rem; line-height: 1.6; }
	.num {
		display: block;
		margin-bottom: 0.75rem;
		font: 900 5rem/0.8 var(--font-display);
		color: transparent;
		-webkit-text-stroke: 2px var(--sl-color-accent);
	}
	.cards a {
		display: block;
		height: 100%;
		padding: 1.6rem 1.5rem 1.8rem;
		border-top: 5px solid var(--sl-color-accent);
		border-radius: 0.5rem;
		background: var(--b-surface);
		color: inherit;
		text-decoration: none;
		transition: background-color 0.15s;
	}
	.cards a:hover { background: var(--b-band); }
	.cards a:hover h3 span { color: var(--sl-color-accent); }
	.guar svg {
		width: 2.25rem;
		margin-bottom: 1rem;
		fill: none;
		stroke: var(--sl-color-accent);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

</style>
